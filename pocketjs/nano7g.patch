+//! PocketJS MicroTS apps on the iPod nano 7th generation (NanoApps SDK).
+//!
+//! The generated apps, the retained core and the software rasterizer run
+//! inside one NanoApps RAW_SURFACE app. The NanoApps runtime owns the
+//! persistent 240 x 432 XRGB8888 framebuffer that the OS composites every
+//! heartbeat. A 240 x 432 app renders straight into it through a CPU-visible
+//! DisplayOutput; any other viewport renders into its own buffer, which the
+//! Stage scales into the panel (portrait with the pad below, or landscape
+//! with the pad drawn over it; see pad.rs).
+//!
+//! Touch arrives as one contact per frame; the hit node's focusable ancestor
+//! is pressed on touch-down and stays active until the finger lifts. Pad keys
+//! are PocketJS buttons, the volume keys are Up and Down, and the
+//! accelerometer is gravity-level motion for apps that ask for it.
+//! The host preview links this crate with `std` and the layout oracle.
+
+#![cfg_attr(target_os = "none", no_std)]
+
+extern crate alloc;
+
+pub mod compose;
+pub mod motion;
+pub mod pad;
+pub mod samples;
+#[cfg(feature = "quickjs")]
+pub mod js;
+#[cfg(feature = "quickjs")]
+pub mod local;
+
+use alloc::{boxed::Box, rc::Rc, vec, vec::Vec};
+use core::{
+    cell::{Cell, RefCell},
+    sync::atomic::{AtomicUsize, Ordering},
+};
+use microts::{
+    motion::MotionState,
+    pocketjs_core::damage::DamageRect,
+    runtime::{AotApp, AotGuest, AppState},
+    spec::btn,
+    Input, NodeId, Ui,
+};
+use pad::{Action, Key, Layout, Rect, PANEL_H, PANEL_W, PAD_BG};
+use pocket_drivers::*;
+use pocket_runtime::{
+    GuestEnvironment, GuestFrame, RendererId, Runtime, RuntimeConfig, RuntimeError,
+};
+pub use samples::{Pad, Sample, Spec};
+
+#[allow(dead_code)] // The export defines every fact; the app reads some.
+mod profile {
+    include!(concat!(env!("OUT_DIR"), "/pocket_profile.rs"));
+}
+include!(concat!(env!("OUT_DIR"), "/samples_gen.rs"));
+
+pub const WIDTH: usize = PANEL_W as usize;
+pub const HEIGHT: usize = PANEL_H as usize;
+pub const MAX_REGIONS: usize = 8;
+/// Bytes the Runtime may hold for guest data (the AOT guest uses far less).
+pub const HEAP_LIMIT: usize = 2 * 1024 * 1024;
+/// One wheel step (millidegrees) every this many frames while a wheel key is held.
+const WHEEL_REPEAT: u32 = 6;
+
+/// The apps linked into this build, in launcher order.
+pub fn specs() -> &'static [&'static Spec] {
+    SPECS
+}
+
+/// How many apps the launcher offers: the AOT apps, then the QuickJS ones.
+pub fn app_count() -> usize {
+    #[cfg(feature = "quickjs")]
+    return SPECS.len() + js::JS_APPS.len();
+    #[cfg(not(feature = "quickjs"))]
+    SPECS.len()
+}
+
+/// App `index` in launcher order.
+pub fn spec_at(index: usize) -> &'static Spec {
+    #[cfg(feature = "quickjs")]
+    if index >= SPECS.len() {
+        return &js::JS_APPS[index - SPECS.len()].spec;
+    }
+    SPECS[index]
+}
+
+/// Heap bytes app `index` needs beyond the private stack: the measured
+/// figure, plus the package file for a QuickJS app (0 when it is missing).
+pub fn heap_need(index: usize) -> usize {
+    #[cfg(feature = "quickjs")]
+    if index >= SPECS.len() && index < app_count() {
+        let app = &js::JS_APPS[index - SPECS.len()];
+        let size = js::package_size(app);
+        return if size == 0 { 0 } else { app.spec.heap + size + js::bytecode_size(app) };
+    }
+    SPECS.get(index).map_or(0, |spec| spec.heap)
+}
+
+/// Whether app `index` draws into a 16-bit buffer (when it has one).
+fn narrow_offscreen(index: usize) -> bool {
+    #[cfg(feature = "quickjs")]
+    if index >= SPECS.len() && index < app_count() {
+        return js::JS_APPS[index - SPECS.len()].narrow;
+    }
+    let _ = index;
+    false
+}
+
+/// Private stack bytes app `index` needs beyond the shim's default (0 for
+/// the AOT apps; Vue's nested component setup recurses deeper than the rest).
+pub fn stack_extra(index: usize) -> usize {
+    #[cfg(feature = "quickjs")]
+    if index >= SPECS.len() && index < app_count() {
+        return js::JS_APPS[index - SPECS.len()].stack;
+    }
+    let _ = index;
+    0
+}
+
+/// QuickJS: the realm's memory limit, and the native stack it may use (the
+/// shim's private stack, less what the Runtime and guest frames take).
+#[cfg(feature = "quickjs")]
+pub const JS_MEMORY_LIMIT: usize = 2 * 1024 * 1024;
+#[cfg(feature = "quickjs")]
+pub const JS_STACK: usize = 136 * 1024;
+
+#[cfg(feature = "quickjs")]
+extern "C" {
+    fn pocket_runtime_set_guest(runtime: *mut pocket_drivers::abi::PocketRuntime, table: *const core::ffi::c_void, guest: *mut core::ffi::c_void) -> i32;
+    fn pocket_runtime_tick(runtime: *mut pocket_drivers::abi::PocketRuntime) -> i32;
+    /// Sizes QuickJS's GC trigger from the room left in the block (pocketqjs.c).
+    fn pocketqjs_frame();
+    /// Shows `text` and parks the app (the shim's failure screen).
+    fn pocketnano_fail_text(code: u32, text: *const u8, length: u32) -> !;
+}
+
+/// Which engine drives the Runtime.
+enum Host {
+    Aot(Runtime),
+    #[cfg(feature = "quickjs")]
+    Js { handle: *mut pocket_drivers::abi::PocketRuntime, guest: js::Guest },
+    /// A QuickJS app still booting, one step per heartbeat (`Stage::boot_step`).
+    #[cfg(feature = "quickjs")]
+    Booting(Box<JsBoot>),
+}
+
+/// What a QuickJS boot carries between its steps.
+#[cfg(feature = "quickjs")]
+struct JsBoot {
+    index: usize,
+    step: u32,
+    config: Option<RuntimeConfig>,
+    panel: Option<Box<Panel>>,
+    lcd: Option<Lcd>,
+    direct: bool,
+    package: Option<js::Package>,
+    handle: *mut pocket_drivers::abi::PocketRuntime,
+    guest: Option<js::Guest>,
+}
+impl Host {
+    fn tick(&mut self) {
+        match self {
+            Host::Aot(runtime) => runtime.tick().expect("AOT Runtime frame"),
+            #[cfg(feature = "quickjs")]
+            Host::Js { handle, guest, .. } => {
+                unsafe {
+                    local::frame();
+                    pocketqjs_frame();
+                }
+                if unsafe { pocket_runtime_tick(*handle) } != 0 {
+                    js_fail(4, guest);
+                }
+            }
+            #[cfg(feature = "quickjs")]
+            Host::Booting(_) => {}
+        }
+    }
+}
+
+#[cfg(feature = "quickjs")]
+fn js_fail(code: u32, guest: &js::Guest) -> ! {
+    let text = js::error(guest);
+    let text = if text.is_empty() { "JAVASCRIPT FAILED" } else { text };
+    unsafe { pocketnano_fail_text(code, text.as_ptr(), text.len() as u32) }
+}
+
+/// One sample of the panel: `down` while a finger is on the glass.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Touch {
+    pub x: i32,
+    pub y: i32,
+    pub down: bool,
+}
+
+/// One more finger from the OS's per-finger lists (`hb_touch_poll_multi`),
+/// in panel pixels. `slot` is the OS's finger slot, stable while it is down.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Finger {
+    pub slot: u8,
+    pub x: i32,
+    pub y: i32,
+}
+
+/// Fingers the panel reports at once that this host passes on.
+pub const MAX_FINGERS: usize = 4;
+
+/// Physical buttons the 7G exposes to apps, as `spec::btn` bits.
+pub mod button {
+    pub use microts::spec::btn::{CIRCLE, CROSS, DOWN, LEFT, RIGHT, SELECT, START, UP};
+}
+
+/// The spec AotApp::mount reads (mount is a static entry point).
+static SELECTED: AtomicUsize = AtomicUsize::new(0);
+/// The next Stage draws its menu key as a home key (opened from home).
+pub static HOME_KEYS: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// App index by its spec key (`-1` when there is none).
+pub fn find_key(key: &[u8]) -> i32 {
+    (0..app_count()).find(|&i| spec_at(i).key.as_bytes() == key).map_or(-1, |i| i as i32)
+}
+
+/// Rows the shim's own list shows: the AOT apps and the QuickJS apps up to
+/// the first one only the home screen offers.
+pub fn menu_count() -> usize {
+    #[cfg(feature = "quickjs")]
+    return SPECS.len() + js::JS_APPS.iter().take_while(|app| !app.home_only).count();
+    #[cfg(not(feature = "quickjs"))]
+    SPECS.len()
+}
+
+pub struct Mounted {
+    sample: Box<dyn Sample>,
+    /// A touch is down and its press has been delivered.
+    held: bool,
+}
+
+impl Mounted {
+    pub fn ui(&self) -> &Ui {
+        self.sample.ui()
+    }
+}
+
+impl AotApp for Box<Mounted> {
+    #[inline(never)]
+    fn mount(ui: Ui, environment: &GuestEnvironment<'_>) -> Result<Self, RuntimeError> {
+        let spec = SPECS[SELECTED.load(Ordering::Relaxed)];
+        assert_eq!(environment.viewport, spec.logical);
+        assert_eq!(environment.tick_hz, spec.tick_hz);
+        let mut sample = (spec.mount)(ui);
+        if spec.focus {
+            let first = sample.ui().initial_focus();
+            sample.ui_mut().set_focus(first);
+        }
+        Ok(Box::new(Mounted { sample, held: false }))
+    }
+    fn frame(&mut self, frame: &GuestFrame<'_>) -> Result<(), RuntimeError> {
+        // Live contacts carry the hit resolved on their down frame; a
+        // cancelled contact is flagged in bit 30 and carries hit 0.
+        let live = frame
+            .touches
+            .iter()
+            .zip(frame.hits.iter())
+            .find(|(word, _)| **word & 0x4000_0000 == 0);
+        let mut input = Input::buttons(frame.buttons);
+        match live {
+            Some((_, &hit)) if !self.held => {
+                let target = self.sample.ui().press_target(NodeId(hit));
+                self.held = true;
+                if target != NodeId::NONE {
+                    input.target = target;
+                    input.buttons |= btn::CIRCLE;
+                    input.pressed |= btn::CIRCLE;
+                }
+            }
+            Some(_) => input.buttons |= btn::CIRCLE,
+            None => self.held = false,
+        }
+        for delta in frame.axis_deltas {
+            if let Some(slot) = input.axis_deltas.get_mut(delta.id as usize) {
+                *slot = slot.saturating_add(delta.delta);
+            }
+        }
+        input.motion = frame.motion.map(motion::from_driver);
+        self.sample.frame(&input);
+        Ok(())
+    }
+}
+
+/// This frame's input, shared with the Runtime's input source.
+#[derive(Clone, Copy, Default)]
+struct PanelInput {
+    buttons: u32,
+    /// Contacts in the app's view: (id, x, y) in logical px. Id 0 is the
+    /// resident's touch point, 1 + slot the other fingers.
+    contacts: [Option<(u32, f32, f32)>; MAX_FINGERS],
+    wheel: i32,
+    motion: Option<MotionState>,
+}
+
+struct Panel {
+    state: Rc<Cell<PanelInput>>,
+    motion: bool,
+}
+impl InputSource for Panel {
+    fn classes(&self) -> InputClasses {
+        let classes = InputClasses::BUTTONS | InputClasses::CONTACT | InputClasses::AXIS_RELATIVE;
+        if self.motion {
+            classes | InputClasses::MOTION
+        } else {
+            classes
+        }
+    }
+    fn poll(&mut self, frame: &mut InputFrameBuilder) {
+        let state = self.state.get();
+        frame.buttons |= state.buttons;
+        for (id, x, y) in state.contacts.iter().flatten() {
+            frame.contacts.push(Contact { surface: 0, id: *id, x: *x, y: *y, cancelled: false });
+        }
+        if state.wheel != 0 {
+            frame.relative.push(AxisDelta { id: 0, delta: state.wheel });
+        }
+        if let Some(m) = state.motion.as_ref() {
+            frame.motion = Some(motion::to_driver(m));
+        }
+    }
+}
+
+/// The surface the Runtime draws: the panel itself, or the app's own buffer.
+#[derive(Clone, Copy)]
+struct Pixels(*mut u32);
+
+/// The app's own buffer when it does not fill the panel.
+enum Offscreen {
+    Wide(Vec<u32>),
+    /// RGB565, for an app that needs the memory (`JsApp::narrow`).
+    Narrow(Vec<u16>),
+}
+impl Offscreen {
+    fn base(&mut self) -> *mut u8 {
+        match self {
+            Self::Wide(v) => v.as_mut_ptr().cast(),
+            Self::Narrow(v) => v.as_mut_ptr().cast(),
+        }
+    }
+}
+
+struct Lcd {
+    pixels: *mut u8,
+    format: PixelFormat,
+    width: usize,
+    height: usize,
+    damage: Rc<RefCell<Vec<DamageRect>>>,
+}
+impl Lcd {
+    fn bytes_per_pixel(&self) -> usize {
+        if self.format == PixelFormat::Rgb565 { 2 } else { 4 }
+    }
+}
+impl DisplayOutput for Lcd {
+    type Token = ();
+    fn descriptor(&self) -> DisplayDescriptor {
+        let mut descriptor = DisplayDescriptor::new(
+            DisplayRole::Primary,
+            self.width as u32,
+            self.height as u32,
+            self.format,
+            self.width * self.bytes_per_pixel(),
+            TargetOwnership::CpuVisible,
+        );
+        descriptor.partial_refresh = true;
+        descriptor
+    }
+    fn frame_identity(&mut self) -> Result<Option<BufferIdentity>, DisplayError> {
+        Ok(Some(BufferIdentity { buffer: 1, generation: 0 }))
+    }
+    fn acquire(&mut self, region: Rect_) -> Result<Target<'_>, DisplayError> {
+        if region.width == 0
+            || region.height == 0
+            || region.x.checked_add(region.width).is_none_or(|end| end > self.width as u32)
+            || region.y.checked_add(region.height).is_none_or(|end| end > self.height as u32)
+        {
+            return Err(DisplayError::InvalidTarget);
+        }
+        let offset = region.y as usize * self.width + region.x as usize;
+        let bpp = self.bytes_per_pixel();
+        // SAFETY: the buffer holds width * height pixels for the Stage's
+        // lifetime and only this display writes it, during Runtime::tick.
+        let bytes = unsafe {
+            core::slice::from_raw_parts_mut(self.pixels.add(offset * bpp), (self.width * self.height - offset) * bpp)
+        };
+        Ok(Target::CpuVisible(Surface::new(bytes, region, self.width * bpp, self.format)?))
+    }
+    fn flush(&mut self, regions: &[Rect_]) -> Result<(), DisplayError> {
+        self.damage.borrow_mut().extend(regions.iter().map(|r| DamageRect {
+            x0: r.x as i32,
+            y0: r.y as i32,
+            x1: (r.x + r.width) as i32,
+            y1: (r.y + r.height) as i32,
+        }));
+        Ok(())
+    }
+    fn wait(&mut self, _: ()) -> Result<(), DisplayError> {
+        Ok(())
+    }
+    fn vsync(&mut self) -> VsyncSource {
+        VsyncSource::None
+    }
+}
+use pocket_drivers::Rect as Rect_;
+
+/// One running app on the panel.
+pub struct Stage {
+    runtime: Host,
+    app: Option<AppState<Box<Mounted>>>,
+    spec: &'static Spec,
+    layout: Layout,
+    input: Rc<Cell<PanelInput>>,
+    fb: Pixels,
+    /// The app's own buffer when it does not fill the panel.
+    offscreen: Option<Offscreen>,
+    flushed: Rc<RefCell<Vec<DamageRect>>>,
+    damage: [DamageRect; MAX_REGIONS],
+    damage_len: usize,
+    /// The key the current touch started on.
+    key: Option<usize>,
+    /// The current touch started inside the app's view.
+    in_view: bool,
+    last_contact: Option<(f32, f32)>,
+    was_down: bool,
+    /// Other fingers for the next frame (set by the shim from the OS lists).
+    fingers: [Finger; MAX_FINGERS],
+    finger_count: usize,
+    /// Per OS slot: the key a finger went down on, or that it went down in
+    /// the view (Some(None)); None while the slot is not down.
+    slots: [Option<Option<usize>>; 8],
+    /// Pad keys held by any finger, one bit per key.
+    held_keys: u32,
+    wheel_frames: u32,
+    first: bool,
+    menu: bool,
+    motion: motion::Filter,
+    /// Last compose: panel pixels asked for (sum of the damage rectangles)
+    /// and pixels composed (after merging), for the preview's damage log.
+    asked_px: u32,
+    composed_px: u32,
+}
+
+impl Stage {
+    /// Mount `SPECS[index]`. A menu key is drawn when `menu` (the launcher).
+    ///
+    /// # Safety
+    /// `framebuffer` must point at WIDTH * HEIGHT writable u32 pixels that
+    /// outlive the returned Stage and that nothing else writes during `frame`.
+    pub unsafe fn new(index: usize, framebuffer: *mut u32, menu: bool) -> Self {
+        let spec = spec_at(index);
+        SELECTED.store(index, Ordering::Relaxed);
+        let mut layout = Layout::new(spec.logical, spec.pad, menu);
+        if HOME_KEYS.load(Ordering::Relaxed) {
+            layout.home_keys();
+        }
+        let [lw, lh] = [spec.logical[0] as usize, spec.logical[1] as usize];
+        let config = RuntimeConfig {
+            profile_hash: profile::PROFILE_HASH,
+            host_abi: profile::HOST_ABI,
+            heap_limit: HEAP_LIMIT,
+            frame_buffer_budget: (lw * lh).max(WIDTH * HEIGHT) * 4,
+            profile: profile::profile().unwrap(),
+        };
+        let input = Rc::new(Cell::new(PanelInput::default()));
+        let panel = Box::new(Panel { state: input.clone(), motion: spec.motion });
+        let fb = Pixels(framebuffer);
+        let mut offscreen = (!layout.direct).then(|| {
+            if narrow_offscreen(index) {
+                Offscreen::Narrow(vec![0u16; lw * lh])
+            } else {
+                Offscreen::Wide(vec![0xff00_0000u32; lw * lh])
+            }
+        });
+        let format = match offscreen {
+            Some(Offscreen::Narrow(_)) => PixelFormat::Rgb565,
+            _ => PixelFormat::Argb8888,
+        };
+        let target = offscreen.as_mut().map_or(fb.0.cast(), Offscreen::base);
+        let flushed = Rc::new(RefCell::new(Vec::new()));
+        let lcd = Lcd { pixels: target, format, width: lw, height: lh, damage: flushed.clone() };
+        let (runtime, app) = if index < SPECS.len() {
+            let mut runtime = Runtime::new(config).unwrap();
+            let (guest, app) = AotGuest::<Box<Mounted>>::new();
+            runtime.set_guest(Box::new(guest)).unwrap();
+            runtime.add_input_source(panel).unwrap();
+            if !layout.direct {
+                // The app's viewport is not the panel: present into its own buffer.
+                runtime.allow_embedded_viewport_changes().unwrap();
+            }
+            runtime.add_display(lcd, RendererId::SOFTWARE).unwrap();
+            runtime
+                .boot_aot_deferred(profile::PROFILE_HASH, spec.logical, false, spec.tick_hz)
+                .unwrap();
+            runtime.skip_presentation().unwrap();
+            (Host::Aot(runtime), Some(app))
+        } else {
+            #[cfg(feature = "quickjs")]
+            {
+                let boot = JsBoot {
+                    index: index - SPECS.len(),
+                    step: 0,
+                    config: Some(config),
+                    panel: Some(panel),
+                    lcd: Some(lcd),
+                    direct: layout.direct,
+                    package: None,
+                    handle: core::ptr::null_mut(),
+                    guest: None,
+                };
+                (Host::Booting(Box::new(boot)), None)
+            }
+            #[cfg(not(feature = "quickjs"))]
+            unreachable!()
+        };
+        Self {
+            runtime,
+            app,
+            spec,
+            layout,
+            input,
+            fb,
+            offscreen,
+            flushed,
+            damage: [DamageRect::empty(); MAX_REGIONS],
+            damage_len: 0,
+            key: None,
+            in_view: false,
+            last_contact: None,
+            was_down: false,
+            fingers: [Finger::default(); MAX_FINGERS],
+            finger_count: 0,
+            slots: [None; 8],
+            held_keys: 0,
+            wheel_frames: 0,
+            first: true,
+            menu: false,
+            motion: motion::Filter::default(),
+            asked_px: 0,
+            composed_px: 0,
+        }
+    }
+
+    /// Retained-memory counters of a running QuickJS app's core
+    /// (`Ui::memory_counters`); zeros for AOT apps or while booting.
+    pub fn memory_counters(&self) -> [u32; 14] {
+        #[cfg(feature = "quickjs")]
+        if let Host::Js { handle, .. } = &self.runtime {
+            use pocket_runtime_cabi::embedding as e;
+            // SAFETY: the shim's single thread, between frames.
+            if let Ok(ops) = unsafe { e::op_context(*handle) } {
+                if let Ok(state) = ops.core() {
+                    return state.ui.memory_counters();
+                }
+            }
+        }
+        [0; 14]
+    }
+
+    /// (asked, composed) panel pixels of the last landscape or scaled frame.
+    pub fn compose_stats(&self) -> (u32, u32) {
+        (self.asked_px, self.composed_px)
+    }
+
+    /// One step of a QuickJS boot, so no heartbeat holds the CPU for the
+    /// whole of it: 0 read the package and bytecode files, 1 the Runtime,
+    /// display, package source and realm, 2 evaluate the bundle (from the
+    /// bytecode when it matches). Returns 0 while steps remain, 1 when this
+    /// call finished the boot, 2 when there was nothing to do (an AOT app).
+    pub fn boot_step(&mut self) -> u32 {
+        #[cfg(feature = "quickjs")]
+        if let Host::Booting(boot) = &mut self.runtime {
+            // SAFETY: the shim's single thread; see `new`.
+            let done = unsafe { Self::js_step(boot) };
+            if let Some(host) = done {
+                self.runtime = host;
+                return 1;
+            }
+            return 0;
+        }
+        2
+    }
+
+    #[cfg(feature = "quickjs")]
+    unsafe fn js_step(boot: &mut JsBoot) -> Option<Host> {
+        use pocket_runtime_cabi::embedding as e;
+        let fail = |text: &str| -> ! { pocketnano_fail_text(3, text.as_ptr(), text.len() as u32) };
+        let app = &js::JS_APPS[boot.index];
+        boot.step += 1;
+        match boot.step {
+            1 => {
+                boot.package = Some(js::Package::read(app).unwrap_or_else(|| fail("PACKAGE MISSING")));
+                js::read_bytecode(app);
+                None
+            }
+            2 => {
+                let handle = e::create(boot.config.take().unwrap()).unwrap_or_else(|_| fail("RUNTIME FAILED"));
+                boot.handle = handle;
+                if e::add_input_source(handle, boot.panel.take().unwrap()) != 0 {
+                    fail("INPUT FAILED");
+                }
+                if !boot.direct && e::allow_embedded_viewport_changes(handle) != 0 {
+                    fail("VIEWPORT FAILED");
+                }
+                if e::add_display(handle, boot.lcd.take().unwrap(), RendererId::SOFTWARE) != 0 {
+                    fail("DISPLAY FAILED");
+                }
+                if e::set_package_source(handle, Box::new(boot.package.take().unwrap())) != 0 {
+                    fail("PACKAGE REFUSED");
+                }
+                let guest = js::guest(JS_MEMORY_LIMIT, JS_STACK + app.stack, app.data).unwrap_or_else(|| fail("QUICKJS FAILED"));
+                if pocket_runtime_set_guest(handle, guest.table, guest.instance) != 0 {
+                    fail("GUEST REFUSED");
+                }
+                boot.guest = Some(guest);
+                None
+            }
+            _ => {
+                let handle = boot.handle;
+                let guest = boot.guest.take().unwrap();
+                if e::boot_deferred(handle) != 0 {
+                    js_fail(3, &guest);
+                }
+                if e::skip_presentation(handle) != 0 {
+                    fail("PRESENT FAILED");
+                }
+                Some(Host::Js { handle, guest })
+            }
+        }
+    }
+
+    /// An ahead-of-time app (dropped normally), not a QuickJS one.
+    pub fn is_aot(&self) -> bool {
+        matches!(self.runtime, Host::Aot(_))
+    }
+
+    pub fn spec(&self) -> &'static Spec {
+        self.spec
+    }
+
+    /// The other fingers for the next frame (the shim's contacts, without
+    /// the resident's own finger).
+    pub fn set_fingers(&mut self, fingers: &[Finger]) {
+        let n = fingers.len().min(MAX_FINGERS);
+        self.fingers[..n].copy_from_slice(&fingers[..n]);
+        self.finger_count = n;
+    }
+
+    /// The other fingers this frame: the shim has already left out the
+    /// resident's own finger and keeps each contact across frames
+    /// (pocketjs12); none while the resident's point is up (that point
+    /// decides when a touch starts and ends).
+    fn extra_fingers(&self, touch: Touch) -> ([Finger; MAX_FINGERS], usize) {
+        let mut out = [Finger::default(); MAX_FINGERS];
+        if !touch.down {
+            return (out, 0);
+        }
+        let n = self.finger_count.min(MAX_FINGERS - 1);
+        out[..n].copy_from_slice(&self.fingers[..n]);
+        (out, n)
+    }
+
+    /// The menu key was pressed (launcher builds).
+    pub fn wants_menu(&self) -> bool {
+        self.menu
+    }
+
+    /// One guest turn, one core tick and a terminal presentation, then the
+    /// panel composition. Returns the panel rectangles that changed.
+    /// `accel` is the raw accelerometer sample, `now_us` a monotonic clock.
+    pub fn frame(&mut self, buttons: u32, touch: Touch, accel: [i32; 3], now_us: u64) -> &[DamageRect] {
+        let mut changed_keys = [false; pad::MAX_KEYS];
+        let previous_key = self.key;
+        if touch.down && !self.was_down {
+            self.key = self.layout.key_at(touch.x, touch.y);
+            self.in_view = self.key.is_none() && self.layout.touch_to_logical(touch.x, touch.y).is_some();
+            self.wheel_frames = 0;
+        } else if !touch.down {
+            self.key = None;
+            self.in_view = false;
+        }
+        self.was_down = touch.down;
+        for k in [previous_key, self.key].into_iter().flatten() {
+            if previous_key != self.key {
+                changed_keys[k] = true;
+            }
+        }
+        let mut state = PanelInput { buttons, ..PanelInput::default() };
+        if self.in_view {
+            if let Some((x, y)) = self.layout.touch_to_logical(touch.x, touch.y) {
+                self.last_contact = Some((x as f32, y as f32));
+            }
+            state.contacts[0] = self.last_contact.map(|(x, y)| (0, x, y));
+        } else {
+            self.last_contact = None;
+        }
+        // Other fingers: each keeps what it went down on (a pad key, the
+        // view, or nothing) until it lifts. Pad keys under any finger are
+        // held together, so chords work; fingers in the view are contacts.
+        let (extra, extra_n) = self.extra_fingers(touch);
+        let mut seen = [false; 8];
+        let mut chord = 0u32;
+        let mut next_contact = 1;
+        for f in &extra[..extra_n] {
+            let slot = (f.slot & 7) as usize;
+            seen[slot] = true;
+            let start = *self.slots[slot].get_or_insert_with(|| self.layout.key_at(f.x, f.y));
+            match start {
+                Some(k) => {
+                    if let Some(Key { action: Action::Button(bit), .. }) = self.layout.keys[k] {
+                        state.buttons |= bit;
+                        chord |= 1 << k;
+                    }
+                }
+                None => {
+                    if let Some((x, y)) = self.layout.touch_to_logical(f.x, f.y) {
+                        if next_contact < MAX_FINGERS {
+                            state.contacts[next_contact] = Some((1 + slot as u32, x as f32, y as f32));
+                            next_contact += 1;
+                        }
+                    }
+                }
+            }
+        }
+        for (slot, s) in self.slots.iter_mut().enumerate() {
+            if !seen[slot] {
+                *s = None;
+            }
+        }
+        if let Some(k) = self.key {
+            chord |= 1 << k;
+        }
+        for k in 0..pad::MAX_KEYS {
+            if (chord ^ self.held_keys) & (1 << k) != 0 {
+                changed_keys[k] = true;
+            }
+        }
+        self.held_keys = chord;
+        if let Some(key) = self.key.and_then(|k| self.layout.keys[k]) {
+            match key.action {
+                Action::Button(bit) => state.buttons |= bit,
+                Action::Wheel(step) => {
+                    if self.wheel_frames % WHEEL_REPEAT == 0 {
+                        state.wheel = step;
+                    }
+                    self.wheel_frames += 1;
+                }
+                Action::Menu => self.menu = true,
+            }
+        }
+        if self.spec.motion {
+            state.motion = self.motion.update(accel, now_us);
+        }
+        self.input.set(state);
+        self.flushed.borrow_mut().clear();
+        self.runtime.tick();
+        if self.layout.direct {
+            let damage = self.flushed.borrow();
+            let mut out: Vec<Rect> = damage.iter().map(|r| Rect::new(r.x0, r.y0, r.x1 - r.x0, r.y1 - r.y0)).collect();
+            drop(damage);
+            for (k, changed) in changed_keys.iter().enumerate() {
+                if let (true, Some(key)) = (*changed, self.layout.keys[k]) {
+                    out.push(self.layout.to_panel(key.rect));
+                }
+            }
+            self.draw_keys(&out);
+            self.first = false;
+            self.report(&out);
+        } else {
+            self.compose(&changed_keys);
+        }
+        &self.damage[..self.damage_len]
+    }
+
+    fn panel(&mut self) -> &mut [u32] {
+        // SAFETY: see `new`; `&mut self` excludes other access.
+        unsafe { core::slice::from_raw_parts_mut(self.fb.0, WIDTH * HEIGHT) }
+    }
+
+    /// Scale the app's buffer into the panel where it changed, redraw the
+    /// keys those areas touch, and report the panel rectangles.
+    fn compose(&mut self, changed_keys: &[bool; pad::MAX_KEYS]) {
+        let mut rects: Vec<Rect> = Vec::new();
+        if self.first {
+            rects.push(Rect::new(0, 0, PANEL_W, PANEL_H));
+        } else {
+            for r in self.flushed.borrow().iter() {
+                rects.push(self.layout.logical_to_panel(r.x0, r.y0, r.x1, r.y1));
+            }
+            for (k, changed) in changed_keys.iter().enumerate() {
+                if let (true, Some(key)) = (*changed, self.layout.keys[k]) {
+                    rects.push(self.layout.to_panel(key.rect));
+                }
+            }
+        }
+        rects.retain(|r| r.w > 0 && r.h > 0);
+        self.asked_px = rects.iter().filter_map(|r| r.clip(PANEL_W, PANEL_H)).map(|r| (r.w * r.h) as u32).sum();
+        // Compose what the app changed (overlaps merged so no pixel is done
+        // twice), then each key those areas touch, whole, so it is redrawn
+        // once over fresh pixels (landscape keys blend). Keys are composed on
+        // their own, not merged into a bounding box with the app's areas:
+        // that grew a 11 K pixel change to 64 K in Vue SFC Lab.
+        let mut rects = merge(rects);
+        let mut keys: Vec<Rect> = Vec::new();
+        for key in self.layout.keys.iter().flatten() {
+            let kr = self.layout.to_panel(key.rect);
+            if rects.iter().any(|r| r.intersects(&kr)) && !rects.iter().any(|r| r.covers(&kr)) {
+                keys.push(kr);
+            }
+        }
+        self.composed_px = rects.iter().chain(keys.iter()).filter_map(|r| r.clip(PANEL_W, PANEL_H)).map(|r| (r.w * r.h) as u32).sum();
+        for r in rects.iter().chain(keys.iter()) {
+            self.scale_into(*r);
+        }
+        rects.extend(keys);
+        self.draw_keys(&rects);
+        self.first = false;
+        self.report(&rects);
+    }
+
+    fn draw_keys(&mut self, rects: &[Rect]) {
+        let layout = self.layout.clone();
+        let held = self.held_keys;
+        for (k, key) in layout.keys.iter().enumerate() {
+            if let Some(key) = key {
+                let kr = layout.to_panel(key.rect);
+                if self.first || rects.iter().any(|r| r.intersects(&kr)) {
+                    pad::draw_key(&layout, self.panel(), key, held & (1 << k) != 0);
+                }
+            }
+        }
+    }
+
+    /// Bilinear scale of the app's buffer into one panel rectangle.
+    fn scale_into(&mut self, r: Rect) {
+        let Some(r) = r.clip(PANEL_W, PANEL_H) else { return };
+        let layout = self.layout.clone();
+        let background = if layout.landscape { 0xff00_0000 } else { PAD_BG };
+        // SAFETY: see `new`; the offscreen buffer and the panel never overlap.
+        let fb = unsafe { core::slice::from_raw_parts_mut(self.fb.0, WIDTH * HEIGHT) };
+        match self.offscreen.as_ref().unwrap() {
+            Offscreen::Wide(source) => compose::scale_rect(&layout, source.as_slice(), fb, r, background),
+            Offscreen::Narrow(source) => compose::scale_rect(&layout, source.as_slice(), fb, r, background),
+        }
+    }
+
+    fn report(&mut self, rects: &[Rect]) {
+        let rects: Vec<Rect> = rects.iter().filter_map(|r| r.clip(PANEL_W, PANEL_H)).collect();
+        if rects.len() > MAX_REGIONS {
+            let all = rects.iter().skip(1).fold(rects[0], |acc, r| acc.union(r));
+            self.damage[0] = DamageRect { x0: all.x, y0: all.y, x1: all.x + all.w, y1: all.y + all.h };
+            self.damage_len = 1;
+        } else {
+            for (slot, r) in self.damage.iter_mut().zip(rects.iter()) {
+                *slot = DamageRect { x0: r.x, y0: r.y, x1: r.x + r.w, y1: r.y + r.h };
+            }
+            self.damage_len = rects.len();
+        }
+    }
+
+    pub fn pixels(&self) -> &[u32] {
+        // SAFETY: see `new`; `&self` excludes a concurrent `frame`.
+        unsafe { core::slice::from_raw_parts(self.fb.0, WIDTH * HEIGHT) }
+    }
+
+    /// The mounted app, for previews and tests.
+    pub fn with_app<R>(&self, f: impl FnOnce(&Mounted) -> R) -> R {
+        f(self.app.as_ref().expect("an AOT app").borrow().as_ref().unwrap())
+    }
+
+    #[cfg(feature = "counters")]
+    pub fn assert_layout(&self) {
+        let mut state = self.app.as_ref().expect("an AOT app").borrow_mut();
+        let mismatches = state.as_mut().unwrap().sample.ui_mut().core_mut().layout_mismatches();
+        assert!(mismatches.is_empty(), "baked layout differs from full-tree solve: {mismatches:?}");
+    }
+}
+
+/// Merge overlapping rectangles so no panel pixel is composed twice (landscape
+/// keys blend, so a second pass would darken them).
+fn merge(mut rects: Vec<Rect>) -> Vec<Rect> {
+    let mut merged = true;
+    while merged {
+        merged = false;
+        'outer: for i in 0..rects.len() {
+            for j in i + 1..rects.len() {
+                if rects[i].intersects(&rects[j]) {
+                    let u = rects[i].union(&rects[j]);
+                    rects[i] = u;
+                    rects.swap_remove(j);
+                    merged = true;
+                    break 'outer;
+                }
+            }
+        }
+    }
+    rects
+}
