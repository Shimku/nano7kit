+
+/// The bytecode file's size (0 when it is missing).
+pub fn bytecode_size(app: &JsApp) -> usize {
+    unsafe { pocketnano_file_size(app.bytecode.as_ptr()) as usize }
+}
+
+/// Read the bytecode file (if any) into a buffer the guest wrapper owns:
+/// QuickJS copies the functions out of it, and the wrapper frees it as soon
+/// as they are read (before the bundle runs), so it is not part of the peak.
+pub fn read_bytecode(app: &JsApp) -> bool {
+    let size = bytecode_size(app);
+    if size == 0 {
+        return false;
+    }
+    let bytes = unsafe { pocketqjs_bytecode_buffer(size) };
+    if bytes.is_null() {
+        return false;
+    }
+    let got = unsafe { pocketnano_file_read(app.bytecode.as_ptr(), bytes, size as u32) } as usize;
+    unsafe { pocketqjs_set_bytecode(bytes, if got == size { size } else { 0 }) };
+    got == size
+}
+
+/// The package file's size (0 when it is missing).
+pub fn package_size(app: &JsApp) -> usize {
+    unsafe { pocketnano_file_size(app.package.as_ptr()) as usize }
+}
+
+/// The whole package, read once into the heap; the Runtime takes ownership.
+pub struct Package(Option<Box<[u8]>>, usize);
+impl Package {
+    pub fn read(app: &JsApp) -> Option<Self> {
+        let size = package_size(app);
+        if size == 0 {
+            return None;
+        }
+        let mut bytes = alloc::vec![0u8; size].into_boxed_slice();
+        let got = unsafe { pocketnano_file_read(app.package.as_ptr(), bytes.as_mut_ptr(), size as u32) } as usize;
+        if got != size {
+            return None;
+        }
+        // The block holding the package is freed only as a whole, after the
+        // Runtime: its font atlases are read in place, not copied.
+        unsafe { pocketjs_core::text::set_resident_region(bytes.as_ptr(), size) };
+        Some(Self(Some(bytes), size))
+    }
+}
+impl PackageSource for Package {
+    fn length(&self) -> Result<usize, SourceError> {
+        Ok(self.1)
+    }
+    fn take_bytes(&mut self) -> Result<PackageBytes, SourceError> {
+        self.0.take().map(PackageBytes::Owned).ok_or(SourceError::Failed)
+    }
+    fn all(&mut self) -> Result<&[u8], SourceError> {
+        self.0.as_deref().ok_or(SourceError::Failed)
+    }
+    fn range(&mut self, offset: usize, buffer: &mut [u8]) -> Result<usize, SourceError> {
+        let bytes = self.0.as_deref().ok_or(SourceError::Failed)?;
+        if offset > bytes.len() {
+            return Err(SourceError::OutOfBounds);
+        }
+        let n = buffer.len().min(bytes.len() - offset);
+        buffer[..n].copy_from_slice(&bytes[offset..offset + n]);
+        Ok(n)
+    }
+}
+
+/// The guest table and instance for a fresh realm.
+pub struct Guest {
+    pub table: *const c_void,
+    pub instance: *mut c_void,
+}
+pub fn guest(memory_limit: usize, stack: usize, data: &'static str) -> Option<Guest> {
+    let mut table = core::ptr::null();
+    let mut instance = core::ptr::null_mut();
+    let data = if data.is_empty() { core::ptr::null() } else { data.as_ptr() };
+    let status = unsafe { pocketqjs_create(memory_limit, stack, data, &mut table, &mut instance) };
+    (status == 0).then_some(Guest { table, instance })
+}
+
+/// The guest's last JavaScript error ("" when none).
+pub fn error(guest: &Guest) -> &'static str {
+    unsafe {
+        let text = pocketqjs_error(guest.instance);
+        if text.is_null() {
+            return "";
+        }
+        let mut n = 0;
+        while *text.add(n) != 0 && n < 255 {
+            n += 1;
+        }
+        core::str::from_utf8(core::slice::from_raw_parts(text, n)).unwrap_or("")
+    }
+}
