+#[test]
+fn shape_cache_budget_frees_masks_not_drawn_this_frame() {
+    // Motion Lab on the iPod nano 7G: an animation sweeping corner radii
+    // kept every baked disc (16 KB each at r=32) until the heap ran out.
+    let budget = 40 << 10;
+    let mut ui = Ui::new();
+    ui.set_shape_cache_budget(budget);
+    let n = ui.create_node(0);
+    for (p, v) in [(spec::prop::WIDTH, 64.0), (spec::prop::HEIGHT, 64.0),
+        (spec::prop::BG_COLOR, 0xff2563ebu32 as f64)] { ui.set_prop(n, p, v); }
+    ui.insert_before(spec::ROOT_ID, n, 0);
+    let mut unbounded = Ui::new();
+    let m = unbounded.create_node(0);
+    for (p, v) in [(spec::prop::WIDTH, 64.0), (spec::prop::HEIGHT, 64.0),
+        (spec::prop::BG_COLOR, 0xff2563ebu32 as f64)] { unbounded.set_prop(m, p, v); }
+    unbounded.insert_before(spec::ROOT_ID, m, 0);
+    for r in 1..=32 {
+        ui.set_prop(n, spec::prop::RADIUS, r as f64);
+        ui.tick();
+        let words = ui.draw().words.clone();
+        assert!(ui.shape_cache_bytes() <= budget, "r={r}: {} bytes", ui.shape_cache_bytes());
+        assert_eq!(validate_drawlist(&words)[spec::draw_op::TEX_QUAD as usize], 4, "r={r} still uses the disc");
+        unbounded.set_prop(m, spec::prop::RADIUS, r as f64);
+        unbounded.tick();
+        let theirs = unbounded.draw().words.clone();
+        let ours = ui.draw().words.clone();
+        // Same geometry; only the (re-used or re-baked) texture handle may differ.
+        assert_eq!(ours.len(), theirs.len(), "r={r}");
+    }
+    assert!(unbounded.shape_cache_bytes() > 4 * budget, "unbounded keeps every radius");
+}
