diff --git a/programs/nano7g/preview/src/main.rs b/programs/nano7g/preview/src/main.rs
new file mode 100644
index 00000000..2cd660c9
--- /dev/null
+++ b/programs/nano7g/preview/src/main.rs
@@ -0,0 +1,177 @@
+//! Host preview of nano7g apps: runs the device crate's `Stage` over a
+//! scripted touch session, checks every frame against a full-tree layout
+//! solve, counts heap use, and writes the framebuffer as PNG at named frames.
+//! Usage: pocketjs-nano7g-preview <output-directory> [script]
+//! A script is lines of `frames x y` (touch held at x,y for that many
+//! frames; x < 0 means no touch), `shot NAME`, `sample KEY` (stop the app,
+//! check what it left on the heap, mount another) and `accel X Y Z` (raw
+//! accelerometer counts, 65536 per g).
+
+use pocketjs_nano7g::{specs, Stage, Touch, HEIGHT, WIDTH};
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    fs::File,
+    io::BufWriter,
+    path::Path,
+    sync::atomic::{AtomicUsize, Ordering},
+};
+
+struct Counting;
+static LIVE: AtomicUsize = AtomicUsize::new(0);
+static PEAK: AtomicUsize = AtomicUsize::new(0);
+/// NANO7G_ALLOC_LOG=<bytes>: print every allocation at least that big (where the heap goes).
+static BIG: AtomicUsize = AtomicUsize::new(usize::MAX);
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let now = LIVE.fetch_add(layout.size(), Ordering::Relaxed) + layout.size();
+        PEAK.fetch_max(now, Ordering::Relaxed);
+        if layout.size() >= BIG.load(Ordering::Relaxed) {
+            // eprintln allocates nothing for plain integers.
+            eprintln!("alloc {} (live {})", layout.size(), now);
+        }
+        System.alloc(layout)
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        LIVE.fetch_sub(layout.size(), Ordering::Relaxed);
+        System.dealloc(ptr, layout)
+    }
+}
+#[global_allocator]
+static ALLOCATOR: Counting = Counting;
+
+fn write_png(path: &Path, pixels: &[u32]) {
+    let mut rgb = Vec::with_capacity(pixels.len() * 3);
+    for &p in pixels {
+        rgb.extend_from_slice(&[(p >> 16) as u8, (p >> 8) as u8, p as u8]);
+    }
+    let mut encoder = png::Encoder::new(
+        BufWriter::new(File::create(path).unwrap()),
+        WIDTH as u32,
+        HEIGHT as u32,
+    );
+    encoder.set_color(png::ColorType::Rgb);
+    encoder.set_depth(png::BitDepth::Eight);
+    encoder
+        .write_header()
+        .unwrap()
+        .write_image_data(&rgb)
+        .unwrap();
+}
+
+enum Step {
+    Hold(usize, Touch),
+    Shot(String),
+    Sample(String),
+    Accel([i32; 3]),
+}
+
+fn parse(script: &str) -> Vec<Step> {
+    let mut steps = Vec::new();
+    for line in script.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('#')) {
+        let words: Vec<&str> = line.split_whitespace().collect();
+        match words[0] {
+            "shot" => steps.push(Step::Shot(words[1].to_string())),
+            "sample" => steps.push(Step::Sample(words[1].to_string())),
+            "accel" => steps.push(Step::Accel([1, 2, 3].map(|i| words[i].parse().unwrap()))),
+            _ => {
+                let frames: usize = words[0].parse().expect("frame count");
+                let x: i32 = words.get(1).map_or(-1, |w| w.parse().unwrap());
+                let y: i32 = words.get(2).map_or(-1, |w| w.parse().unwrap());
+                steps.push(Step::Hold(frames, Touch { x, y, down: x >= 0 }));
+            }
+        }
+    }
+    steps
+}
+
+const DEFAULT_SCRIPT: &str = "60\nshot 00-settled\n";
+
+struct Stats {
+    frames: usize,
+    regions: usize,
+    pixels: u64,
+    full: usize,
+}
+
+fn mount(index: usize, framebuffer: &mut [u32], menu: bool) -> (Stage, usize) {
+    let before = LIVE.load(Ordering::Relaxed);
+    let stage = unsafe { Stage::new(index, framebuffer.as_mut_ptr(), menu) };
+    (stage, LIVE.load(Ordering::Relaxed) - before)
+}
+
+fn finish(stage: Stage, stats: &Stats, mounted: usize, base: usize) {
+    let key = stage.spec().key;
+    let live = LIVE.load(Ordering::Relaxed) - base;
+    drop(stage);
+    let leaked = LIVE.load(Ordering::Relaxed) - base;
+    println!(
+        "{key}: {} frames, {} damage regions, {} px/frame average, {} full redraws, layout oracle clean",
+        stats.frames,
+        stats.regions,
+        stats.pixels / stats.frames.max(1) as u64,
+        stats.full
+    );
+    println!(
+        "{key}: heap mounted {mounted} bytes, live at end {live} bytes, peak {} bytes, after drop {leaked} bytes",
+        PEAK.swap(0, Ordering::Relaxed).saturating_sub(base)
+    );
+}
+
+fn main() {
+    if let Some(n) = std::env::var("NANO7G_ALLOC_LOG").ok().and_then(|v| v.parse().ok()) {
+        BIG.store(n, Ordering::Relaxed);
+    }
+    let mut args = std::env::args().skip(1);
+    let out = args.next().expect("usage: pocketjs-nano7g-preview <output-directory> [script]");
+    let out = Path::new(&out);
+    std::fs::create_dir_all(out).unwrap();
+    let script = args
+        .next()
+        .map(|path| std::fs::read_to_string(path).unwrap())
+        .unwrap_or_else(|| DEFAULT_SCRIPT.to_string());
+    let menu = specs().len() > 1;
+    let mut framebuffer = vec![0u32; WIDTH * HEIGHT];
+    let base = LIVE.load(Ordering::Relaxed);
+    PEAK.store(base, Ordering::Relaxed);
+    let (mut stage, mut mounted) = mount(0, &mut framebuffer, menu);
+    let mut stats = Stats { frames: 0, regions: 0, pixels: 0, full: 0 };
+    let mut accel = [0, 0, 0];
+    let mut clock = 0u64;
+    for step in parse(&script) {
+        match step {
+            Step::Shot(name) => {
+                write_png(&out.join(format!("{name}.png")), stage.pixels());
+                println!("{name}: frame {}", stats.frames);
+            }
+            Step::Accel(sample) => accel = sample,
+            Step::Sample(key) => {
+                let index = specs().iter().position(|s| s.key == key).unwrap_or_else(|| panic!("no sample {key}"));
+                finish(stage, &stats, mounted, base);
+                framebuffer.fill(0);
+                PEAK.store(LIVE.load(Ordering::Relaxed), Ordering::Relaxed);
+                (stage, mounted) = mount(index, &mut framebuffer, menu);
+                stats = Stats { frames: 0, regions: 0, pixels: 0, full: 0 };
+            }
+            Step::Hold(count, touch) => {
+                for _ in 0..count {
+                    clock += 33_333;
+                    let damage = stage.frame(0, touch, accel, clock);
+                    let n = damage.len();
+                    stats.regions += n;
+                    let area: u64 = damage.iter().map(|r| r.area()).sum();
+                    if area == (WIDTH * HEIGHT) as u64 {
+                        stats.full += 1;
+                    }
+                    stats.pixels += area;
+                    if std::env::var_os("NANO7G_DAMAGE_LOG").is_some() {
+                        let (asked, composed) = stage.compose_stats();
+                        println!("damage frame {} rects {n} reported {area} asked {asked} composed {composed}", stats.frames);
+                    }
+                    stage.assert_layout();
+                    stats.frames += 1;
+                }
+            }
+        }
+    }
+    finish(stage, &stats, mounted, base);
+}
diff --git a/programs/nano7g/src/compose.rs b/programs/nano7g/src/compose.rs
new file mode 100644
index 00000000..cf9fe42f
--- /dev/null
+++ b/programs/nano7g/src/compose.rs
@@ -0,0 +1,328 @@
+//! Scale the app's own buffer into the panel (portrait or turned sideways).
+//!
+//! Hot on the iPod: a landscape app redraws up to 432 x 245 panel pixels a
+//! frame. Per panel row one viewer coordinate is fixed (x when turned, y
+//! otherwise), so its source row, weight and range are worked out once and
+//! only the other coordinate steps, by addition. The result is exactly the
+//! per-pixel formula kept below as `scale_reference` (tested against it).
+
+use crate::pad::{self, Layout, Rect, PANEL_W};
+
+/// The app's buffer: XRGB8888, or RGB565 for an app that needs the memory
+/// (half the bytes; 5/6/5 bits per channel before scaling).
+pub trait Texels {
+    fn texel(&self, index: usize) -> u32;
+}
+impl Texels for [u32] {
+    #[inline(always)]
+    fn texel(&self, index: usize) -> u32 {
+        self[index]
+    }
+}
+impl Texels for [u16] {
+    #[inline(always)]
+    fn texel(&self, index: usize) -> u32 {
+        let p = self[index] as u32;
+        let (r, g, b) = ((p >> 11) & 31, (p >> 5) & 63, p & 31);
+        0xff00_0000 | ((r << 3 | r >> 2) << 16) | ((g << 2 | g >> 4) << 8) | (b << 3 | b >> 2)
+    }
+}
+
+/// Bilinear scale of `source` (the logical lw x lh buffer) into the panel
+/// rectangle `r` (already clipped to the panel).
+pub fn scale_rect<S: Texels + ?Sized>(layout: &Layout, source: &S, fb: &mut [u32], r: Rect, background: u32) {
+    let [lw, lh] = layout.logical;
+    let view = layout.view;
+    let inv = layout.inv;
+    let half = inv / 2 - pad::ONE / 2;
+    // Logical 16.16 position of viewer coordinate `c` along an axis.
+    let at = |c: i32, origin: i32| ((c - origin) * inv + half).max(0);
+    // The varying axis maps panel column i to the same source texel and
+    // weight on every row: work that out once per call (pocketjs16).
+    let mut plan = if inv == pad::ONE { None } else { Plan::new(layout, r, &at) };
+    for py in r.y..r.y + r.h {
+        let row = &mut fb[(py * PANEL_W + r.x) as usize..(py * PANEL_W + r.x + r.w) as usize];
+        // Turned: viewer (x, y) = (py, PANEL_W - 1 - px); else (px, py).
+        let (fixed, fixed_lo, fixed_len, var_origin, var_len) = if layout.landscape {
+            (py, view.x, view.w, view.y, view.h)
+        } else {
+            (py, view.y, view.h, view.x, view.w)
+        };
+        if fixed < fixed_lo || fixed >= fixed_lo + fixed_len {
+            row.fill(background);
+            continue;
+        }
+        let f = at(fixed, fixed_lo);
+        let limit_f = if layout.landscape { lw } else { lh };
+        let limit_v = if layout.landscape { lh } else { lw };
+        let f0 = (f >> 16).min(limit_f - 1);
+        let f1 = (f0 + 1).min(limit_f - 1);
+        let wf = ((f >> 8) & 0xff) as u32;
+        if inv == pad::ONE {
+            // 1:1 (Notes, Talk: 432 x 240 on the turned panel): every weight
+            // is 0, so the bilinear mix is the top-left texel; copy it
+            // (pocketjs14: the general path was 42% of a Notes key press).
+            for (i, out) in row.iter_mut().enumerate() {
+                let px = r.x + i as i32;
+                let var = if layout.landscape { PANEL_W - 1 - px } else { px };
+                if var < var_origin || var >= var_origin + var_len {
+                    *out = background;
+                    continue;
+                }
+                let v0 = (var - var_origin).min(limit_v - 1);
+                let (x0, y0) = if layout.landscape { (f0, v0) } else { (v0, f0) };
+                *out = 0xff00_0000 | (source.texel((y0 * lw + x0) as usize) & 0x00ff_ffff);
+            }
+            continue;
+        }
+        if let Some(plan) = plan.as_mut() {
+            plan.row(layout, source, row, f0, f1, wf, background);
+            continue;
+        }
+        for (i, out) in row.iter_mut().enumerate() {
+            let px = r.x + i as i32;
+            let var = if layout.landscape { PANEL_W - 1 - px } else { px };
+            if var < var_origin || var >= var_origin + var_len {
+                *out = background;
+                continue;
+            }
+            let v = at(var, var_origin);
+            let v0 = (v >> 16).min(limit_v - 1);
+            let v1 = (v0 + 1).min(limit_v - 1);
+            let wv = ((v >> 8) & 0xff) as u32;
+            // (x, y, fx, fy) in source terms.
+            let (x0, x1, y0, y1, fx, fy) =
+                if layout.landscape { (f0, f1, v0, v1, wf, wv) } else { (v0, v1, f0, f1, wv, wf) };
+            let a = source.texel((y0 * lw + x0) as usize);
+            let b = source.texel((y0 * lw + x1) as usize);
+            let c = source.texel((y1 * lw + x0) as usize);
+            let d = source.texel((y1 * lw + x1) as usize);
+            *out = mix4(a, b, c, d, fx, fy);
+        }
+    }
+}
+
+/// Longest source line `separable` handles (Motion Lab's 480 x 272 fits).
+const SEP_MAX: usize = 512;
+
+/// The general (scaled) path, worked out separably (pocketjs15: per pixel
+/// it was half of a Motion Lab frame). The bilinear mix is a sum of four
+/// products with no rounding in between, so mixing the two source lines of
+/// the fixed axis first, once per source texel, then the varying axis per
+/// panel pixel gives exactly `mix4`. Red and blue share one word (16 bits
+/// each: at most 255 x 256). pocketjs16: the column table and the line
+/// buffers are built once per call, not per row (the per-row zeroing alone
+/// was 1.5M instructions a Motion Lab frame), and the inner loop is a table
+/// lookup with no closure call.
+struct Plan {
+    /// Per panel column of `r`: v0 | weight << 16, or BG for outside the view.
+    tab: [u32; PLAN_MAX],
+    len: usize,
+    lo: i32,
+    hi: i32,
+    rb: [u32; SEP_MAX],
+    gg: [u32; SEP_MAX],
+    /// Two source lines (along the varying axis) already expanded to
+    /// XRGB8888, and which fixed-axis index each holds (-1: none). Panel
+    /// row n's second line is usually row n+1's first: each texel of an
+    /// RGB565 buffer is expanded once instead of twice.
+    lines: [[u32; SEP_MAX]; 2],
+    line_f: [i32; 2],
+}
+
+const PLAN_MAX: usize = 512;
+const BG: u32 = u32::MAX;
+
+impl Plan {
+    fn new(layout: &Layout, r: Rect, at: &dyn Fn(i32, i32) -> i32) -> Option<Plan> {
+        let [lw, lh] = layout.logical;
+        let view = layout.view;
+        let (var_origin, var_len, limit_v) =
+            if layout.landscape { (view.y, view.h, lh) } else { (view.x, view.w, lw) };
+        if limit_v as usize > SEP_MAX || r.w <= 0 || r.w as usize > PLAN_MAX {
+            return None;
+        }
+        let mut plan = Plan { tab: [BG; PLAN_MAX], len: r.w as usize, lo: i32::MAX, hi: -1,
+            rb: [0; SEP_MAX], gg: [0; SEP_MAX], lines: [[0; SEP_MAX]; 2], line_f: [-1; 2] };
+        for i in 0..r.w {
+            let px = r.x + i;
+            let var = if layout.landscape { PANEL_W - 1 - px } else { px };
+            if var < var_origin || var >= var_origin + var_len {
+                continue;
+            }
+            let v = at(var, var_origin);
+            let v0 = (v >> 16).min(limit_v - 1);
+            let v1 = (v0 + 1).min(limit_v - 1);
+            plan.lo = plan.lo.min(v0);
+            plan.hi = plan.hi.max(v1);
+            // At the last texel v1 == v0: the mix is that texel (weight 0).
+            let wv = if v1 == v0 { 0 } else { ((v >> 8) & 0xff) as u32 };
+            plan.tab[i as usize] = v0 as u32 | wv << 16;
+        }
+        Some(plan)
+    }
+
+    /// The cached line slot holding fixed-axis index `f`, reading it if
+    /// needed into the slot that does not hold `keep`.
+    fn line<S: Texels + ?Sized>(&mut self, layout: &Layout, source: &S, f: i32, keep: i32) -> usize {
+        if self.line_f[0] == f {
+            return 0;
+        }
+        if self.line_f[1] == f {
+            return 1;
+        }
+        let slot = if self.line_f[0] == keep { 1 } else { 0 };
+        let lw = layout.logical[0];
+        let (lo, hi) = (self.lo as usize, self.hi as usize);
+        let (mut i, step) = if layout.landscape { ((self.lo * lw + f) as usize, lw as usize) } else { ((f * lw + self.lo) as usize, 1) };
+        let line = &mut self.lines[slot];
+        for k in lo..=hi {
+            // SAFETY: k <= hi < SEP_MAX.
+            unsafe { *line.get_unchecked_mut(k) = source.texel(i) };
+            i += step;
+        }
+        self.line_f[slot] = f;
+        slot
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    #[inline(never)]
+    fn row<S: Texels + ?Sized>(&mut self, layout: &Layout, source: &S, row: &mut [u32], f0: i32, f1: i32, wf: u32, background: u32) {
+        let lw = layout.logical[0];
+        let gf = 256 - wf;
+        if self.hi >= self.lo {
+            let s0 = self.line(layout, source, f0, f1);
+            let s1 = if f1 == f0 { s0 } else { self.line(layout, source, f1, f0) };
+            let (lo, hi) = (self.lo as usize, self.hi as usize);
+            let (la, lb) = (&self.lines[s0], &self.lines[s1]);
+            let (rb, gg) = (&mut self.rb, &mut self.gg);
+            for k in lo..=hi {
+                // SAFETY: k <= hi < limit_v <= SEP_MAX (Plan::new).
+                unsafe {
+                    let a = *la.get_unchecked(k);
+                    if wf == 0 {
+                        *rb.get_unchecked_mut(k) = (a & 0x00ff_00ff) << 8;
+                        *gg.get_unchecked_mut(k) = a & 0xff00;
+                    } else {
+                        let b = *lb.get_unchecked(k);
+                        *rb.get_unchecked_mut(k) = (a & 0x00ff_00ff) * gf + (b & 0x00ff_00ff) * wf;
+                        *gg.get_unchecked_mut(k) = ((a >> 8) & 0xff) * gf + ((b >> 8) & 0xff) * wf;
+                    }
+                }
+            }
+        }
+        let (rb, gg) = (&self.rb, &self.gg);
+        for (out, &t) in row.iter_mut().zip(self.tab[..self.len].iter()) {
+            if t == BG {
+                *out = background;
+                continue;
+            }
+            let v0 = (t & 0xffff) as usize;
+            let wv = t >> 16;
+            // SAFETY: v0 <= hi, and v0 + 1 <= hi when wv != 0 (Plan::new).
+            let (p, g0) = unsafe { (*rb.get_unchecked(v0), *gg.get_unchecked(v0)) };
+            *out = if wv == 0 {
+                0xff00_0000 | (p >> 8) & 0x00ff_00ff | g0 & 0xff00
+            } else {
+                let gv = 256 - wv;
+                let (q, g1) = unsafe { (*rb.get_unchecked(v0 + 1), *gg.get_unchecked(v0 + 1)) };
+                let red = (((p >> 16) * gv + (q >> 16) * wv) >> 16) & 0xff;
+                let blue = (((p & 0xffff) * gv + (q & 0xffff) * wv) >> 16) & 0xff;
+                let green = ((g0 * gv + g1 * wv) >> 16) & 0xff;
+                0xff00_0000 | red << 16 | green << 8 | blue
+            };
+        }
+    }
+}
+
+#[inline(always)]
+fn mix4(a: u32, b: u32, c: u32, d: u32, fx: u32, fy: u32) -> u32 {
+    if a == b && a == c && a == d {
+        return 0xff00_0000 | (a & 0x00ff_ffff);
+    }
+    let (gx, gy) = (256 - fx, 256 - fy);
+    let channel = |shift: u32| {
+        let top = ((a >> shift) & 0xff) * gx + ((b >> shift) & 0xff) * fx;
+        let bottom = ((c >> shift) & 0xff) * gx + ((d >> shift) & 0xff) * fx;
+        ((top * gy + bottom * fy) >> 16) & 0xff
+    };
+    0xff00_0000 | channel(16) << 16 | channel(8) << 8 | channel(0)
+}
+
+/// The original per-pixel version, the oracle for `scale_rect`.
+#[cfg(test)]
+pub fn scale_reference(layout: &Layout, source: &[u32], fb: &mut [u32], r: Rect, background: u32) {
+    let [lw, lh] = layout.logical;
+    for py in r.y..r.y + r.h {
+        for px in r.x..r.x + r.w {
+            let (vx, vy) = layout.to_viewer(px, py);
+            let out = &mut fb[(py * PANEL_W + px) as usize];
+            if !layout.view.contains(vx, vy) {
+                *out = background;
+                continue;
+            }
+            let u = ((vx - layout.view.x) * layout.inv + layout.inv / 2 - pad::ONE / 2).max(0);
+            let v = ((vy - layout.view.y) * layout.inv + layout.inv / 2 - pad::ONE / 2).max(0);
+            let (x0, y0) = ((u >> 16).min(lw - 1), (v >> 16).min(lh - 1));
+            let (x1, y1) = ((x0 + 1).min(lw - 1), (y0 + 1).min(lh - 1));
+            let (fx, fy) = (((u >> 8) & 0xff) as u32, ((v >> 8) & 0xff) as u32);
+            let px_at = |x: i32, y: i32| source[(y * lw + x) as usize];
+            let (a, b, c, d) = (px_at(x0, y0), px_at(x1, y0), px_at(x0, y1), px_at(x1, y1));
+            let channel = |shift: u32| {
+                let top = ((a >> shift) & 0xff) * (256 - fx) + ((b >> shift) & 0xff) * fx;
+                let bottom = ((c >> shift) & 0xff) * (256 - fx) + ((d >> shift) & 0xff) * fx;
+                ((top * (256 - fy) + bottom * fy) >> 16) & 0xff
+            };
+            *out = 0xff00_0000 | channel(16) << 16 | channel(8) << 8 | channel(0);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::pad::PANEL_H;
+    use crate::samples::Pad;
+    use alloc::vec;
+
+    fn check(logical: [u32; 2], pad: Pad) {
+        let layout = Layout::new(logical, pad, true);
+        let [lw, lh] = layout.logical;
+        let mut seed = 0x1234_5678u32;
+        let mut source = vec![0u32; (lw * lh) as usize];
+        for (i, p) in source.iter_mut().enumerate() {
+            seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+            // Flat runs and noise, so the equal-corners shortcut is hit too.
+            *p = if (i / 37) % 3 == 0 { 0xff20_4060 } else { seed | 0xff00_0000 };
+        }
+        for r in [Rect::new(0, 0, PANEL_W, PANEL_H), Rect::new(17, 33, 101, 77), Rect::new(239, 431, 1, 1)] {
+            let mut fast = vec![1u32; (PANEL_W * PANEL_H) as usize];
+            let mut slow = fast.clone();
+            scale_rect(&layout, source.as_slice(), &mut fast, r, 0xff00_0000);
+            scale_reference(&layout, &source, &mut slow, r, 0xff00_0000);
+            assert!(fast == slow, "{logical:?} {r:?}");
+        }
+    }
+
+    #[test]
+    fn rgb565_texels_expand_to_full_range() {
+        let t: [u16; 4] = [0xffff, 0x0000, 0xf800, 0x07e0];
+        assert_eq!(t[..].texel(0), 0xffff_ffff);
+        assert_eq!(t[..].texel(1), 0xff00_0000);
+        assert_eq!(t[..].texel(2), 0xffff_0000);
+        assert_eq!(t[..].texel(3), 0xff00_ff00);
+    }
+
+    #[test]
+    fn landscape_matches_the_per_pixel_formula() {
+        check([432, 240], Pad::Landscape);
+        check([480, 272], Pad::Buttons { wheel: false });
+        check([240, 160], Pad::Buttons { wheel: false });
+    }
+
+    #[test]
+    fn portrait_matches_the_per_pixel_formula() {
+        check([176, 132], Pad::Buttons { wheel: true });
+        check([200, 300], Pad::None);
+    }
+}
