+import { Show } from "solid-js";
+import { Image, Text, View } from "@pocketjs/framework/solid/components";
+import { onMount } from "@pocketjs/framework/solid/lifecycle";
+import { count, minus, phase, press, reset, start, underline } from "./app";
+
+// 240 x 432 portrait touch panel (iPod nano 7th generation).
+export default function App() {
+  onMount(start);
+  return (
+    <View debugName="HeroScreen" class="w-full h-full layout-baked bg-gradient-to-b from-slate-50 to-slate-100">
+      <Image class="absolute left-[12] top-[14] w-[32] h-[32] rounded-lg shadow" src="logo.png" />
+      <View class="absolute left-[54] top-[12] flex-col">
+        <Text class="text-lg font-bold text-slate-950">PocketJS</Text>
+        <Text class="text-xs text-slate-500">MICROTS + NANO 7G</Text>
+      </View>
+      <View class="absolute right-[12] top-[12] flex-col items-end">
+        <Text class="text-lg font-bold text-emerald-600">30</Text>
+        <Text class="text-xs text-slate-500">FPS</Text>
+      </View>
+      <Text class="absolute left-[12] top-[64] text-xs text-blue-600">ONE CORE / ONE APP / NO VM</Text>
+      <Text class="absolute left-[12] top-[82] text-2xl font-bold text-slate-950">JSX on a nano.</Text>
+      <View debugName="Spinner" class="absolute left-[196] top-[120] w-[32] h-[32] contain-strict">
+        <Show when={phase() === 0}><Image class="w-[32] h-[32]" src="spinner-00.svg" /></Show>
+        <Show when={phase() === 1}><Image class="w-[32] h-[32]" src="spinner-01.svg" /></Show>
+        <Show when={phase() === 2}><Image class="w-[32] h-[32]" src="spinner-02.svg" /></Show>
+        <Show when={phase() === 3}><Image class="w-[32] h-[32]" src="spinner-03.svg" /></Show>
+        <Show when={phase() === 4}><Image class="w-[32] h-[32]" src="spinner-04.svg" /></Show>
+        <Show when={phase() === 5}><Image class="w-[32] h-[32]" src="spinner-05.svg" /></Show>
+        <Show when={phase() === 6}><Image class="w-[32] h-[32]" src="spinner-06.svg" /></Show>
+        <Show when={phase() === 7}><Image class="w-[32] h-[32]" src="spinner-07.svg" /></Show>
+        <Show when={phase() < 0}><Text class="absolute left-0 top-[6] w-[32] h-[20] text-sm font-bold text-emerald-600">OK</Text></Show>
+      </View>
+      <Text class="absolute left-[12] top-[124] w-[170] text-sm text-slate-600">TSX, flexbox, signals. AOT.</Text>
+      <View ref={underline} debugName="Underline" class="absolute left-[12] top-[166] h-[4] w-0 rounded-[2px] shadow bg-gradient-to-r from-blue-500 to-cyan-500" style={{ translateX: count() }} />
+      <View debugName="Counter" class="absolute left-[12] top-[186] w-[216] h-[64] rounded-xl bg-white shadow">
+        <Text class="absolute left-[16] top-[10] w-[184] h-[44] text-4xl font-bold text-slate-950">{count()}</Text>
+      </View>
+      <View debugName="HeroAction" class="absolute left-[12] top-[266] w-[140] h-[56] items-center justify-center rounded-xl shadow-md bg-blue-600 border-blue-500 active:bg-blue-800 transition-colors duration-150" focusable onPress={press}>
+        <Text class="text-lg font-bold text-white">Tap +1</Text>
+      </View>
+      <View debugName="MinusAction" class="absolute left-[164] top-[266] w-[64] h-[56] items-center justify-center rounded-xl shadow-md bg-slate-600 active:bg-slate-800 transition-colors duration-150" focusable onPress={minus}>
+        <Text class="text-lg font-bold text-white">-1</Text>
+      </View>
+      <View debugName="ResetAction" class="absolute left-[12] top-[334] w-[216] h-[44] items-center justify-center rounded-xl border-2 border-slate-300 bg-slate-50 active:bg-slate-200 transition-colors duration-150" focusable onPress={reset}>
+        <Text class="text-sm font-bold text-slate-700">Reset</Text>
+      </View>
+      <View debugName="ReactiveMessage" class="absolute left-[12] top-[392] w-[216] h-[20]">
+        <Show when={count() > 3}><Text class="absolute left-0 top-0 w-[216] h-[20] text-sm text-emerald-600">Reactive on iPod nano 7G.</Text></Show>
+      </View>
+    </View>
+  );
+}
