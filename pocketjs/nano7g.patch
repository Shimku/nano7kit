index 00000000..997ff736
--- /dev/null
+++ b/apps/nano7g-samples/ipodnano-hero/app.ts
@@ -0,0 +1,45 @@
+import { createSignal } from "solid-js";
+import { animate, createNodeRef } from "@pocketjs/framework/animation";
+import { frames, imod, type i32 } from "@pocketjs/framework/solid/std";
+
+export const [count, setCount] = createSignal<i32>(0);
+export const [phase, setPhase] = createSignal<i32>(0);
+export const underline = createNodeRef();
+
+export function press(): void {
+  setCount(count() + 1);
+}
+
+export function reset(): void {
+  setCount(0);
+}
+
+export function reveal(): void {
+  animate(underline, "width", 104, { dur: 700 as i32, easing: "out", delay: 150 as i32 });
+}
+
+// nano7g: the spinner turns while the underline grows (150 ms delay +
+// 700 ms, about 26 ticks at 30 Hz) and then stops; phase -1 shows the done
+// mark (as in JS Hero). Upstream spins forever.
+export const SPIN_STEPS: i32 = 9;
+export async function spin(): Promise<void> {
+  for (let step: i32 = 0; step < SPIN_STEPS; step++) {
+    await frames(2);
+    setPhase(phase() === 7 ? 0 : phase() + 1);
+    await frames(1);
+    setPhase(phase() === 7 ? 0 : phase() + 1);
+  }
+  setPhase(-1);
+}
+
+// nano7g: the underline steps 2 px a press and wraps after 8 presses (as
+// upstream Hero does), so it never leaves the screen. Upstream adds 2 px a
+// press without end.
+export function underlineOffset(): i32 {
+  return imod(count(), 8) * 2;
+}
+
+export function start(): void {
+  reveal();
+  spin();
+}
