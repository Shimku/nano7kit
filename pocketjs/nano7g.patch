@@ -0,0 +1,26 @@
+import { expect, test } from "bun:test";
+
+import { decorateNativeNode, isNativeNode, type NodeMirror } from "../framework/src/native-tree.ts";
+
+function bare(id: number): NodeMirror {
+  return { id, type: 0, parent: null, children: [] };
+}
+
+// Each decorated node used to carry ~40 closures and its own accessor table:
+// about 7 KB of QuickJS heap per node, 850 KB for the on-screen keyboard.
+test("decorated native nodes share one prototype and own no DOM-shim members", () => {
+  const a = decorateNativeNode(bare(2));
+  const b = decorateNativeNode(bare(3));
+  expect(isNativeNode(a)).toBe(true);
+  expect(Object.getPrototypeOf(a)).toBe(Object.getPrototypeOf(b));
+  expect(Object.keys(a).sort()).toEqual(["children", "id", "parent", "type"]);
+  expect(decorateNativeNode(a)).toBe(a);
+});
+
+test("style and classList stay per node", () => {
+  const a = decorateNativeNode(bare(4)) as unknown as { style: Record<string, unknown> };
+  const b = decorateNativeNode(bare(5)) as unknown as { style: Record<string, unknown> };
+  a.style.color = "red";
+  expect(b.style.color).toBeUndefined();
+  expect(a.style.color).toBe("red");
+});
