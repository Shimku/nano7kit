+    /// NUL-terminated path of its precompiled bytecode (pocketqjsc), optional:
+    /// without it, or when it was made from another bundle, the package's
+    /// JavaScript is parsed on the device instead.
+    pub bytecode: &'static str,
+    /// Private stack beyond the default, for the realm's deeper recursion
+    /// (the QuickJS stack limit grows by the same amount).
+    pub stack: usize,
+    /// Draw into an RGB565 buffer instead of XRGB8888 (landscape apps only:
+    /// they have a buffer of their own). Half the bytes, for an app that
+    /// needs them; colours keep 5/6/5 bits until the scale to the panel.
+    pub narrow: bool,
+    /// NUL-terminated name of the app's data folder for data.fs
+    /// (`/Apps/Data/PocketJS/<data>/`), or "" for an app without files.
+    pub data: &'static str,
+    /// Offered on the PocketJS home screen only, not in the shim's list
+    /// (pocketjs13: the list keeps its nine rows).
+    pub home_only: bool,
