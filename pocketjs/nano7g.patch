+    /// A QuickJS runtime and realm in the app's block with the canonical
+    /// guest attached; 0 on success.
+    fn pocketqjs_create(memory_limit: usize, stack: usize, data: *const u8, table: *mut *const c_void, guest: *mut *mut c_void) -> i32;
+    fn pocketqjs_error(guest: *mut c_void) -> *const u8;
+    fn pocketqjs_bytecode_buffer(length: usize) -> *mut u8;
+    fn pocketqjs_set_bytecode(bytes: *mut u8, length: usize);
