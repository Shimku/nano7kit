+[package]
+name = "pocketjs-nano7g"
+edition = "2021"
+
+version.workspace = true
+repository.workspace = true
+rust-version.workspace = true
+license.workspace = true
+description = "PocketJS iPod nano 7th generation (NanoApps) component"
+publish = false
+
+[lib]
+crate-type = ["staticlib", "rlib"]
+test = false
+bench = false
+
+[dependencies]
+pocket-spec = { workspace = true, default-features = true }
+microts = { workspace = true, default-features = true, features = ["runtime"] }
+pocketjs-core = { workspace = true, default-features = true }
+pocket-runtime = { workspace = true, default-features = true, features = ["quiet-frames"] }
+pocket-drivers = { workspace = true, default-features = true }
+libm = "0.2"
+pocket-runtime-cabi = { workspace = true, optional = true, features = ["external-runtime"] }
+pocket-package = { workspace = true, optional = true }
+
+[target.'cfg(target_os = "none")'.dependencies]
+microts = { workspace = true, default-features = true, features = ["critical-section"] }
+linked_list_allocator = { version = "0.10.5", default-features = false }
+critical-section = { version = "1.2", features = ["restore-state-bool"] }
+
+[build-dependencies]
+pocket-profile-build.workspace = true
+
+[features]
+# The full-tree layout oracle, linked by the host preview only.
+counters = ["microts/counters"]
+# PocketJS packages (JavaScript) run by QuickJS through the canonical C guest.
+quickjs = ["dep:pocket-runtime-cabi", "dep:pocket-package"]
diff --git a/programs/nano7g/README.md b/programs/nano7g/README.md
new file mode 100644
index 00000000..8af4c32f
--- /dev/null
+++ b/programs/nano7g/README.md
@@ -0,0 +1,82 @@
+# iPod nano 7th generation (nano7g)
+
+This experimental host runs MicroTS apps on the iPod nano 7th generation as
+[NanoApps](https://github.com/nfzerox/NanoApps) `RAW_SURFACE` apps. **MicroTS
+compiles the TypeScript model and TSX view into Rust; the app links the
+generated code, the retained core and the software rasterizer, with no
+JavaScript VM.** Apps:
+
+- [`apps/nano7g-hero`](../../apps/nano7g-hero), a 240 x 432 touch version of
+  the Hero scene;
+- [`apps/nano7g-tilt`](../../apps/nano7g-tilt), a `MotionHandler` demo on the
+  accelerometer;
+- [`apps/nano7g-samples`](../../apps/nano7g-samples): nano7g manifests for the
+  upstream `gba-hero`, `ipodnano-hero`, `hero`, `solid-aot-lab` and
+  `vue-sfc-lab` samples at their own logical size with `presentation: "fit"`.
+
+Several apps can be linked into one library (`build.ts --sample=key:dir`,
+repeated); it opens with a menu, and each app's menu key stops it, drops
+everything it allocated and returns to the menu.
+
+## Device contract
+
+| Fact | Value |
+| --- | --- |
+| CPU | ARM Cortex-A8 (Samsung SoC) |
+| Code | Thumb-2, soft float (the firmware traps VFP and NEON in app code) |
+| Panel | 240 x 432 portrait, XRGB8888 framebuffer composited by the OS |
+| Input | one touch point from the NanoApps surface runtime; volume up and down as Up and Down |
+| Buttons | apps that want `input.buttons` get an on-screen pad: below the view in portrait, translucent over it in landscape (the panel is turned for apps wider than 240); `-`/`+` keys for a relative axis (click wheel samples) |
+| Motion | the accelerometer (3 x int32 at 1/65536 g) as `MotionState` gravity, beta, gamma, inclination; low-pass filtered, quality medium |
+| Display | `native` at 240 x 432; other logical sizes render to an offscreen buffer and are scaled to fit (bilinear) |
+| Heartbeat | about 60 Hz; one Runtime tick per 1/30 s of wall time, at most one per heartbeat |
+| Heap | one OS heap block per app, sized from its measured ARM peak (`Spec.heap`), taken only if the OS keeps 1 MiB in one block and 2 MiB in all; baked font atlases are read in place (`load_font_atlas_static`) |
+| Audio, network, files | not used |
+
+The app is loaded by the NanoApps resident into an OS heap arena and relocated
+at load time. The relocator rebases absolute words only, so the library is
+built with `+no-movt` and the static relocation model.
+
+## Memory and lifecycle
+
+Raw surface apps get no quit callback. The shim allocates the Rust heap as one
+OS block and registers it as the app's aux block, which the resident frees when
+the app unloads (Home, app switch, relaunch). Nothing else is allocated, so
+quitting returns all memory. A cached relaunch re-enters the image without
+reloading it: the runtime zeroes `.bss`, and every Rust static the shim uses
+lives in `.bss` and is rebuilt on start.
+
+A Rust panic long-jumps back into the shim, which shows the failing line and
+the heap peak and stops ticking; Home still exits.
+
+The Rust core (boot and every frame) runs on a private 48 KB stack carved from
+the top of the heap block: boot needs about 19 KB and the first layout of a
+large sample about 13 KB, more than the app task stack is known to give. The
+file `/Apps/Data/PocketJS/no_private_stack.txt` on the iPod turns this off.
+
+## Build
+
+From a checkout with Bun, Rustup (toolchain `nightly-2026-07-02` with
+`rust-src`) and Arm GNU `arm-none-eabi-gcc`:
+
+```sh
+bun install --frozen-lockfile
+bun tools/wasm.ts
+bun tools/pocket.ts compile --manifest apps/nano7g-hero/pocket.app.json --project-root . --target nano7g --aot --out .pocket-build/generated/nano7g
+bun tools/build/nano7g/build.ts --aot-dir=.pocket-build/generated/nano7g --outdir=dist/nano7g
+# or several apps in one library with a menu:
+#   --sample=jshero:.pocket-build/generated/nano7g --sample=tilt:<dir> ...
+make -C programs/nano7g/nanoapps NANOAPPS_SDK=<NanoApps>/sdk \
+  POCKETNANO_LIB=$PWD/dist/nano7g/target/thumbv7a-none-eabi/release/libpocketjs_nano7g.a \
+  APP_NAME=pjhero POCKETNANO_TITLE='"JS Hero"' BUILD=$PWD/dist/nano7g/app
+```
+
+`build.ts` runs the [host preview](preview/src/main.rs) over a scripted touch
+session (PNG frames, a full-tree layout check on every frame, heap counts) and
+builds the [crate](src/lib.rs) for `thumbv7a-none-eabi`. The
+[NanoApps shim](nanoapps/pocketnano.c) links it into `pjhero.hbapp`.
+
+## Credits
+
+PocketJS (MIT). NanoApps SDK and resident by nfzerox (MIT). The iPod nano 7G
+untether and loader work by the wInd3x, ipod_sun and nano7-untethered projects.
diff --git a/programs/nano7g/build.rs b/programs/nano7g/build.rs
new file mode 100644
index 00000000..2d307617
--- /dev/null
+++ b/programs/nano7g/build.rs
@@ -0,0 +1,48 @@
+//! Places the profile `pocket build` exported for this NanoApp in OUT_DIR, and
+//! turns each generated MicroTS app named in `NANO7G_SAMPLES` into one module.
+//!
+//! `NANO7G_SAMPLES` is `key=directory;key=directory`, each directory the
+//! output of `pocket compile --aot`. A key is a module in `src/samples/`
+//! (jshero, gbahero, nanohero, hero, solidlab, vuelab, tilt). The generated
+//! `include.rs` expects to sit at the crate root; here its relative paths are
+//! made absolute so several apps live side by side in one library.
+use std::{env, fs, path::Path};
+
+const KEYS: &[&str] = &["jshero", "gbahero", "nanohero", "hero", "solidlab", "vuelab", "tilt"];
+
+fn main() {
+    pocket_profile_build::emit(pocket_profile_build::Export::Required);
+    println!("cargo:rerun-if-env-changed=NANO7G_SAMPLES");
+    for key in KEYS {
+        println!("cargo::rustc-check-cfg=cfg(sample_{key})");
+    }
+    let samples = env::var("NANO7G_SAMPLES").expect("NANO7G_SAMPLES=key=dir;... from tools/build/nano7g/build.ts");
+    let mut out = String::from("// Generated by programs/nano7g/build.rs from NANO7G_SAMPLES.\n");
+    let mut list = Vec::new();
+    for entry in samples.split(';').filter(|e| !e.is_empty()) {
+        let (key, dir) = entry.split_once('=').expect("key=dir");
+        assert!(KEYS.contains(&key), "unknown nano7g sample {key}");
+        let dir = fs::canonicalize(dir).expect("sample directory");
+        let dir = dir.to_str().unwrap();
+        let include = Path::new(dir).join("include.rs");
+        println!("cargo:rerun-if-changed={}", include.display());
+        let text = fs::read_to_string(&include).expect("include.rs");
+        let text = text
+            .replace("#[path = \"mod.rs\"]\nmod generated;", &format!("#[path = \"{dir}/mod.rs\"]\npub mod generated;"))
+            .replace("include_bytes!(\"", &format!("include_bytes!(\"{dir}/"))
+            .replace("\nfn load_", "\npub fn load_")
+            // Baked atlases are read in place from the image, not copied to
+            // the heap: on the 7G that is the difference between fitting
+            // one OS heap block or not.
+            .replace(".load_font_atlas(include_bytes!(", ".load_font_atlas_static(include_bytes!(");
+        assert!(text.contains("pub mod generated;"), "{key}: unexpected include.rs layout");
+        out.push_str(&format!(
+            "#[allow(dead_code, unused_imports, non_snake_case, non_camel_case_types, clippy::all)]\npub mod gen_{key} {{\n{text}\npub const STYLES: &[u8] = include_bytes!(\"{dir}/styles.bin\");\n}}\n"
+        ));
+        println!("cargo:rustc-cfg=sample_{key}");
+        list.push(format!("&crate::samples::{key}::SPEC"));
+    }
+    assert!(!list.is_empty(), "NANO7G_SAMPLES names no sample");
+    out.push_str(&format!("pub static SPECS: &[&crate::samples::Spec] = &[{}];\n", list.join(", ")));
+    fs::write(Path::new(&env::var("OUT_DIR").unwrap()).join("samples_gen.rs"), out).unwrap();
+}
diff --git a/programs/nano7g/nanoapps/Makefile b/programs/nano7g/nanoapps/Makefile
new file mode 100644
index 00000000..2689ab51
--- /dev/null
+++ b/programs/nano7g/nanoapps/Makefile
@@ -0,0 +1,99 @@
+# NanoApps RAW_SURFACE app around one PocketJS MicroTS app.
+#   make -C programs/nano7g/nanoapps NANOAPPS_SDK=<nano7kit>/nanoapps/sdk \
+#        POCKETNANO_LIB=<out>/target/thumbv7a-none-eabi/release/libpocketjs_nano7g.a \
+#        APP_NAME=pjhero POCKETNANO_TITLE='"JS Hero"' BUILD=<dir>
+# QuickJS builds (library built with --features quickjs) add
+#        QUICKJS=1 QUICKJS_DIR=<quickjs sources> DLMALLOC_C=<malloc-2.8.6.c>
+APP_NAME ?= pocketnano
+POCKETNANO_TITLE ?= "PocketJS"
+HERE := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+SRCS := $(HERE)/pocketnano.c
+RAW_SURFACE := 1
+EXTRA_CFLAGS += -DPOCKETNANO_TITLE='$(POCKETNANO_TITLE)'
+EXTRA_CFLAGS += -DPOCKETNANO_KEY='"$(APP_NAME)"'
+QUICKJS ?= 0
+ifeq ($(QUICKJS),1)
+EXTRA_CFLAGS += -DPOCKETNANO_QUICKJS
+endif
+ifndef NANOAPPS_SDK
+$(error set NANOAPPS_SDK to the NanoApps sdk directory)
+endif
+ifndef POCKETNANO_LIB
+$(error set POCKETNANO_LIB to libpocketjs_nano7g.a)
+endif
+include $(NANOAPPS_SDK)/hb_app.mk
+LDLIBS := $(POCKETNANO_LIB) $(LDLIBS)
+$(BUILD)/$(APP_NAME).reloc.elf: $(POCKETNANO_LIB)
+
+ifeq ($(QUICKJS),1)
+ifndef QUICKJS_DIR
+$(error set QUICKJS_DIR to the QuickJS sources (quickjs.c, with CONFIG_ATOMICS off for __POCKETNANO__))
+endif
+ifndef DLMALLOC_C
+$(error set DLMALLOC_C to dlmalloc 2.8.6 malloc-2.8.6.c)
+endif
+POCKETJS_ROOT := $(abspath $(HERE)/../../..)
+# QuickJS, the canonical guest and the libc glue use newlib's headers and,
+# from the Thumb soft-float multilib (ARMv4T: no movw/movt, no VFP), its
+# libc and libm. -mword-relocations keeps GCC to absolute words too.
+QJS_ARCH := -mcpu=cortex-a8 -mthumb -mfloat-abi=soft
+NEWLIB_FLAGS := -mthumb -mfloat-abi=soft
+QJS_CFLAGS := $(QJS_ARCH) -Os -mword-relocations -ffunction-sections -fdata-sections -fno-common \
+  -D__POCKETNANO__ -DCONFIG_VERSION='"pocketnano"' -D_GNU_SOURCE -DJS_NO_NAN_BOXING -DPOCKET_QJS_BELLARD \
+  -D__TM_GMTOFF=tm_gmtoff -include malloc.h -fno-strict-aliasing -funsigned-char \
+  -Wno-incompatible-pointer-types -Wno-implicit-function-declaration \
+  -I$(POCKETJS_ROOT)/contracts/generated -I$(POCKETJS_ROOT)/engine/guest-quickjs/include -isystem $(QUICKJS_DIR)
+QJS_SRCS := $(QUICKJS_DIR)/quickjs.c $(QUICKJS_DIR)/cutils.c $(QUICKJS_DIR)/libregexp.c \
+  $(QUICKJS_DIR)/libunicode.c $(QUICKJS_DIR)/dtoa.c
+QJS_OBJS := $(BUILD)/qjs/quickjs.o $(BUILD)/qjs/cutils.o $(BUILD)/qjs/libregexp.o $(BUILD)/qjs/libunicode.o \
+  $(BUILD)/qjs/dtoa.o $(BUILD)/qjs/guest.o $(BUILD)/qjs/pocketqjs.o $(BUILD)/qjs/nanofs.o $(BUILD)/qjs/jscan.o
+QJS_LIB := $(BUILD)/qjs/libpocketqjs.a
+$(BUILD)/qjs/%.o: $(QUICKJS_DIR)/%.c
+	@mkdir -p $(dir $@)
+	$(CC) $(QJS_CFLAGS) -c $< -o $@
+$(BUILD)/qjs/guest.o: $(POCKETJS_ROOT)/engine/guest-quickjs/src/guest.c
+	@mkdir -p $(dir $@)
+	$(CC) $(QJS_CFLAGS) -std=gnu11 -c $< -o $@
+$(BUILD)/qjs/pocketqjs.o: $(HERE)/pocketqjs.c $(DLMALLOC_C)
+	@mkdir -p $(dir $@)
+	$(CC) $(filter-out -include malloc.h,$(QJS_CFLAGS)) -I$(POCKETJS_ROOT)/engine/host-services -DDLMALLOC_C='"$(DLMALLOC_C)"' -c $< -o $@
+# data.fs: the canonical host fs module over the SDK's whole-file calls.
+HOST_SERVICES := $(POCKETJS_ROOT)/engine/host-services
+$(BUILD)/qjs/nanofs.o: $(HERE)/nanofs.c $(HOST_SERVICES)/fs.c $(HOST_SERVICES)/fs.h
+	@mkdir -p $(dir $@)
+	$(CC) $(filter-out -include malloc.h,$(QJS_CFLAGS)) -std=gnu11 -I$(HOST_SERVICES) -I$(HERE)/nanofs-include \
+	  -DFS_C='"$(HOST_SERVICES)/fs.c"' -c $< -o $@
+$(BUILD)/qjs/jscan.o: $(HERE)/nanojscan.c $(HOST_SERVICES)/jscan.c
+	@mkdir -p $(dir $@)
+	$(CC) $(filter-out -include malloc.h,$(QJS_CFLAGS)) -std=gnu11 -I$(HOST_SERVICES) -DJSCAN_C='"$(HOST_SERVICES)/jscan.c"' -c $< -o $@
+$(QJS_LIB): $(QJS_OBJS)
+	rm -f $@
+	$(AR) rcsD $@ $^
+LDLIBS := $(POCKETNANO_LIB) $(QJS_LIB) \
+  $(shell $(CC) $(NEWLIB_FLAGS) -print-file-name=libm.a) \
+  $(shell $(CC) $(NEWLIB_FLAGS) -print-file-name=libc_nano.a) \
+  $(QJS_LIB) $(LIBGCC) \
+  $(shell $(CC) $(NEWLIB_FLAGS) -print-file-name=libgcc.a)
+$(BUILD)/$(APP_NAME).reloc.elf: $(QJS_LIB)
+endif
+
+# libgcc's hand-written soft-float routines (ARM's ieee754-sf.S / -df.S,
+# Thumb-2, no FP instructions) linked as objects: their strong symbols
+# take over from compiler_builtins' weak generic Rust ones, which the
+# library would otherwise bring first. Same IEEE results, far fewer
+# instructions per add, multiply and compare (the draw walk and QuickJS's
+# numbers are mostly that).
+# The comparisons come from fastcmp.c instead: integer compares of the bit
+# patterns, without libgcc's three-way compare and flag round trip.
+FASTFP_MEMBERS := _arm_addsubsf3.o _arm_muldivsf3.o _arm_fixsfsi.o _arm_fixunssfsi.o \
+  _arm_addsubdf3.o _arm_muldivdf3.o _arm_fixdfsi.o _arm_fixunsdfsi.o _arm_truncdfsf2.o
+FASTFP_LIBGCC := $(addprefix $(BUILD)/fastfp/,$(FASTFP_MEMBERS))
+FASTFP_OBJS := $(FASTFP_LIBGCC) $(BUILD)/fastfp/fastcmp.o
+$(FASTFP_LIBGCC) &:
+	@mkdir -p $(BUILD)/fastfp
+	cd $(BUILD)/fastfp && $(AR) x $(LIBGCC) $(FASTFP_MEMBERS)
+$(BUILD)/fastfp/fastcmp.o: $(HERE)/fastcmp.c
+	@mkdir -p $(BUILD)/fastfp
+	$(CC) -mcpu=cortex-a8 -mthumb -mfloat-abi=soft -O2 -mword-relocations -ffreestanding -c $< -o $@
+LDLIBS := $(FASTFP_OBJS) $(LDLIBS)
+$(BUILD)/$(APP_NAME).reloc.elf: $(FASTFP_OBJS)
diff --git a/programs/nano7g/nanoapps/fastcmp.c b/programs/nano7g/nanoapps/fastcmp.c
new file mode 100644
index 00000000..17d3ef22
--- /dev/null
+++ b/programs/nano7g/nanoapps/fastcmp.c
@@ -0,0 +1,57 @@
+/* Soft-float comparisons for the ARM EABI (__aeabi_fcmp*, __aeabi_dcmp*)
+ * on integer compares of the IEEE bit patterns. The generic routines go
+ * through a three-way compare plus flag shuffling on every call, and the
+ * draw walk compares floats tens of thousands of times a frame. Results
+ * match IEEE 754: any NaN compares unordered (false, except fcmpun), and
+ * +0 equals -0. No FP instructions. */
+#include <stdint.h>
+
+static inline uint32_t f_bits(float x) { uint32_t u; __builtin_memcpy(&u, &x, 4); return u; }
+static inline uint64_t d_bits(double x) { uint64_t u; __builtin_memcpy(&u, &x, 8); return u; }
+
+/* Sign-magnitude to an order-preserving two's-complement key; -0 and +0
+ * both map to 0. */
+static inline int32_t f_key(uint32_t u) { return (int32_t)u < 0 ? (int32_t)(0x80000000u - u) : (int32_t)u; }
+static inline int64_t d_key(uint64_t u) {
+  return (int64_t)u < 0 ? (int64_t)(0x8000000000000000ull - u) : (int64_t)u;
+}
+static inline int f_nan(uint32_t u) { return (u & 0x7fffffffu) > 0x7f800000u; }
+static inline int d_nan(uint64_t u) { return (u & 0x7fffffffffffffffull) > 0x7ff0000000000000ull; }
+
+int __aeabi_fcmpun(float a, float b) { return f_nan(f_bits(a)) | f_nan(f_bits(b)); }
+int __aeabi_fcmpeq(float a, float b) {
+  uint32_t x = f_bits(a), y = f_bits(b);
+  if (f_nan(x) | f_nan(y)) return 0;
+  return x == y || ((x | y) & 0x7fffffffu) == 0;
+}
+int __aeabi_fcmplt(float a, float b) {
+  uint32_t x = f_bits(a), y = f_bits(b);
+  if (f_nan(x) | f_nan(y)) return 0;
+  return f_key(x) < f_key(y);
+}
+int __aeabi_fcmple(float a, float b) {
+  uint32_t x = f_bits(a), y = f_bits(b);
+  if (f_nan(x) | f_nan(y)) return 0;
+  return f_key(x) <= f_key(y);
+}
+int __aeabi_fcmpgt(float a, float b) { return __aeabi_fcmplt(b, a); }
+int __aeabi_fcmpge(float a, float b) { return __aeabi_fcmple(b, a); }
+
+int __aeabi_dcmpun(double a, double b) { return d_nan(d_bits(a)) | d_nan(d_bits(b)); }
+int __aeabi_dcmpeq(double a, double b) {
+  uint64_t x = d_bits(a), y = d_bits(b);
+  if (d_nan(x) | d_nan(y)) return 0;
+  return x == y || ((x | y) & 0x7fffffffffffffffull) == 0;
+}
+int __aeabi_dcmplt(double a, double b) {
+  uint64_t x = d_bits(a), y = d_bits(b);
+  if (d_nan(x) | d_nan(y)) return 0;
+  return d_key(x) < d_key(y);
+}
+int __aeabi_dcmple(double a, double b) {
+  uint64_t x = d_bits(a), y = d_bits(b);
+  if (d_nan(x) | d_nan(y)) return 0;
+  return d_key(x) <= d_key(y);
+}
+int __aeabi_dcmpgt(double a, double b) { return __aeabi_dcmplt(b, a); }
+int __aeabi_dcmpge(double a, double b) { return __aeabi_dcmple(b, a); }
diff --git a/programs/nano7g/nanoapps/fastcmp_test.c b/programs/nano7g/nanoapps/fastcmp_test.c
new file mode 100644
index 00000000..7c0946d2
--- /dev/null
+++ b/programs/nano7g/nanoapps/fastcmp_test.c
@@ -0,0 +1,37 @@
+/* Host check of fastcmp.c against the host FPU:
+ *   cc -O2 fastcmp_test.c -o /tmp/fastcmp_test -lm && /tmp/fastcmp_test */
+#define __aeabi_fcmpun my_fcmpun
+#define __aeabi_fcmpeq my_fcmpeq
+#define __aeabi_fcmplt my_fcmplt
+#define __aeabi_fcmple my_fcmple
+#define __aeabi_fcmpgt my_fcmpgt
+#define __aeabi_fcmpge my_fcmpge
+#define __aeabi_dcmpun my_dcmpun
+#define __aeabi_dcmpeq my_dcmpeq
+#define __aeabi_dcmplt my_dcmplt
+#define __aeabi_dcmple my_dcmple
+#define __aeabi_dcmpgt my_dcmpgt
+#define __aeabi_dcmpge my_dcmpge
+#include <stdint.h>
+#include <string.h>
+#include "fastcmp.c"
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+static uint64_t s=88172645463325252ull; static uint64_t rnd(){s^=s<<13;s^=s>>7;s^=s<<17;return s;}
+int main(){
+  float fs[]={0.f,-0.f,1.f,-1.f,INFINITY,-INFINITY,NAN,-NAN,1e-45f,-1e-45f,3.4e38f,-3.4e38f,0.5f,2.f};
+  double ds[]={0.,-0.,1.,-1.,INFINITY,-INFINITY,NAN,-NAN,5e-324,-5e-324,1.7e308,-1.7e308,0.5,2.};
+  long bad=0,n=0;
+  for(long i=0;i<20000000;i++){
+    float a,b; double c,d; uint32_t u=rnd(),v=rnd(); uint64_t w=rnd(),x=rnd();
+    if(i<196){a=fs[i%14];b=fs[i/14];c=ds[i%14];d=ds[i/14];}
+    else { if(i&1){v=u+(int)(rnd()%5)-2;x=w+(int)(rnd()%5)-2;} memcpy(&a,&u,4);memcpy(&b,&v,4);memcpy(&c,&w,8);memcpy(&d,&x,8);}
+    n++;
+    bad+= my_fcmpun(a,b)!=(isnan(a)||isnan(b)); bad+=my_fcmpeq(a,b)!=(a==b); bad+=my_fcmplt(a,b)!=(a<b);
+    bad+=my_fcmple(a,b)!=(a<=b); bad+=my_fcmpgt(a,b)!=(a>b); bad+=my_fcmpge(a,b)!=(a>=b);
+    bad+= my_dcmpun(c,d)!=(isnan(c)||isnan(d)); bad+=my_dcmpeq(c,d)!=(c==d); bad+=my_dcmplt(c,d)!=(c<d);
+    bad+=my_dcmple(c,d)!=(c<=d); bad+=my_dcmpgt(c,d)!=(c>d); bad+=my_dcmpge(c,d)!=(c>=d);
+  }
+  printf("cases %ld mismatches %ld\n",n,bad); return bad!=0;
+}
diff --git a/programs/nano7g/nanoapps/nanofs-include/dirent.h b/programs/nano7g/nanoapps/nanofs-include/dirent.h
new file mode 100644
index 00000000..b0c34f6e
--- /dev/null
+++ b/programs/nano7g/nanoapps/nanofs-include/dirent.h
@@ -0,0 +1,8 @@
