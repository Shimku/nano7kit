+/* Called by the Rust panic handler. Never returns into Rust. */
+__attribute__((noreturn, noinline))
+void pocketnano_fail(uint32_t code, uint32_t line)
+{
+    s_fail_code = code;
+    s_fail_line = line;
+    __builtin_longjmp(s_jump, 1);
+}
+
+/* A failure with a message (a JavaScript error, a missing package). */
+__attribute__((noreturn, noinline))
+void pocketnano_fail_text(uint32_t code, const char *t, uint32_t n)
+{
+    uint32_t i;
+    if (n > sizeof s_fail_text - 1)
+        n = sizeof s_fail_text - 1;
+    for (i = 0; i < n; i++) {
+        char c = t[i];
+        if (c >= 'a' && c <= 'z') c = (char)(c - 32);
+        s_fail_text[i] = (c < 32 || c > 126) ? ' ' : c;
+    }
+    s_fail_text[n] = 0;
+    pocketnano_fail(code, 0);
+}
+
+/* pocketjs15: a Rust panic with its message and file (OUT OF MEMORY: 1024
+ * BYTES MORE (alloc.rs:573)), keeping the line for PJFAIL. */
+__attribute__((noreturn, noinline))
+void pocketnano_fail_msg(uint32_t code, uint32_t line, const char *t, uint32_t n)
+{
+    uint32_t i;
+    if (n > sizeof s_fail_text - 1)
+        n = sizeof s_fail_text - 1;
+    for (i = 0; i < n; i++) {
+        char c = t[i];
+        if (c >= 'a' && c <= 'z') c = (char)(c - 32);
+        s_fail_text[i] = (c < 32 || c > 126) ? ' ' : c;
+    }
+    s_fail_text[n] = 0;
+    pocketnano_fail(code, line);
+}
+
+static uint32_t s_fail_at;
+static int s_fail_armed;
+/* pocketjs15: Home failed while booting; retried from hb_raw_frame (off the
+ * private stack, which lives in the block that the retry frees). */
+static int s_retry_home, s_home_retries;
+
+static void show_failure(void)
+{
+    char a[40], b[40], *o;
+    pocketnano_log("PJFAIL", s_fail_code, s_fail_line);
+    pocketnano_log("PJFAILM", pocketnano_heap_peak(), s_heap_len);
+    if (s_fail_text[0]) {
+        /* The message itself, as a comment line ./start pocketjs log prints
+         * (pocketjs15: after the app's name). */
+        char line[sizeof s_fail_text + 64], *o = put_s(line, "# fail: ");
+        o = put_s(o, pocketnano_title(s_index));
+        o = put_s(o, ": ");
+        o = put_s(o, s_fail_text);
+        *o++ = '\n';
+        log_append(line, (uint32_t)(o - line));
+    }
+    s_fail_at = hb_time_uptime_us();
+    s_fail_armed = 0;
+    s_wait_release = 0;
+    if (s_fail_code == 1) {
+        o = put_s(a, "PANIC AT LINE ");
+        put_u(o, s_fail_line);
+    } else {
+        o = put_s(a, "ERROR ");
+        put_u(o, s_fail_code);
+    }
+    o = put_s(b, "HEAP PEAK ");
+    o = put_u(o, pocketnano_heap_peak() / 1024u);
+    o = put_s(o, "K OF ");
+    o = put_u(o, s_heap_len / 1024u);
+    put_s(o, "K");
+    {
+        /* pocketjs15: which app stopped, in its own words (MOTION LAB STOPPED). */
+        char title[40], *t = title;
+        const char *name = pocketnano_title(s_index);
+        uint32_t k;
+        for (k = 0; name && name[k] && k < 26; k++) {
+            char c = name[k];
+            *t++ = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c;
+        }
+        put_s(t, " STOPPED");
+        screen(title, a, b, 0x7f1d1d);
+    }
+    if (s_home >= 0 && (int)s_index != s_home)
+        text(12, PN_H - 40, "LIFT, THEN TAP FOR HOME", 1, 0xffffff);
+    else if (s_home >= 0)
+        text(12, PN_H - 40, "LIFT, THEN TAP TO RETRY", 1, 0xffffff);
+    log_flush();
+    if (s_fail_text[0]) {
+        /* 28 columns a line, up to 18 lines (the message, then where it was thrown). */
+        char line[29];
+        uint32_t at = 0, row, k;
+        for (row = 0; row < 18 && s_fail_text[at]; row++) {
+            for (k = 0; k < 28 && s_fail_text[at]; k++) line[k] = s_fail_text[at++];
+            line[k] = 0;
+            text(12, 120 + (int)row * 14, line, 1, 0xfecaca);
+        }
+    }
+}
