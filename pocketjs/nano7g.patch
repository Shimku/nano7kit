diff --git a/programs/nano7g/nanoapps/nanofs.c b/programs/nano7g/nanoapps/nanofs.c
new file mode 100644
index 00000000..fdc4857f
--- /dev/null
+++ b/programs/nano7g/nanoapps/nanofs.c
@@ -0,0 +1,439 @@
+/*
+ * data.fs on the iPod nano 7G: the canonical host fs module
+ * (engine/host-services/fs.c, contracts/spec/fs.ts) over the NanoApps SDK's
+ * file calls, which PvZ saves and the package reads use on hardware.
+ *
+ * fs.c is written against stdio, dirent and stat. The SDK has none of them
+ * on a file object level: hb_fs_write creates or truncates a file and writes
+ * it whole (then flushes), hb_fs_read reads from the start, and there is no
+ * rename. So this file maps fs.c's calls onto whole-file operations:
+ *
+ *   fopen "rb"   reads the whole file into the app heap (plus the SDK's
+ *                sector slack), fread and fseek work on that copy;
+ *   fopen "wb"   collects the bytes, fclose writes them with hb_fs_write;
+ *   fopen "ab"   starts from the file's current bytes;
+ *   rename       copies (read whole, write whole, remove the source); a
+ *                destination that exists fails like FAT, so fs.c takes its
+ *                sidecar path. When the source is fs.c's staged write, the
+ *                sidecar is written first in every case, so a power loss in
+ *                the middle of the copy is finished at the next fs_bind:
+ *                the app reads the old content or the new, never a torn file;
+ *   opendir      lists a directory's names up front (no OS iterator stays
+ *                open across fs.c's nested walks).
+ *
+ * Every file is held whole while it is read or written, so the per-app quota
+ * (PQFS_QUOTA) also bounds the memory a call can take.
+ */
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include "nanofs-include/dirent.h"
+
+typedef struct { uint8_t opaque[0x50]; } nfs_dir_t;
+bool hb_fs_exists(const char *path);
+bool hb_fs_write(const char *path, const void *data, uint32_t size);
+uint32_t hb_fs_read(const char *path, void *buf, uint32_t max_size);
+bool hb_fs_dir_open(nfs_dir_t *iter, const char *path, bool recursive);
+bool hb_fs_dir_next(nfs_dir_t *iter, char *out_name, int out_size, bool *out_is_dir);
+void hb_fs_dir_close(nfs_dir_t *iter);
+bool hb_fs_remove(const char *path);
+bool hb_fs_mkdir(const char *path);
+uint32_t hb_fs_size(const char *path);
+bool hb_fs_is_dir(const char *path);
+bool hb_fs_rmdir(const char *path);
+/* pocketnano.c: the trace ring and the log file. */
+void pocketnano_log(const char *tag, uint32_t v1, uint32_t v2);
+#define hb_trace_log pocketnano_log
+
+/* The SDK's read may fill whole sectors past the end of the file. */
+#define NFS_SLACK 8192u
+/* Largest file the shim holds (the quota bounds what an app can write). */
+#define NFS_MAX_FILE (1u << 20)
+#define NFS_MAX_NAMES 512
+#define NFS_NAME 128
+
+int nfs_dir_depth;
+
+/* ---- whole-file helpers ---- */
+
+static int nfs_kind(const char *path, uint32_t *size)
+{
+    if (hb_fs_is_dir(path))
+        return 2;
+    if (!hb_fs_exists(path))
+        return 0;
+    if (size)
+        *size = hb_fs_size(path);
+    return 1;
+}
+
+/* The file's bytes in a malloc'd buffer (NULL on failure; *len 0 for an
+ * empty file, with a non-NULL buffer). */
+static uint8_t *nfs_load(const char *path, size_t *len)
+{
+    uint32_t size = 0;
+    if (nfs_kind(path, &size) != 1 || size > NFS_MAX_FILE)
+        return NULL;
+    uint8_t *buf = malloc(size + NFS_SLACK);
+    if (!buf)
+        return NULL;
+    uint32_t got = size ? hb_fs_read(path, buf, size + NFS_SLACK) : 0;
+    if (got < size) {
+        free(buf);
+        return NULL;
+    }
+    *len = size;
+    return buf;
+}
+
+static bool nfs_store(const char *path, const uint8_t *data, size_t len)
+{
+    if (!hb_fs_write(path, len ? data : (const uint8_t *)"", (uint32_t)len))
+        return false;
+    /* Read the size back: a full volume or a refused path shows up here. */
+    return hb_fs_exists(path) && hb_fs_size(path) == len;
+}
+
+/* ---- stdio ---- */
+
+typedef struct {
+    char path[400];
+    uint8_t *data;
+    size_t len, pos;
+    int write;
+} NFILE;
+
+static NFILE *nfs_fopen(const char *path, const char *mode)
+{
+    NFILE *f = calloc(1, sizeof *f);
+    if (!f)
+        return NULL;
+    snprintf(f->path, sizeof f->path, "%s", path);
+    if (mode[0] == 'r') {
+        f->data = nfs_load(path, &f->len);
+        if (!f->data) {
+            free(f);
+            errno = ENOENT;
+            return NULL;
+        }
+    } else if (mode[0] == 'a') {
+        f->write = 1;
+        if (nfs_kind(path, NULL) == 1) {
+            f->data = nfs_load(path, &f->len);
+            if (!f->data) {
+                free(f);
+                errno = EIO;
+                return NULL;
+            }
+        }
+        f->pos = f->len;
+    } else {
+        f->write = 1;
+    }
+    return f;
+}
+
+static size_t nfs_fread(void *out, size_t size, size_t count, NFILE *f)
+{
+    size_t want = size * count;
+    if (f->pos >= f->len || size == 0)
+        return 0;
+    if (want > f->len - f->pos)
+        want = f->len - f->pos;
+    memcpy(out, f->data + f->pos, want);
+    f->pos += want;
+    return want / size;
+}
+
+static size_t nfs_fwrite(const void *in, size_t size, size_t count, NFILE *f)
+{
+    size_t n = size * count;
+    if (!f->write || n == 0)
+        return 0;
+    if (f->len + n > NFS_MAX_FILE)
+        return 0;
+    uint8_t *grown = realloc(f->data, f->len + n);
+    if (!grown)
+        return 0;
+    f->data = grown;
+    memcpy(f->data + f->len, in, n);
+    f->len += n;
+    return count;
+}
+
+static int nfs_fseek(NFILE *f, long offset, int whence)
+{
+    if (whence != SEEK_SET || offset < 0 || (size_t)offset > f->len)
+        return -1;
+    f->pos = (size_t)offset;
+    return 0;
+}
+
+static int nfs_fclose(NFILE *f)
+{
+    int rc = 0;
+    if (f->write && !nfs_store(f->path, f->data, f->len))
+        rc = EOF;
+    free(f->data);
+    free(f);
+    return rc;
+}
+
+/* ---- stat, mkdir, remove ---- */
+
+static int nfs_stat(const char *path, struct stat *st)
+{
+    uint32_t size = 0;
+    int kind = nfs_kind(path, &size);
+    memset(st, 0, sizeof *st);
+    if (kind == 0) {
+        errno = ENOENT;
+        return -1;
+    }
+    st->st_mode = kind == 2 ? S_IFDIR : S_IFREG;
+    st->st_size = size;
+    return 0;
+}
+
+static int nfs_mkdir(const char *path, int mode)
+{
+    (void)mode;
+    if (hb_fs_is_dir(path)) {
+        errno = EEXIST;
+        return -1;
+    }
+    if (hb_fs_exists(path)) {
+        errno = EEXIST;
+        return -1;
+    }
+    if (!hb_fs_mkdir(path) || !hb_fs_is_dir(path)) {
+        errno = EIO;
+        return -1;
+    }
+    return 0;
+}
+
+static int nfs_remove(const char *path)
+{
+    int kind = nfs_kind(path, NULL);
+    if (kind == 0) {
+        errno = ENOENT;
+        return -1;
+    }
+    bool ok = kind == 2 ? hb_fs_rmdir(path) : hb_fs_remove(path);
+    if (!ok || nfs_kind(path, NULL) != 0) {
+        errno = EIO;
+        return -1;
+    }
+    return 0;
+}
+
+static int nfs_rmdir(const char *path)
+{
+    if (!hb_fs_is_dir(path)) {
+        errno = ENOENT;
+        return -1;
+    }
+    return nfs_remove(path);
+}
+
+/* ---- directories ---- */
+
+typedef struct {
+    char (*names)[NFS_NAME];
+    int count, at;
+    struct dirent entry;
+} NDIR;
+
+static NDIR *nfs_opendir(const char *path)
+{
+    if (!hb_fs_is_dir(path)) {
+        errno = ENOENT;
+        return NULL;
+    }
+    NDIR *d = calloc(1, sizeof *d);
+    if (!d)
+        return NULL;
+    nfs_dir_t it;
+    char name[NFS_NAME];
+    bool is_dir = false;
+    int cap = 0;
+    if (!hb_fs_dir_open(&it, path, false)) {
+        free(d);
+        return NULL;
+    }
+    while (hb_fs_dir_next(&it, name, sizeof name, &is_dir)) {
+        /* A name may come back as a path below `path`: keep its last part. */
+        const char *base = strrchr(name, '/');
+        base = base ? base + 1 : name;
+        if (!base[0] || !strcmp(base, ".") || !strcmp(base, ".."))
+            continue;
+        if (d->count == cap) {
+            int next = cap ? cap * 2 : 16;
+            if (next > NFS_MAX_NAMES)
+                break;
+            void *grown = realloc(d->names, (size_t)next * NFS_NAME);
+            if (!grown)
+                break;
+            d->names = grown;
+            cap = next;
+        }
+        snprintf(d->names[d->count++], NFS_NAME, "%s", base);
+    }
+    hb_fs_dir_close(&it);
+    return d;
+}
+
+static struct dirent *nfs_readdir(NDIR *d)
+{
+    if (d->at >= d->count)
+        return NULL;
+    snprintf(d->entry.d_name, sizeof d->entry.d_name, "%s", d->names[d->at++]);
+    return &d->entry;
+}
+
+static int nfs_closedir(NDIR *d)
+{
+    free(d->names);
+    free(d);
+    return 0;
+}
+
+static int nfs_rename(const char *from, const char *to);
+
+/* ---- fs.c over the shim ---- */
+
+#define FILE NFILE
+#define fopen nfs_fopen
+#define fread nfs_fread
+#define fwrite nfs_fwrite
+#define fseek nfs_fseek
+#define fclose nfs_fclose
+#define stat(p, s) nfs_stat(p, s)
+#define mkdir nfs_mkdir
+#define remove nfs_remove
+#define rmdir nfs_rmdir
+#define rename nfs_rename
+#define DIR NDIR
+#define opendir nfs_opendir
+#define readdir nfs_readdir
+#define closedir nfs_closedir
+#include FS_C
+#undef stat
+
+/* ---- rename (copy), after fs.c for its staged and sidecar paths ---- */
+
+static int nfs_copy_file(const char *from, const char *to)
+{
+    size_t len = 0;
+    uint8_t *data = nfs_load(from, &len);
+    if (!data)
+        return -1;
+    bool ok = nfs_store(to, data, len);
+    free(data);
+    if (!ok)
+        return -1;
+    return hb_fs_remove(from) ? 0 : -1;
+}
+
+static int nfs_move_tree(const char *from, const char *to, int depth)
+{
+    if (depth > 8 || !hb_fs_mkdir(to))
+        return -1;
+    NDIR *d = nfs_opendir(from);
+    if (!d)
+        return -1;
+    int rc = 0;
+    for (int i = 0; i < d->count && rc == 0; i++) {
+        char a[400], b[400];
+        snprintf(a, sizeof a, "%s/%s", from, d->names[i]);
+        snprintf(b, sizeof b, "%s/%s", to, d->names[i]);
+        rc = hb_fs_is_dir(a) ? nfs_move_tree(a, b, depth + 1) : nfs_copy_file(a, b);
+    }
+    nfs_closedir(d);
+    if (rc == 0 && !hb_fs_rmdir(from))
+        rc = -1;
+    return rc;
+}
+
+static int nfs_rename(const char *from, const char *to)
+{
+    int kind = nfs_kind(from, NULL);
+    if (kind == 0) {
+        errno = ENOENT;
+        return -1;
+    }
+    if (nfs_kind(to, NULL) != 0) {
+        errno = EEXIST; /* FAT: no rename onto a name that exists */
+        return -1;
+    }
+    if (kind == 2)
+        return nfs_move_tree(from, to, 0);
+    bool staged = !strcmp(from, staged_path);
+    if (staged && !hb_fs_exists(sidecar_path) && !nfs_store(sidecar_path, (const uint8_t *)to, strlen(to)))
+        return -1;
+#ifdef FS_TEST_HOOKS
+    /* tests/fs-nano7g.test.ts: power lost after the sidecar, before the copy. */
+    if (staged && fs_test_crash_after_unlink == 2)
+        return -1;
+#endif
+    int rc = nfs_copy_file(from, to);
+    if (rc == 0 && staged)
+        hb_fs_remove(sidecar_path);
+    return rc;
+}
+
+/* ---- the nano's binding: one app's tree, the log ---- */
+
+/* An app's state starts fresh: the last app's buffers went with its block. */
+void nanofs_reset(void)
+{
+    bound = false;
+    used_known = false;
+    memset(&line, 0, sizeof line);
+    last_error[0] = 0;
+}
+
+bool nanofs_bind(const char *root, const char *temp, uint64_t quota)
+{
+    nanofs_reset();
+    bool ok = fs_bind(root, temp, quota);
+    hb_trace_log("PJFSB", ok ? 1 : 0, (uint32_t)quota);
+    return ok;
+}
+
+/* The error detail as a small number for the log (0: none). */
+static uint32_t nanofs_error_code(void)
+{
+    static const char *const known[] = {
+        "invalid path", "not found", "quota exceeded", "write failed", "is a directory",
+        "not a directory", "directory not empty", "remove failed", "rename failed",
+        "destination exists", "out of memory", "malformed payload", "write exceeds",
+        "mkdir failed", "read failed", "fs is not mounted",
+    };
+    if (!last_error[0])
+        return 0;
+    for (uint32_t i = 0; i < sizeof known / sizeof known[0]; i++)
+        if (!strncmp(last_error, known[i], strlen(known[i])))
+            return i + 1;
+    return 99;
+}
+
+/* One log line per write, remove, rename or mkdir: op in the top byte,
+ * bytes below, the time it took in ms; PJFSERR carries the error code. The
+ * log file is written soon after, so a crash later still shows the save. */
+void pocketnano_log_soon(void);
+void nanofs_log(uint32_t op, uint32_t bytes, int failed, uint32_t us)
+{
+    uint32_t v1 = op << 24 | (bytes & 0xffffff);
+    if (failed)
+        hb_trace_log("PJFSERR", v1, nanofs_error_code());
+    else
+        hb_trace_log("PJFS", v1, us / 1000u);
+    pocketnano_log_soon();
+}
diff --git a/programs/nano7g/nanoapps/nanojscan.c b/programs/nano7g/nanoapps/nanojscan.c
new file mode 100644
index 00000000..7a78c1df
--- /dev/null
+++ b/programs/nano7g/nanoapps/nanojscan.c
@@ -0,0 +1,49 @@
+/* jscan.c for the nano: newlib-nano's printf has no 64-bit conversions, so
+ * jscan's two number writers ("%llu" and "%lld", sizes and offsets in the
+ * data.fs replies) get a small formatter; every other format goes to
+ * vsnprintf unchanged. Included like nanofs.c includes fs.c. */
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int nj_decimal(char *out, size_t size, unsigned long long value, bool negative)
+{
+    char digits[24];
+    int n = 0, len;
+    do {
+        digits[n++] = (char)('0' + value % 10u);
+        value /= 10u;
+    } while (value);
+    if (negative)
+        digits[n++] = '-';
+    len = n;
+    for (size_t i = 0; size && i + 1 < size && n; i++)
+        out[i] = digits[--n], out[i + 1] = 0;
+    if (size && len >= (int)size)
+        out[size - 1] = 0;
+    return len;
+}
+
+static int nj_snprintf(char *out, size_t size, const char *format, ...)
+{
+    va_list ap;
+    int r;
+    va_start(ap, format);
+    if (!strcmp(format, "%llu")) {
+        r = nj_decimal(out, size, va_arg(ap, unsigned long long), false);
+    } else if (!strcmp(format, "%lld")) {
+        long long v = va_arg(ap, long long);
+        r = nj_decimal(out, size, v < 0 ? 0ull - (unsigned long long)v : (unsigned long long)v, v < 0);
+    } else {
+        r = vsnprintf(out, size, format, ap);
+    }
+    va_end(ap);
+    return r;
+}
+
+#define snprintf nj_snprintf
+#include JSCAN_C
diff --git a/programs/nano7g/nanoapps/pocketnano.c b/programs/nano7g/nanoapps/pocketnano.c
new file mode 100644
index 00000000..659a00fd
--- /dev/null
+++ b/programs/nano7g/nanoapps/pocketnano.c
@@ -0,0 +1,1695 @@
+/*
+ * pocketnano.c - NanoApps RAW_SURFACE host for PocketJS MicroTS apps on the
+ * iPod nano 7th generation (240 x 432 touch panel).
+ *
+ * The NanoApps runtime hands us the OS-composited XRGB8888 framebuffer and a
+ * ~60 Hz heartbeat with the current touch point. The Rust library
+ * (libpocketjs_nano7g.a, programs/nano7g) renders the app into that
+ * framebuffer. This file owns memory, the clock and the menu:
+ *
+ *   - one OS heap block for the whole Rust heap, registered as the app's aux
+ *     block so the resident frees it when the app unloads (Home, app switch),
+ *     even though raw surface apps get no quit callback;
+ *   - one Runtime tick per 1/30 s of wall time (the profile cadence), at
+ *     most one per heartbeat; a tap shorter than a tick is still delivered;
+ *   - one guarded tick at a time: a Rust panic long-jumps back here, the
+ *     app shows why and stops ticking (Home still exits);
+ *   - boot (Runtime::new, mount) needs ~19 KB of stack and the first layout
+ *     of a big sample ~13 KB, more than the OS task stack is known to give
+ *     (PvZ ran ~11 KB deep), so the Rust core (boot and every frame) runs on
+ *     a private 48 KB stack carved from the top of the heap block.
+ *     Apps/Data/PocketJS/no_private_stack.txt on the iPod turns this off
+ *     (everything then runs on the OS stack);
+ *   - a library holding several apps opens with a menu; the app's menu key
+ *     stops it (everything it allocated is dropped) and returns here;
+ *   - volume buttons as Up/Down (direct GPIO reads, no PMU traffic), and the
+ *     accelerometer sample for apps that use motion.
+ *
+ * QuickJS builds (make QUICKJS=1) add JavaScript apps: their package is a
+ * read-only file in /Apps/Data/PocketJS, read whole into the app's block
+ * (pocketqjs.c lays malloc over the block), and the private stack is
+ * bigger because the QuickJS parser and interpreter recurse on it.
+ *
+ * No audio, no network. Files: data.fs for apps that ask (pocketjs11) and
+ * this shim's log, /Apps/Data/PocketJS/logs/<key>.txt (pocketjs12). Every
+ * breadcrumb goes to that file and to the resident trace ring, which the
+ * resident saves as /Apps/Startup/lasttrace.bin on the next normal reboot
+ * (./start apps lasttrace, ./start pocketjs log reads both): every 10 s of a
+ * running app PJFPS (ticks per second x10, slowest tick in us) and, for
+ * motion apps, PJACCXY / PJACCZ (the raw accelerometer sample); PJEND
+ * (ticks, ms) when the app returns to the menu.
+ */
+#include "hb_raw_surface.h"
+#include "hb_sdk.h"
+#include "hb_heap.h"
+#include "hb_shared.h"
+
+#ifndef POCKETNANO_TITLE
+#define POCKETNANO_TITLE "PocketJS"
+#endif
+/* What the OS keeps after the app's block is taken. Probe on a full Home
+ * reads about 7.0 MB free with a 4.0 MB largest block, and the resident has
+ * already placed the app image (1 to 2.2 MB) by the time the app starts. */
+#ifndef POCKETNANO_OS_KEEP_LARGEST
+#define POCKETNANO_OS_KEEP_LARGEST (1024u << 10)
+#endif
+#ifndef POCKETNANO_OS_KEEP_FREE
+#define POCKETNANO_OS_KEEP_FREE (2048u << 10)
+#endif
+/* Private stack for the Rust core (boot and every frame), carved from the
+ * top of the heap block. The first full layout of a big sample goes past
+ * 13 KB, more than the about 12 KB the OS gives an app task. */
+#ifndef POCKETNANO_BOOT_STACK
+#ifdef POCKETNANO_QUICKJS
+#define POCKETNANO_BOOT_STACK (160u << 10)
+#else
+#define POCKETNANO_BOOT_STACK (48u << 10)
+#endif
+#endif
+#define PN_STACK_FILL 0x5354414bu   /* 'STAK' */
+/* Present on the volume: run on the OS stack instead (A/B test on hardware). */
+#define PN_NO_STACK_FLAG "/Apps/Data/PocketJS/no_private_stack.txt"
+/* One Runtime tick per profile cadence (30 Hz). */
+#define PN_PERIOD_US 33333u
+#define PN_EARLY_US 3000u
+
+#define PN_W 240
+#define PN_H 432
+#define PN_MAX_REGIONS 8
+#define PN_MENU_TOP 72
+#define PN_MENU_ROW 46
+#define PN_MENU_END 432
+
+
+/* PocketJS button bits (pocket-spec btn). */
+#define PN_BTN_UP   0x0010u
+#define PN_BTN_DOWN 0x0040u
+
+extern uint32_t pocketnano_count(void);
+extern const char *pocketnano_title(uint32_t index);
+extern uint32_t pocketnano_heap_need(uint32_t index);
+extern uint32_t pocketnano_stack_extra(uint32_t index);
+extern const char *pocketnano_package(uint32_t index);
+extern void pocketnano_start(void *heap, uint32_t length, uint32_t *framebuffer, uint32_t index, int menu);
+extern int pocketnano_frame(uint32_t buttons, int x, int y, int down, const int32_t *accel,
+                            uint32_t now_us, int32_t *rects);
+extern void pocketnano_fingers(const int32_t *fingers, int n);
+extern int pocketnano_wants_menu(void);
+extern int pocketnano_motion(void);
+extern uint32_t pocketnano_heap_peak(void);
+extern uint32_t pocketnano_heap_used(void);
+extern uint32_t pocketnano_shape_bytes(void);
+extern uint32_t pocketnano_counter(uint32_t which);
+extern uint32_t pocketnano_stop(void);
+extern uint32_t pocketnano_boot_step(void);
+extern uint32_t pocketnano_menu_count(void);
+extern int pocketnano_find(const char *key, uint32_t len);
+extern const char *pocketnano_key(uint32_t index);
+
+/* The Rust core is built with panic=abort; nothing unwinds. */
+void __aeabi_unwind_cpp_pr0(void) {}
+void __aeabi_unwind_cpp_pr1(void) {}
+void __aeabi_unwind_cpp_pr2(void) {}
+
+enum { PN_MENU, PN_BOOT, PN_LOAD, PN_RUN, PN_FAILED, PN_NOMEM };
+
+static uint32_t *s_fb;
+static int s_state;
+static void *s_heap;
+static uint32_t s_heap_len;
+static void *s_jump[5];          /* __builtin_setjmp buffer */
+static uint32_t s_fail_code, s_fail_line;
+static int s_lean;                 /* pocketjs15: this block is smaller than asked */
+static uint32_t s_need, s_seen_largest, s_seen_free;
+static char s_fail_text[256];
+static uint32_t s_frames, s_trace_peak, s_slowest_us;
+static uint32_t *s_stack_lo, *s_stack_hi;
+/* This run's private stack: POCKETNANO_BOOT_STACK plus the app's extra. */
+static uint32_t s_stack_len = POCKETNANO_BOOT_STACK;
+static int s_boot_stack;         /* 1: run the core on the private stack */
+static uint32_t s_count, s_index;
+static uint32_t s_rows;          /* rows of the shim's own list */
+/* pocketjs13, the home screen: a QuickJS app (key "home") that opens the
+ * others. -1 when this build or this iPod has none (the list instead). */
+static int s_home = -1;
+static int s_launch = -1;        /* the app the home screen asked for */
+static int s_quiet;              /* booting from or to home: keep the frame */
+static char s_from[24];          /* key of the app that went back home */
+static int s_menu_hit, s_wait_release;
+static uint32_t s_next_us;
+static int s_ticked;
+static hb_spoint_t s_down_at;    /* where a touch went down since the last tick */
+static int s_down_seen;
+#define PN_LOG_US 10000000u      /* one PJFPS line per 10 s */
+static uint32_t s_win_start, s_win_ticks, s_win_slowest, s_run_start, s_run_ticks;
+static int32_t s_accel[3];
+static uint32_t s_load_step;
+static uint32_t s_fingers_max;   /* most fingers seen at once this run (PJFING) */
+
+static char *put_s(char *o, const char *s) { while (*s) *o++ = *s++; *o = 0; return o; }
+static char *put_u(char *o, uint32_t u)
+{
+    char t[12];
+    int n = 0;
+    do { t[n++] = (char)('0' + (u % 10u)); u /= 10u; } while (u);
+    while (n) *o++ = t[--n];
+    *o = 0;
+    return o;
+}
+
+/* ---- The log file (pocketjs12) ----
+ *
+ * Every breadcrumb also goes to a text file on the iPod, so the log survives
+ * going straight to Disk Mode (the trace ring reaches lasttrace.bin only
+ * after a normal reboot to the Home screen). The lines are held here and
+ * the whole file is rewritten with hb_fs_write (the whole-file write data.fs
+ * and PvZ saves use): after the app's first frame, every 20 s while it
+ * runs, when it returns to the menu and when it stops on an error screen.
+ * The run before is kept as <key>-prev.txt. Lines: "ms TAG v1 v2" in
+ * decimal, read by ./start pocketjs log. */
+#ifndef POCKETNANO_KEY
+#define POCKETNANO_KEY "pocketjs"
+#endif
+#define PN_LOG_ROOT "/Apps/Data/PocketJS"
+#define PN_LOG_DIR PN_LOG_ROOT "/logs"
+#define PN_LOG_FILE PN_LOG_DIR "/" POCKETNANO_KEY ".txt"
+#define PN_LOG_PREV PN_LOG_DIR "/" POCKETNANO_KEY "-prev.txt"
+#define PN_LOG_BYTES (12u << 10)
+#define PN_LOG_KEEP 2048u           /* the start of a run is never dropped */
+/* Routine lines (PJFPS, PJSLOW) reach the file every 30 s: each write of
+ * the 12 KB file is a FAT write that stalls the frame it lands in
+ * (pocketjs13: the 5 s flush sat under Notes' recurring 500 ms ticks).
+ * A save, a failure, the end of a run and a memory peak go out at once. */
+#define PN_FLUSH_US 30000000u
+static char s_log[PN_LOG_BYTES] __attribute__((aligned(32)));
+static uint32_t s_log_len, s_log_t0, s_log_flush_at, s_log_fails, s_log_write_us;
+static int s_log_dirty, s_log_on, s_log_soon;
+
+/* Ask for the log file to be written at the end of this frame. */
+void pocketnano_log_soon(void) { s_log_soon = 1; }
+
+static void log_append(const char *line, uint32_t n)
+{
+    uint32_t i;
+    if (!s_log_on)
+        return;
+    if (s_log_len + n > PN_LOG_BYTES) {
+        /* Full: drop the oldest lines after the first PN_LOG_KEEP bytes. */
+        uint32_t cut = PN_LOG_KEEP + (PN_LOG_BYTES - PN_LOG_KEEP) / 2;
+        while (cut < s_log_len && s_log[cut - 1] != '\n') cut++;
+        for (i = 0; cut + i < s_log_len; i++)
+            s_log[PN_LOG_KEEP + i] = s_log[cut + i];
+        s_log_len = PN_LOG_KEEP + i;
+        while (s_log_len > 0 && s_log[s_log_len - 1] != '\n') s_log_len--;
+    }
+    if (s_log_len + n > PN_LOG_BYTES)
+        return;
+    for (i = 0; i < n; i++)
+        s_log[s_log_len++] = line[i];
+    s_log_dirty = 1;
+}
+
+static char *put_u(char *o, uint32_t u);
+static char *put_dec(char *o, uint32_t u) { return put_u(o, u); }
+
+static void log_line(const char *tag, uint32_t v1, uint32_t v2)
+{
+    char line[64], *o = line;
+    const char *t = tag;
+    o = put_dec(o, (hb_time_uptime_us() - s_log_t0) / 1000u);
+    *o++ = ' ';
+    while (*t && o < line + 20) *o++ = *t++;
+    *o++ = ' ';
+    o = put_dec(o, v1);
+    *o++ = ' ';
+    o = put_dec(o, v2);
+    *o++ = '\n';
+    log_append(line, (uint32_t)(o - line));
+}
+
+/* A breadcrumb: the trace ring and the log file. */
+void pocketnano_log(const char *tag, uint32_t v1, uint32_t v2)
+{
+    hb_trace_log(tag, v1, v2);
+    log_line(tag, v1, v2);
+}
+
+/* The log file only (raw touch samples: too many for the 256-entry ring). */
+static void pn_log_raw(const char *tag, uint32_t v1, uint32_t v2)
+{
+    log_line(tag, v1, v2);
+}
+
+static void log_flush(void)
+{
+    if (!s_log_on || !s_log_dirty)
+        return;
+    s_log_flush_at = hb_time_uptime_us();
+    s_log_soon = 0;
+    if (hb_fs_write(PN_LOG_FILE, s_log, s_log_len)) {
+        s_log_dirty = 0;
+        s_log_write_us = hb_time_uptime_us() - s_log_flush_at;
+    } else if (++s_log_fails >= 3) {
+        s_log_on = 0;           /* no folder, full volume: stop trying */
+        hb_trace_log("PJLOGNO", s_log_fails, s_log_len);
+    }
+}
+
+/* At launch: keep the last run's file as -prev, start this run's. */
+static void log_open(void)
+{
+    static const char head[] = "# " POCKETNANO_TITLE " log: ms TAG v1 v2 (./start pocketjs log)\n";
+    uint32_t i;
+    s_log_t0 = hb_time_uptime_us();
+    s_log_len = 0;
+    s_log_dirty = 0;
+    s_log_fails = 0;
+    s_log_on = 1;
+    hb_fs_mkdir(PN_LOG_ROOT);
+    hb_fs_mkdir(PN_LOG_DIR);
+    if (hb_fs_exists(PN_LOG_FILE)) {
+        /* Whole sectors only, so the read stays inside the buffer. */
+        uint32_t size = hb_fs_size(PN_LOG_FILE), got;
+        uint32_t max = (PN_LOG_BYTES - 512u) & ~511u;
+        got = hb_fs_read(PN_LOG_FILE, s_log, max);
+        if (got > size)
+            got = size;
+        if (got)
+            hb_fs_write(PN_LOG_PREV, s_log, got);
+    }
+    for (i = 0; head[i]; i++) {}
+    log_append(head, i);
+}
+
+static void text(int x, int y, const char *str, int scale, uint32_t fg)
+{
+    fg |= 0xff000000u;
+    for (; *str; str++, x += 8 * scale) {
+        const uint8_t *g = hb_font8x8_glyph(*str);
+        int r, c;
+        for (r = 0; r < 8; r++)
+            for (c = 0; c < 8; c++)
+                if (g[r] & (0x80 >> c))
+                    hb_raw_fill_rect(x + c * scale, y + r * scale, scale, scale, fg);
+    }
+}
+
+static void screen(const char *title, const char *line1, const char *line2, uint32_t bg)
+{
+    hb_raw_fill(bg);
+    text(12, 16, POCKETNANO_TITLE, 2, 0xffffff);
+    text(12, 60, title, 1, 0xffffff);
+    if (line1) text(12, 80, line1, 1, 0xe2e8f0);
+    if (line2) text(12, 96, line2, 1, 0xe2e8f0);
+    text(12, PN_H - 24, "HOME TO EXIT", 1, 0xcbd5e1);
+}
+
+/* Run fn() with sp at top rounded down to 8 bytes (the AAPCS alignment;
+ * rc5: an unaligned top broke every UI op with arguments), then restore the
+ * caller's sp. r4 holds the old sp across the call (callee-saved). An IRQ
+ * taken meanwhile pushes onto the private stack, which is ordinary RAM with
+ * room to spare. */
+__attribute__((naked, noinline))
+static void on_stack(void (*fn)(void), void *top)
+{
+    __asm__ volatile(
+        "push {r4, lr}\n"
+        "mov r4, sp\n"
+        "bic r1, r1, #7\n"
+        "mov sp, r1\n"
+        "blx r0\n"
+        "mov sp, r4\n"
+        "pop {r4, pc}\n");
+}
+
+static uint32_t stack_used(void)
+{
+    uint32_t *p = s_stack_lo;
+    while (p < s_stack_hi && *p == PN_STACK_FILL) p++;
+    return (uint32_t)((char *)s_stack_hi - (char *)p);
+}
+
+static int stack_guard_ok(void)
+{
+    uint32_t i;
+    for (i = 0; i < 64; i++)
+        if (s_stack_lo[i] != PN_STACK_FILL)
+            return 0;
+    return 1;
+}
+
+static void boot(void)
+{
+    /* menu 2: opened from home (a home key); home itself has none. */
+    int menu = s_count > 1;
+    if (s_home >= 0)
+        menu = (int)s_index == s_home ? 0 : 2;
+    pocketnano_start(s_heap, s_heap_len, s_fb, s_index, menu);
+}
+
+/* ---- The home screen's calls (pocketqjs.c: globalThis.nano) ---- */
+
+/* Key of the app that just came back home ("" after a cold start). */
+const char *pocketnano_home_from(void)
+{
+    return s_from;
+}
+
+/* Whether app `key` is here and its package is on the volume. */
+int pocketnano_home_has(const char *key, uint32_t len)
+{
+    int i = pocketnano_find(key, len);
+    if (i < 0 || i == s_home)
+        return 0;
+    return !pocketnano_package((uint32_t)i) || pocketnano_heap_need((uint32_t)i) != 0;
+}
+
+/* Open app `key` after this frame. 0: no such app (nothing happens). */
+int pocketnano_home_launch(const char *key, uint32_t len)
+{
+    int i = pocketnano_find(key, len);
+    if (i < 0 || i == s_home || (int)s_index != s_home)
+        return 0;
+    s_launch = i;
+    return 1;
+}
+
+/* The OS clock record. pocketjs13 hardware logged 04 1d 0e 01 0b 00 ea 07:
+ * 14:29:04 on 1 Nov 2026, read right; the nano's clock was 8 h behind
+ * London, which is US Pacific time (the nano's own time zone setting), so
+ * Home adds the hour offset set in its System sheet. hb_sdk.h reads it as seconds, minutes, hours, day,
+ * month, pad, year (u16 at +6); hb_rtc_set writes year (u16 at +0), month,
+ * day, then hours, minutes, seconds at +8. Take whichever layout gives a
+ * year in 2000..2099, so a wrong guess shows no clock rather than a wrong
+ * one; the raw bytes go to the log once (PJRTC) to settle it. */
+static int rtc_fields(uint32_t f[6])
+{
+    static int logged;
+    uint8_t raw[16];
+    uint32_t i;
+    for (i = 0; i < sizeof raw; i++) raw[i] = 0xff;
+    hb_rtc_read((hb_rtc_time_t *)raw);
+    if (!logged) {
+        logged = 1;
+        pocketnano_log("PJRTC", (uint32_t)(raw[0] | raw[1] << 8 | raw[2] << 16 | (uint32_t)raw[3] << 24),
+                       (uint32_t)(raw[4] | raw[5] << 8 | raw[6] << 16 | (uint32_t)raw[7] << 24));
+        pocketnano_log("PJRTC2", (uint32_t)(raw[8] | raw[9] << 8 | raw[10] << 16 | (uint32_t)raw[11] << 24),
+                       (uint32_t)(raw[12] | raw[13] << 8 | raw[14] << 16 | (uint32_t)raw[15] << 24));
+    }
+    uint32_t y6 = raw[6] | raw[7] << 8, y0 = raw[0] | raw[1] << 8;
+    if (y6 >= 2000 && y6 < 2100 && raw[2] < 24 && raw[1] < 60 && raw[0] < 60) {
+        f[0] = y6; f[1] = raw[4]; f[2] = raw[3]; f[3] = raw[2]; f[4] = raw[1]; f[5] = raw[0];
+    } else if (y0 >= 2000 && y0 < 2100 && raw[8] < 24 && raw[9] < 60 && raw[10] < 60) {
+        f[0] = y0; f[1] = raw[2]; f[2] = raw[3]; f[3] = raw[8]; f[4] = raw[9]; f[5] = raw[10];
+    } else {
+        return 0;
+    }
+    return f[1] >= 1 && f[1] <= 12 && f[2] >= 1 && f[2] <= 31;
+}
+
+/* The wall clock: hours << 16 | minutes << 8 | seconds; -1 when the OS
+ * clock reads nothing sensible. */
+int32_t pocketnano_home_clock(void)
+{
+    uint32_t f[6];
+    if (!rtc_fields(f))
+        return -1;
+    return (int32_t)(f[3] << 16 | f[4] << 8 | f[5]);
+}
+
+/* The date: year << 16 | month << 8 | day (-1 when unknown). */
+int32_t pocketnano_home_date(void)
+{
+    uint32_t f[6];
+    if (!rtc_fields(f))
+        return -1;
+    return (int32_t)(f[0] << 16 | f[1] << 8 | f[2]);
+}
+
+/* Battery: level 0..15, bit 8 while charging. */
+int32_t pocketnano_home_battery(void)
+{
+    uint32_t level = hb_battery_level_0_to_15();
+    if (level > 15)
+        level = 15;
+    return (int32_t)(level | (hb_battery_is_charging() ? 0x100u : 0u));
+}
+
+/* Free RAM (pocketjs14): the OS heap as the next app would see it, and
+ * the music player. 0 free bytes, 1 largest block, 2 this app's block. */
+int32_t pocketnano_home_memory(int32_t which)
+{
+    if (which == 0) return (int32_t)hb_os_heap_free();
+    if (which == 1) return (int32_t)hb_os_heap_largest();
+    if (which == 3) return s_lean ? (int32_t)s_need : 0;   /* lean: the full block it wanted */
+    return (int32_t)(s_heap_len + s_stack_len);
+}
+
+/* 0: state (0 playing, 1 paused, 2 stopped, -1 no player); 1 pause;
+ * 2 stop (the SDK's unused queue "stop" entry, hb_media.c A_TASK_STOP:
+ * a hardware test, logged first so a crash shows where); 3 resume. */
+#define PN_TASK_GET  0x0841bfb4u
+#define PN_TASK_STOP 0x083bf040u
+int32_t pocketnano_home_media(int32_t op)
+{
+    int32_t before = hb_media_state();
+    if (op == 1) {
+        pocketnano_log("PJMUSIC", 1, (uint32_t)before);
+        hb_media_set_paused(true);
+    } else if (op == 3) {
+        pocketnano_log("PJMUSIC", 3, (uint32_t)before);
+        hb_media_set_paused(false);
+    } else if (op == 2) {
+        void *t = ((void *(*)(void))(PN_TASK_GET | 1u))();
+        pocketnano_log("PJMUSIC", 2, (uint32_t)before);
+        log_flush();
+        /* Called like pause (self, fade): a one-argument function ignores r1. */
+        if (t)
+            ((void (*)(void *, int))(PN_TASK_STOP | 1u))(t, -1);
+        pocketnano_log("PJMUSIC", 0x12, (uint32_t)hb_media_state());
+        log_flush();
+    }
+    return hb_media_state();
+}
