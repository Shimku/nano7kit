diff --git a/tools/build/nano7g/build.ts b/tools/build/nano7g/build.ts
new file mode 100644
index 00000000..0ef983bd
--- /dev/null
+++ b/tools/build/nano7g/build.ts
@@ -0,0 +1,95 @@
+#!/usr/bin/env bun
+/** MicroTS apps for the iPod nano 7th generation as NanoApps static libraries; no JavaScript VM.
+ *
+ * Builds the host preview (PNG frames of a scripted touch session, layout
+ * oracle, heap counts) and `libpocketjs_nano7g.a` for thumbv7a-none-eabi.
+ * The NanoApps shim in programs/nano7g/nanoapps links the library into a
+ * RAW_SURFACE `.hbapp` with the NanoApps SDK (nano7kit builds and installs it). */
+import { cpSync, mkdirSync, readFileSync, writeFileSync, statSync } from "node:fs";
+import { resolve } from "node:path";
+import { createHash } from "node:crypto";
+import { RUST_TOOLCHAINS, STABLE_RUST_TOOLCHAIN } from "../toolchains/rust.ts";
+import type { RuntimeBuildContext } from "../../../framework/src/host-config.ts";
+import { exportAotProfile } from "../aot-profile.ts";
+
+const root = resolve(import.meta.dir, "../../..");
+export const NANO7G_TOOLCHAIN = RUST_TOOLCHAINS.nano7g;
+export const NANO7G_TARGET = "thumbv7a-none-eabi";
+/** Cortex-A8, soft float (the firmware traps VFP/NEON in app code), and no
+ * MOVW/MOVT pairs: the NanoApps relocator rebases only absolute words. */
+export const NANO7G_RUSTFLAGS = "-C target-cpu=cortex-a8 -C target-feature=+soft-float,-neon,+no-movt -C relocation-model=static";
+const VIEWPORT: [number, number] = [240, 432];
+
+const USAGE = `bun tools/build/nano7g/build.ts (--aot-dir=<sources> | --sample=<key>:<sources> ...) [--outdir=<directory>] [--preview-script=<file>] [--no-preview] [--quickjs]
+
+<key> names a module in programs/nano7g/src/samples (jshero, gbahero, nanohero,
+hero, solidlab, vuelab, tilt). Several --sample flags link several apps into one
+library; the NanoApps shim then opens with a menu. --aot-dir alone is --sample=jshero.
+--quickjs adds the QuickJS apps of programs/nano7g/src/js.rs (their packages
+are files on the iPod; link with make QUICKJS=1 in programs/nano7g/nanoapps).
+
+Requires rustup toolchain install ${NANO7G_TOOLCHAIN} --component rust-src`;
+
+async function run(command: string[], options: { cwd?: string; env?: Record<string, string | undefined> } = {}) {
+  const child = Bun.spawn(command, { cwd: options.cwd ?? root, stdout: "inherit", stderr: "inherit", env: { ...process.env, ...options.env } });
+  if (await child.exited !== 0 || child.signalCode) throw new Error(`${command.join(" ")} failed`);
+}
+
+function option(name: string, args: readonly string[]): string | undefined {
+  const prefix = `--${name}=`;
+  return args.find(arg => arg.startsWith(prefix))?.slice(prefix.length);
+}
+
+export async function buildNano7g(args: readonly string[], context?: RuntimeBuildContext) {
+  if (args.includes("--help")) {
+    console.log(USAGE);
+    return;
+  }
+  const execute = context ? (command: string[], options: { cwd?: string; env?: Record<string, string> } = {}) => context.run(command, options) : run;
+  const known = ["--aot-dir=", "--sample=", "--outdir=", "--preview-script=", "--no-preview", "--quickjs"];
+  if (args.some(arg => !known.some(prefix => arg.startsWith(prefix)))) throw new Error(`Unknown argument\n${USAGE}`);
+  const out = context?.outdir ?? resolve(option("outdir", args) ?? resolve(root, "dist/nano7g"));
+  const gen = resolve(out, "generated");
+  mkdirSync(gen, { recursive: true });
+  const single = context?.aot?.directory ?? option("aot-dir", args);
+  const samples: [string, string][] = args.filter(arg => arg.startsWith("--sample=")).map(arg => {
+    const [key, ...rest] = arg.slice("--sample=".length).split(":");
+    return [key!, rest.join(":")];
+  });
+  if (single) samples.unshift(["jshero", single]);
+  if (samples.length === 0) throw new Error("nano7g build requires --aot-dir or --sample from pocket compile --aot");
+  const dependencies = samples.map(([key, input]) => {
+    const dependency = JSON.parse(readFileSync(resolve(input, "dependencies.json"), "utf8"));
+    cpSync(resolve(input), resolve(gen, key), { recursive: true });
+    return dependency;
+  });
+  const dependency = dependencies[0];
+  const mismatch = dependencies.find(d => d.profileHash !== dependency.profileHash);
+  if (mismatch) throw new Error(`${mismatch.plan.app.id} was compiled for another nano7g profile; recompile every sample`);
+  const env = {
+    NANO7G_SAMPLES: samples.map(([key]) => `${key}=${resolve(gen, key)}`).join(";"),
+    POCKETJS_PROFILE_RS: exportAotProfile(dependency, gen, context),
+  };
+
+  let previewCommand: string[] | null = null;
+  if (!args.includes("--no-preview")) {
+    const previewDir = resolve(out, "preview");
+    mkdirSync(previewDir, { recursive: true });
+    const script = option("preview-script", args);
+    previewCommand = ["cargo", `+${STABLE_RUST_TOOLCHAIN}`, "run", "--locked", "--release", "--manifest-path", resolve(root, "programs/nano7g/preview/Cargo.toml"), "--target-dir", resolve(out, "preview-target"), "--", previewDir, ...(script ? [resolve(script)] : [])];
+    await execute(previewCommand, { env });
+  }
+
+  const libCommand = ["cargo", `+${NANO7G_TOOLCHAIN}`, "build", "--locked", "--release", "--lib", "--target", NANO7G_TARGET, "-Z", "build-std=core,alloc", "-Z", "build-std-features=compiler-builtins-mem", "--manifest-path", resolve(root, "programs/nano7g/Cargo.toml"), "--target-dir", resolve(out, "target"), ...(args.includes("--quickjs") ? ["--features", "quickjs"] : [])];
+  await execute(libCommand, { env: { ...env, CARGO_PROFILE_RELEASE_LTO: "true", CARGO_PROFILE_RELEASE_PANIC: "abort", RUSTFLAGS: NANO7G_RUSTFLAGS } });
+  const lib = resolve(out, `target/${NANO7G_TARGET}/release/libpocketjs_nano7g.a`);
+  const bytes = readFileSync(lib);
+  writeFileSync(resolve(out, "build.json"), JSON.stringify({
+    target: NANO7G_TARGET, toolchain: NANO7G_TOOLCHAIN, rustflags: NANO7G_RUSTFLAGS,
+    previewCommand, libCommand, apps: samples.map(([key], i) => ({ key, id: dependencies[i].plan.app.id, planHash: dependencies[i].planHash, nominalTickHz: dependencies[i].plan.profile.tickHz })),
+    viewport: VIEWPORT, profileHash: dependency.profileHash,
+    library: { file: lib, bytes: statSync(lib).size, sha256: createHash("sha256").update(bytes).digest("hex") },
+  }, null, 2) + "\n");
+  console.log(`libpocketjs_nano7g.a: ${bytes.length} bytes`);
+}
+if (import.meta.main) await buildNano7g(Bun.argv.slice(2));
