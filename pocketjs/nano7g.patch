new file mode 100644
index 00000000..adea5676
--- /dev/null
+++ b/tests/fixtures/nano7g-hbfs.c
@@ -0,0 +1,76 @@
+/* The NanoApps SDK's file calls (nanoapps/sdk/hb_fs.c) over a computer's
+ * directory, for tests/fs-nano7g.test.ts: whole-file writes, reads from the
+ * start that also fill the rest of the last 512-byte sector (as the iPod's
+ * may), no rename, and a directory iterator that hands out names. */
+#include <dirent.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+typedef struct { uint8_t opaque[0x50]; } hb_dir_t;
+
+bool hb_fs_exists(const char *path) {
+  struct stat st;
+  return stat(path, &st) == 0;
+}
+bool hb_fs_is_dir(const char *path) {
+  struct stat st;
+  return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+uint32_t hb_fs_size(const char *path) {
+  struct stat st;
+  return stat(path, &st) == 0 && S_ISREG(st.st_mode) ? (uint32_t)st.st_size : 0;
+}
+bool hb_fs_write(const char *path, const void *data, uint32_t size) {
+  FILE *f = fopen(path, "wb");
+  if (!f) return false;
+  bool ok = size == 0 || fwrite(data, 1, size, f) == size;
+  return fclose(f) == 0 && ok;
+}
+uint32_t hb_fs_read(const char *path, void *buf, uint32_t max) {
+  FILE *f = fopen(path, "rb");
+  if (!f) return 0;
+  uint32_t got = (uint32_t)fread(buf, 1, max, f);
+  fclose(f);
+  uint32_t sector = (got + 511) & ~511u;
+  if (sector > max) sector = max;
+  memset((uint8_t *)buf + got, 0xa5, sector - got);
+  return got;
+}
+bool hb_fs_remove(const char *path) { return unlink(path) == 0; }
+bool hb_fs_rmdir(const char *path) { return rmdir(path) == 0; }
+bool hb_fs_mkdir(const char *path) {
+  char p[512];
+  snprintf(p, sizeof p, "%s", path);
+  for (char *s = p + 1; *s; s++)
+    if (*s == '/') { *s = 0; mkdir(p, 0777); *s = '/'; }
+  return mkdir(p, 0777) == 0 || errno == EEXIST;
+}
+bool hb_fs_dir_open(hb_dir_t *iter, const char *path, bool recursive) {
+  (void)recursive;
+  DIR *d = opendir(path);
+  memcpy(iter->opaque, &d, sizeof d);
+  return d != NULL;
+}
+bool hb_fs_dir_next(hb_dir_t *iter, char *name, int size, bool *is_dir) {
+  DIR *d;
+  memcpy(&d, iter->opaque, sizeof d);
+  if (!d) return false;
+  struct dirent *e = readdir(d);
+  if (!e) return false;
+  snprintf(name, (size_t)size, "%s", e->d_name);
+  *is_dir = e->d_type == DT_DIR;
+  return true;
+}
+void hb_fs_dir_close(hb_dir_t *iter) {
+  DIR *d;
+  memcpy(&d, iter->opaque, sizeof d);
+  if (d) closedir(d);
+}
+void hb_trace_log(const char *tag, uint32_t v1, uint32_t v2) { (void)tag; (void)v1; (void)v2; }
+/* pocketjs12: nanofs logs through the host shim (trace ring plus log file). */
+void pocketnano_log(const char *tag, uint32_t v1, uint32_t v2) { hb_trace_log(tag, v1, v2); }
