new file mode 100644
index 00000000..a81285d1
--- /dev/null
+++ b/apps/nano7g-tilt/app.ts
@@ -0,0 +1,38 @@
+import { createSignal } from "solid-js";
+import { clamp, round, type f32, type i32, type u8, type u64 } from "@pocketjs/framework/solid/std";
+
+export const [x, setX] = createSignal<i32>(96);
+export const [y, setY] = createSignal<i32>(108);
+export const [beta, setBeta] = createSignal<i32>(0);
+export const [gamma, setGamma] = createSignal<i32>(0);
+export const [live, setLive] = createSignal(false);
+
+// The tilt that counts as neutral: the first sample after launch or after
+// Center, so the hold the app starts in (flat on a table, or in the hand)
+// keeps the ball still.
+export const [beta0, setBeta0] = createSignal<f32>(0.0);
+export const [gamma0, setGamma0] = createSignal<f32>(0.0);
+export const [calibrated, setCalibrated] = createSignal(false);
+
+// W3C DeviceOrientation tilt in degrees, relative to the neutral hold:
+// gamma rolls the ball left and right; beta steers it up and down: raising
+// the top edge moves it up (the other sign read as inverted on the iPod).
+export function tilt(b: f32, g: f32, quality: u8, timestamp: u64): void {
+  setLive(true);
+  setBeta(round(b));
+  setGamma(round(g));
+  if (!calibrated()) {
+    setBeta0(b);
+    setGamma0(g);
+    setCalibrated(true);
+  }
+  setX(clamp(x() + round((g - gamma0()) / 4.0), 0, 192));
+  setY(clamp(y() - round((b - beta0()) / 4.0), 0, 216));
+}
+
+// Center the ball and take the next sample as the neutral hold.
+export function center(): void {
+  setX(96);
+  setY(108);
+  setCalibrated(false);
+}
