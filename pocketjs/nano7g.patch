diff --git a/apps/nano7g-fonts/app.tsx b/apps/nano7g-fonts/app.tsx
new file mode 100644
index 00000000..69f2de55
--- /dev/null
+++ b/apps/nano7g-fonts/app.tsx
@@ -0,0 +1,93 @@
+import { createSignal, onCleanup } from "solid-js";
+import { Text, View } from "@pocketjs/framework/solid/components";
+import { onFrame, onMount } from "@pocketjs/framework/solid/lifecycle";
+import { openFontArchive, type TextResource } from "@pocketjs/framework/fonts";
+import { offload } from "@pocketjs/framework/offload";
+
+// Dynamic text on the iPod nano 7G: phrases.txt is read from
+// /Apps/Data/PocketJS/fonts at run time, so its letters are not in the
+// fonts the build baked. Their glyphs stream from intl.pjfa (Inter, Latin,
+// Greek and Cyrillic at 16 and 24 px) through the device-local io.offload
+// provider into the core's glyph cache, one small batch per frame.
+type Archive = ReturnType<typeof openFontArchive>;
+
+/** Break at spaces so no line runs past `width` characters. */
+function wrap(text: string, width: number): string {
+  const out: string[] = [];
+  let line = "";
+  for (const word of text.split(" ")) {
+    if (line.length > 0 && line.length + 1 + word.length > width) {
+      out.push(line);
+      line = word;
+    } else line = line.length > 0 ? `${line} ${word}` : word;
+  }
+  if (line.length > 0) out.push(line);
+  return out.join("\n");
+}
+
+export default function App() {
+  const [status, setStatus] = createSignal("Reading phrases.txt");
+  const [metrics, setMetrics] = createSignal("");
+  const [big, setBig] = createSignal<TextResource | undefined>(undefined);
+  const [small, setSmall] = createSignal<TextResource | undefined>(undefined);
+  const [index, setIndex] = createSignal(0);
+  const [count, setCount] = createSignal(0);
+  let lines: string[] = [];
+  let archive: Archive | undefined;
+  let held: TextResource[] = [];
+
+  const show = (i: number) => {
+    if (!archive || lines.length === 0) return;
+    for (const r of held) r.dispose();
+    const line = lines[i % lines.length];
+    const first = line.split(/[ ,!?]/)[0];
+    const a = archive.prepareText(first, { slot: 5 });
+    const b = archive.prepareText(wrap(line, 24), { slot: 2 });
+    held = [a, b];
+    setBig(a);
+    setSmall(b);
+    setIndex(i % lines.length);
+  };
+  let frames = 0;
+  onFrame(() => {
+    if (!archive || ++frames % 10) return;
+    const st = archive.status(), s = archive.stats(), r = small()?.state();
+    setMetrics(`${st.state} ${r ? r.status : ""} | ${s.resident} glyphs, ${Math.round(s.bytes / 1024)} KB`);
+    if (st.error) setStatus(st.error);
+    else if (r && r.status === "error") setStatus(String(r.error));
+  });
+
+  onMount(() => {
+    offload("local").request("fs.read-text", "fonts/phrases.txt", (r) => {
+      if (!r.ok) return setStatus(r.error);
+      lines = r.value.split("\n").filter((l) => l.length > 0);
+      setCount(lines.length);
+      archive = openFontArchive({ path: "fonts/intl.pjfa", slots: [2, 5], provider: "local", capacity: 128, maxBytes: 256 * 1024 });
+      setStatus(`${lines.length} phrases, glyphs from intl.pjfa`);
+      show(0);
+    });
+  });
+  onCleanup(() => {
+    for (const r of held) r.dispose();
+    archive?.dispose();
+  });
+
+  return (
+    <View class="w-full h-full flex-col bg-slate-950 px-3 pt-3">
+      <Text class="text-xs text-slate-400">DYNAMIC TEXT ON A NANO</Text>
+      <Text class="text-lg font-bold text-white">Fonts</Text>
+      <Text class="text-xs text-slate-400 mb-3">{status()}</Text>
+      <View class="h-[40] overflow-hidden">
+        <Text resource={big()} class="text-2xl text-sky-300" />
+      </View>
+      <View class="h-[64] overflow-hidden">
+        <Text resource={small()} class="text-base text-slate-100" />
+      </View>
+      <Text class="text-xs text-slate-500 mt-2">{metrics()}</Text>
+      <Text class="text-xs text-slate-500">{`Phrase ${index() + 1} of ${count()}`}</Text>
+      <View class="absolute left-[12] top-[364] w-[140] h-[52] items-center justify-center rounded-xl bg-blue-600 active:bg-blue-800" focusable onPress={() => show(index() + 1)}>
+        <Text class="text-base font-bold text-white">Next phrase</Text>
+      </View>
+    </View>
+  );
+}
diff --git a/apps/nano7g-fonts/bake.ts b/apps/nano7g-fonts/bake.ts
new file mode 100644
index 00000000..a6607113
--- /dev/null
+++ b/apps/nano7g-fonts/bake.ts
@@ -0,0 +1,17 @@
+// The nano7g Fonts sample's archive: Inter Regular at text-base (slot 2) and
+// text-2xl (slot 5) for Latin-1, Latin Extended-A, Greek and Cyrillic. It is
+// read whole into the app's block (the nano's file API reads from the start
+// only), so keep it small. Usage: bun apps/nano7g-fonts/bake.ts OUT.pjfa
+import { bakeFontArchive } from "../../framework/compiler/font-archive.ts";
+const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
+const codepoints = [
+  ...range(0x20, 0x7e), ...range(0xa0, 0xff), ...range(0x100, 0x17f),
+  ...range(0x370, 0x3ff), ...range(0x400, 0x45f), 0x2013, 0x2014, 0x2018, 0x2019, 0x201c, 0x201d, 0x2026, 0x20ac,
+];
+const font = new URL("../../assets/fonts/Inter-Regular.ttf", import.meta.url).pathname;
+const out = Bun.argv[2];
+if (!out) throw new Error("Use: bun apps/nano7g-fonts/bake.ts OUT.pjfa");
+const bytes = await bakeFontArchive({ font, slots: [2, 5], codepoints,
+  onStrike: (slot, count) => console.log(`slot ${slot}: ${count} glyphs`) });
+await Bun.write(out, bytes);
+console.log(`${out}: ${bytes.length} bytes`);
