+#[test]
+fn static_font_atlas_is_read_in_place_and_matches_a_copied_one() {
+    let mut atlas = encode_atlas(0, 8, 8, 7, 10, 2, &[(65, 1, 6), (0xfffd, 0, 8)]);
+    for (i, pixel) in atlas[32..].iter_mut().enumerate() {
+        *pixel = (i * 7 + 3) as u8;
+    }
+    let leaked: &'static [u8] = alloc::boxed::Box::leak(atlas.clone().into_boxed_slice());
+    let mut copied = Ui::new();
+    let mut borrowed = Ui::new();
+    assert!(copied.load_font_atlas(&atlas));
+    assert!(borrowed.load_font_atlas_static(leaked));
+    let (a, b) = (copied.font_atlas(0).unwrap(), borrowed.font_atlas(0).unwrap());
+    assert_eq!(a.bitmap, b.bitmap);
+    assert!(a.bitmap_heap_bytes() > 0);
+    assert_eq!(b.bitmap_heap_bytes(), 0);
+    // The coverage is the linked bytes themselves, not a copy.
+    assert!(core::ptr::eq(b.bitmap.as_ptr(), leaked[leaked.len() - b.bitmap.len()..].as_ptr()));
+    assert_eq!(copied.measure_text("AA", 0), borrowed.measure_text("AA", 0));
+    assert_eq!(copied.font_atlas_revision(0), borrowed.font_atlas_revision(0));
