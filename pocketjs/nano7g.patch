diff --git a/apps/nano7g-notebook/app.tsx b/apps/nano7g-notebook/app.tsx
new file mode 100644
index 00000000..7f0b8f45
--- /dev/null
+++ b/apps/nano7g-notebook/app.tsx
@@ -0,0 +1,313 @@
+import { createMemo, createSignal, For, Index } from "solid-js";
+import { Text, View } from "@pocketjs/framework/solid/components";
+import { animate, jump } from "@pocketjs/framework/animation";
+import { createGesture } from "@pocketjs/framework/gesture";
+import { onFrame } from "@pocketjs/framework/lifecycle";
+import { existsSync, file, write } from "@pocketjs/framework/fs";
+import { Keyboard } from "./keyboard.tsx";
+
+// Notes for the iPod nano 7G held on its side (pocketjs13): a list of notes
+// and an editor with the landscape keyboard. Notes live in data.fs under
+// /Apps/Data/PocketJS/notebook/: notes/<id>.txt, and index.txt with the ids,
+// newest first. The editor saves 3 s after the last key, on Back, before
+// Delete, and when the menu key leaves (nano.onexit). Each save is a FAT
+// write that stalls a frame (pocketjs14: index.txt is only written when the
+// order changes, so a save is one write, not two).
+// The top right corner stays clear for the shim's menu key.
+
+const W = 432;
+const KB_TOP = 104;
+const TEXT_X = 10;
+const TEXT_Y = 32;
+const LINE_H = 18;
+const LINES = 4;
+const ADV = 8; // font-mono text-sm advance (checked against the baked atlas)
+const COLS = Math.floor((W - 2 * TEXT_X) / ADV);
+const LIST_Y = 44;
+const ROW_H = 38;
+const SHOWN = 5;
+
+interface Note {
+  id: number;
+  text: string;
+}
+
+function readIndex(): number[] {
+  if (!existsSync("index.txt")) return [];
+  lastIndex = file("index.txt").text();
+  return lastIndex.split(",").map((s) => Number(s)).filter((n) => n > 0);
+}
+
+function loadNotes(): Note[] {
+  const out: Note[] = [];
+  for (const id of readIndex()) {
+    const path = `notes/${id}.txt`;
+    if (existsSync(path)) out.push({ id, text: file(path).text() });
+  }
+  return out;
+}
+
+let lastIndex = "";
+function saveIndex(notes: Note[]) {
+  const line = notes.map((n) => n.id).join(",");
+  if (line === lastIndex) return;
+  write("index.txt", line);
+  lastIndex = line;
+}
+
+/** Wrap at COLS (a word moves down whole when it fits on a line). Each line
+ *  keeps its start offset so the caret can be placed. */
+function wrap(text: string): { start: number; text: string }[] {
+  const lines: { start: number; text: string }[] = [];
+  let start = 0;
+  while (start <= text.length) {
+    const nl = text.indexOf("\n", start);
+    const end = nl < 0 ? text.length : nl;
+    let s = start;
+    while (end - s > COLS) {
+      let cut = text.lastIndexOf(" ", s + COLS);
+      if (cut <= s) cut = s + COLS;
+      else cut += 1;
+      lines.push({ start: s, text: text.slice(s, cut) });
+      s = cut;
+    }
+    lines.push({ start: s, text: text.slice(s, end) });
+    if (nl < 0) break;
+    start = nl + 1;
+  }
+  return lines;
+}
+
+function title(text: string) {
+  const first = text.split("\n")[0]!.trim();
+  return first.length ? (first.length > 34 ? `${first.slice(0, 33)}...` : first) : "New note";
+}
+
+function preview(text: string) {
+  const rest = text.split("\n").slice(1).join(" ").trim();
+  return rest.length ? (rest.length > 46 ? `${rest.slice(0, 45)}...` : rest) : `${text.length} characters`;
+}
+
+export default function App() {
+  const [notes, setNotes] = createSignal<Note[]>([]);
+  const [editing, setEditing] = createSignal(false);
+  const [text, setText] = createSignal("");
+  const [caret, setCaret] = createSignal(0);
+  const [status, setStatus] = createSignal("");
+  let current = 0;
+  let dirty = 0; // frames until the autosave
+  let caretView: unknown;
+  let editor: unknown;
+  let list: unknown;
+  let blink = 0;
+  let saved = ""; // what is on disk for the open note
+
+  const fail = (e: unknown) => setStatus(`Could not save: ${String(e instanceof Error ? e.message : e).slice(0, 30)}`);
+
+  try {
+    let all = loadNotes();
+    if (all.length === 0 && !existsSync("index.txt")) {
+      const welcome =
+        "Welcome to Notes\nTyped on an iPod nano 7G, in JavaScript. Tap a key and hold: the magnifier shows which one you hit.";
+      write("notes/1.txt", welcome);
+      all = [{ id: 1, text: welcome }];
+      saveIndex(all);
+    }
+    setNotes(all);
+  } catch (e) {
+    fail(e);
+  }
+
+  const save = () => {
+    dirty = 0;
+    if (!current || text() === saved) return;
+    try {
+      write(`notes/${current}.txt`, text());
+      saved = text();
+      const rest = notes().filter((n) => n.id !== current);
+      const all = [{ id: current, text: text() }, ...rest];
+      setNotes(all);
+      saveIndex(all);
+      setStatus("Saved");
+    } catch (e) {
+      fail(e);
+    }
+  };
+
+  const open = (note: Note | null) => {
+    if (note) {
+      current = note.id;
+      saved = note.text;
+      setText(note.text);
+      setCaret(note.text.length);
+      setStatus("");
+    } else {
+      current = notes().reduce((m, n) => Math.max(m, n.id), 0) + 1;
+      saved = "";
+      setText("");
+      setCaret(0);
+      setStatus("New note");
+    }
+    setEditing(true);
+    jump(editor as never, "translateX", W);
+    animate(editor as never, "translateX", 0, { dur: 260, easing: "out" });
+    animate(list as never, "translateX", -W / 3, { dur: 260, easing: "out" });
+  };
+
+  const close = () => {
+    if (text().trim().length === 0) {
+      remove(false);
+      return;
+    }
+    save();
+    setEditing(false);
+    animate(editor as never, "translateX", W, { dur: 240, easing: "out" });
+    jump(list as never, "translateX", -W / 3);
+    animate(list as never, "translateX", 0, { dur: 240, easing: "out" });
+  };
+
+  const remove = (say: boolean) => {
+    try {
+      if (existsSync(`notes/${current}.txt`)) file(`notes/${current}.txt`).delete();
+      const all = notes().filter((n) => n.id !== current);
+      setNotes(all);
+      saveIndex(all);
+      if (say) setStatus("Note deleted");
+    } catch (e) {
+      fail(e);
+    }
+    current = 0;
+    dirty = 0;
+    setEditing(false);
+    animate(editor as never, "translateY", 240, { dur: 260, easing: "in" });
+    jump(list as never, "translateX", 0);
+    jump(list as never, "opacity", 0.3);
+    animate(list as never, "opacity", 1, { dur: 260 });
+  };
+
+  // Wrapped once per edit (it was re-run by every reader, six times a key).
+  const lines = createMemo(() => wrap(text()));
+  const caretLine = () => {
+    const ls = lines();
+    const c = caret();
+    let i = ls.length - 1;
+    while (i > 0 && ls[i]!.start > c) i--;
+    return i;
+  };
+  const scroll = createMemo(() => Math.max(0, caretLine() - (LINES - 1)));
+  // Plain strings in place (Index): a key rewrites one Text, not four rows.
+  const visible = createMemo(() => lines().slice(scroll(), scroll() + LINES).map((l) => l.text.replace(/\n/g, "")));
+
+  const placeCaret = () => {
+    const ls = lines();
+    const li = caretLine();
+    const col = caret() - ls[li]!.start;
+    jump(caretView as never, "translateX", TEXT_X + col * ADV);
+    jump(caretView as never, "translateY", TEXT_Y + (li - scroll()) * LINE_H + 1);
+    jump(caretView as never, "opacity", 1);
+    blink = 0;
+  };
+
+  const key = (k: string) => {
+    const t = text();
+    const c = caret();
+    if (k === "back") {
+      if (c === 0) return;
+      setText(t.slice(0, c - 1) + t.slice(c));
+      setCaret(c - 1);
+    } else if (k === "left") {
+      setCaret(Math.max(0, c - 1));
+    } else if (k === "right") {
+      setCaret(Math.min(t.length, c + 1));
+    } else {
+      const ch = k === "enter" ? "\n" : k;
+      if (t.length >= 4000) return;
+      setText(t.slice(0, c) + ch + t.slice(c));
+      setCaret(c + 1);
+    }
+    if (k !== "left" && k !== "right") {
+      dirty = 90;
+      setStatus("Editing");
+    }
+    placeCaret();
+  };
+
+  // Header buttons, the list rows and tapping the text to move the caret.
+  createGesture({
+    region: { rect: () => ({ x: 0, y: 0, w: W, h: editing() ? KB_TOP : 240 }) },
+    onTap: (c) => {
+      if (editing()) {
+        if (c.y < 28 && c.x < 100) close();
+        else if (c.y < 28 && c.x >= 306 && c.x < 380) remove(true);
+        else if (c.y >= TEXT_Y - 4) {
+          const ls = lines();
+          const li = Math.min(ls.length - 1, scroll() + Math.max(0, Math.floor((c.y - TEXT_Y) / LINE_H)));
+          const line = ls[li]!;
+          const col = Math.max(0, Math.min(line.text.replace(/\s$/, "").length, Math.round((c.x - TEXT_X) / ADV)));
+          setCaret(line.start + col);
+          placeCaret();
+        }
+        return;
+      }
+      if (c.y < 36 && c.x >= 262 && c.x < 378) {
+        open(null);
+        return;
+      }
+      const row = Math.floor((c.y - LIST_Y) / ROW_H);
+      const shown = notes().slice(0, SHOWN);
+      if (c.y >= LIST_Y && row >= 0 && row < shown.length) open(shown[row]!);
+    },
+  });
+
+  // The menu key: save what is typed before the app goes (the shim calls
+  // nano.onexit; older shims never do, and the 3 s autosave covers them).
+  const nanoHost = (globalThis as unknown as { nano?: { onexit?: () => void } }).nano;
+  if (nanoHost) nanoHost.onexit = () => save();
+
+  onFrame(() => {
+    if (dirty > 0 && --dirty === 0) save();
+    // The caret blinks only once typing pauses: each blink repaints the frame.
+    if (editing() && ++blink >= 30 && blink % 20 === 0) jump(caretView as never, "opacity", (blink / 20) % 2 ? 0 : 1);
+  });
+
+  return (
+    <View class="w-full h-full bg-[#1c1c1e]">
+      <View ref={(el: unknown) => (list = el)} class="absolute left-0 top-0 w-[432] h-[240] bg-[#1c1c1e]">
+        <Text class="absolute left-[14] top-[6] text-xl font-bold text-white">Notes</Text>
+        <Text class="absolute left-[90] top-[12] text-xs text-[#8e8e93]">{`${notes().length} ${notes().length === 1 ? "note" : "notes"}`}</Text>
+        <View class="absolute left-[270] top-[6] w-[100] h-[26] rounded-xl bg-[#f59e0b] items-center justify-center">
+          <Text class="text-sm font-bold text-[#1c1c1e]">+ New note</Text>
+        </View>
+        <View class="absolute left-[10] top-[44] w-[412] h-[190] rounded-xl bg-[#2c2c2e]" />
+        <View class="absolute left-[10] top-[44] w-[412] h-[190] flex-col">
+          <For each={notes().slice(0, SHOWN)}>
+            {(n) => (
+              <View class="w-[412] h-[38] flex-col px-3 pt-1">
+                <Text class="text-sm font-bold text-white">{title(n.text)}</Text>
+                <Text class="text-xs text-[#8e8e93]">{preview(n.text)}</Text>
+              </View>
+            )}
+          </For>
+        </View>
+        <Text class="absolute left-[16] top-[224] text-2xs text-[#8e8e93]">{notes().length > SHOWN ? `and ${notes().length - SHOWN} more` : status()}</Text>
+      </View>
+      <View ref={(el: unknown) => (editor = el)} class="absolute left-0 top-0 w-[432] h-[240] bg-[#1c1c1e]" style={{ translateX: 432 }}>
+        <Text class="absolute left-[10] top-[6] text-sm font-bold text-[#f59e0b]">{"< Notes"}</Text>
+        <Text class="absolute left-[100] top-[7] w-[200] text-center text-xs text-[#8e8e93]">{status()}</Text>
+        <Text class="absolute left-[318] top-[6] text-sm font-bold text-[#ff453a]">Delete</Text>
+        <View class="absolute left-0 top-[28] w-[432] h-[1] bg-[#3a3a3c]" />
+        <View class="absolute left-0 top-[32] w-[432] h-[72] flex-col">
+          <Index each={visible()}>
+            {(l) => (
+              <View class="h-[18] pl-[10]">
+                <Text class="text-sm font-mono text-white">{l()}</Text>
+              </View>
+            )}
+          </Index>
+        </View>
+        <View ref={(el: unknown) => (caretView = el)} class="absolute left-0 top-0 w-[2] h-[16] bg-[#f59e0b]" />
+        <Keyboard top={KB_TOP} onKey={key} active={editing} />
+      </View>
+    </View>
+  );
+}
