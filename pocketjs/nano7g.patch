diff --git a/apps/nano7g-home/app.tsx b/apps/nano7g-home/app.tsx
new file mode 100644
index 00000000..3a2c0849
--- /dev/null
+++ b/apps/nano7g-home/app.tsx
@@ -0,0 +1,483 @@
+import { Show, createSignal } from "solid-js";
+import { Image, Text, View } from "@pocketjs/framework/solid/components";
+import { animate, jump } from "@pocketjs/framework/animation";
+import { createGesture } from "@pocketjs/framework/gesture";
+import { onFrame } from "@pocketjs/framework/lifecycle";
+import { existsSync, file, write } from "@pocketjs/framework/fs";
+
+// The PocketJS home screen on the iPod nano 7G (pocketjs13). It is an app
+// like the others: the shim boots it, and globalThis.nano (pocketqjs.c)
+// lets it read the clock and battery and ask the shim to open another app.
+// Opening grows a tile in the app's colours to the whole screen, then the
+// shim swaps realms under that last frame; coming back (nano.from) runs it
+// in reverse. pocketjs14: the zoom animates one rounded rect's box (inset,
+// size, radius) and leaves the icons alone; pocketjs13 scaled and faded the
+// whole desk, which composited every icon through a layer each frame (5 to 10
+// fps on the nano). The System tile opens a sheet with the memory the next
+// app will find, music pause/stop, and the clock's hour offset.
+
+interface Nano {
+  from: string;
+  has(key: string): boolean;
+  launch(key: string): boolean;
+  clock(): number;
+  date(): number;
+  battery(): number;
+  memory?(which: number): number;
+  media?(op: number): number;
+}
+const nano: Nano | undefined = (globalThis as unknown as { nano?: Nano }).nano;
+
+const W = 240;
+const H = 432;
+const TILE = 50;
+const CELL = 60;
+const PAGES = 2;
+const PAGE_Y = 24;
+const PAGE_H = 320;
+const DOCK_Y = 364;
+
+interface App {
+  key: string;
+  name: string;
+  tile: string;
+  from: string;
+  to: string;
+  glyph?: string;
+  label?: string;
+}
+
+// Tile classes are whole literals so the compiler bakes each one.
+const APPS: App[] = [
+  { key: "notebook", name: "Notes", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#fde68a] to-[#f59e0b]", from: "#fde68a", to: "#f59e0b", glyph: "glyph-notes.svg" },
+  { key: "talk", name: "Talk", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#86efac] to-[#16a34a]", from: "#86efac", to: "#16a34a", glyph: "glyph-talk.svg" },
+  { key: "motion", name: "Motion Lab", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#f472b6] to-[#7c3aed]", from: "#f472b6", to: "#7c3aed", glyph: "glyph-motion.svg" },
+  { key: "cafe", name: "Cafe", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#fdba74] to-[#9a3412]", from: "#fdba74", to: "#9a3412", glyph: "glyph-cafe.svg" },
+  { key: "physics", name: "Physics", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#60a5fa] to-[#1e3a8a]", from: "#60a5fa", to: "#1e3a8a", glyph: "glyph-physics.svg" },
+  { key: "tilt", name: "Tilt", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#5eead4] to-[#0f766e]", from: "#5eead4", to: "#0f766e", glyph: "glyph-tilt.svg" },
+  { key: "gestures", name: "Gestures", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#fda4af] to-[#e11d48]", from: "#fda4af", to: "#e11d48", glyph: "glyph-gestures.svg" },
+  { key: "type", name: "Type", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#94a3b8] to-[#334155]", from: "#94a3b8", to: "#334155", glyph: "glyph-type.svg" },
+  { key: "fonts", name: "Fonts", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#ffffff] to-[#d4d4d8]", from: "#ffffff", to: "#d4d4d8", label: "Aa" },
+  { key: "hero", name: "JS Hero", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#facc15] to-[#ca8a04]", from: "#facc15", to: "#ca8a04", label: "JS" },
+  { key: "vue", name: "Vue Lab", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#6ee7b7] to-[#047857]", from: "#6ee7b7", to: "#047857", label: "V" },
+  { key: "system", name: "System", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#67e8f9] to-[#0e7490]", from: "#67e8f9", to: "#0e7490", glyph: "glyph-memory.svg" },
+  { key: "notes", name: "Memo", tile: "w-[50] h-[50] rounded-[13] items-center justify-center bg-gradient-to-b from-[#c4b5fd] to-[#6d28d9]", from: "#c4b5fd", to: "#6d28d9", label: "M" },
+];
+const DOCK = ["notebook", "talk", "motion", "cafe"];
+// [page, row, col] of every icon not in the dock. Page 0 has the clock card.
+const GRID: Record<string, [number, number, number]> = {
+  physics: [0, 2, 0], tilt: [0, 2, 1], gestures: [0, 2, 2], type: [0, 2, 3],
+  fonts: [0, 3, 0], hero: [0, 3, 1], vue: [0, 3, 2],
+  notes: [1, 0, 0], system: [1, 0, 1],
+};
+const ROW_Y = [14, 92, 162, 240];
+
+const DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
+const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August",
+  "September", "October", "November", "December"];
+// Baked so the clock, date and battery can show any value.
+export const GLYPHS = "0123456789:%+ ,";
+
+const app = (key: string) => APPS.find((a) => a.key === key)!;
+const has = (key: string) => key === "system" || (nano ? nano.has(key) : true);
+const kb = (n: number) => `${Math.round(n / 1024)} KB`;
+const MUSIC = ["Playing", "Paused", "Stopped"];
+/** pocketjs15: the shim gave Home a smaller block than it asked for (music or
+ *  Bluetooth headphones hold the OS's big block): the full block it wanted. */
+const lean = nano && nano.memory ? nano.memory(3) : 0;
+
+/** Hours added to the nano's clock (its time zone is set on the nano; the
+ *  pocketjs13 nano read US Pacific). Kept in home/clock.txt. */
+function readOffset(): number {
+  try {
+    if (existsSync("clock.txt")) {
+      const n = Number(file("clock.txt").text());
+      if (n >= -12 && n <= 14) return Math.round(n);
+    }
+  } catch {
+    // no data folder: no offset
+  }
+  return 0;
+}
+
+/** Screen rect of an icon's tile. */
+function tileRect(key: string): { x: number; y: number; page: number } {
+  const d = DOCK.indexOf(key);
+  if (d >= 0) return { x: 8 + d * 56 + 3, y: DOCK_Y + 8, page: -1 };
+  const [page, row, col] = GRID[key];
+  return { x: col * CELL + (CELL - TILE) / 2, y: PAGE_Y + ROW_Y[row], page };
+}
+
+/** 0 = Sunday (Sakamoto). */
+function weekday(y: number, m: number, d: number) {
+  const t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
+  if (m < 3) y -= 1;
+  return (y + Math.floor(y / 4) - Math.floor(y / 100) + Math.floor(y / 400) + t[(m + 11) % 12] + d) % 7;
+}
+
+function two(n: number) {
+  return n < 10 ? `0${n}` : `${n}`;
+}
+
+export default function App() {
+  const [time, setTime] = createSignal("9:41");
+  const [day, setDay] = createSignal("Sunday, 1 November");
+  const [battery, setBattery] = createSignal(80);
+  const [charging, setCharging] = createSignal(false);
+  const [page, setPage] = createSignal(0);
+  const [hint, setHint] = createSignal("");
+  let strip: unknown;
+  let zoom: unknown;
+  let hintBox: unknown;
+  let batFill: unknown;
+  const tiles: Record<string, unknown> = {};
+  let busy = false;
+  let pending = "";
+  let wait = 0;
+  let tick = 0;
+  const [offset, setOffset] = createSignal(readOffset());
+
+  const readClock = () => {
+    if (!nano) return;
+    const c = nano.clock();
+    const d = nano.date();
+    if (c >= 0 && d > 0) {
+      // The offset can move the date: do it in UTC milliseconds.
+      const t = new Date(Date.UTC(d >> 16, ((d >> 8) & 255) - 1, d & 255, (c >> 16) & 255, (c >> 8) & 255) + offset() * 3600000);
+      setTime(`${t.getUTCHours()}:${two(t.getUTCMinutes())}`);
+      const wd = weekday(t.getUTCFullYear(), t.getUTCMonth() + 1, t.getUTCDate());
+      setDay(`${DAYS[wd]}, ${t.getUTCDate()} ${MONTHS[t.getUTCMonth()]}`);
+    } else if (c >= 0) {
+      setTime(`${(((c >> 16) & 255) + offset() + 24) % 24}:${two((c >> 8) & 255)}`);
+    }
+    const b = nano.battery();
+    if (b >= 0) {
+      const pct = Math.round(((b & 15) * 100) / 15);
+      setBattery(pct);
+      setCharging((b & 0x100) !== 0);
+      if (batFill) jump(batFill as never, "width", Math.max(2, Math.round((pct * 18) / 100)));
+    }
+  };
+
+  // Zoom: one rounded rect grows from the tile to the screen (or back). Only
+  // its box moves, so a frame repaints the rect and, closing, what it uncovers.
+  const zoomTo = (key: string, open: boolean) => {
+    const r = tileRect(key);
+    const a = app(key);
+    jump(zoom as never, "gradFrom", a.from);
+    jump(zoom as never, "gradTo", a.to);
+    const dur = 280;
+    const box: [string, number, number][] = [
+      ["insetL", r.x, 0],
+      ["insetT", r.y, 0],
+      ["width", TILE, W],
+      ["height", TILE, H],
+      ["radius", 13, 0],
+    ];
+    jump(zoom as never, "opacity", 1);
+    for (const [prop, small, big] of box) {
+      jump(zoom as never, prop as never, open ? small : big);
+      animate(zoom as never, prop as never, open ? big : small, { dur, easing: open ? "out" : "in-out" });
+    }
+    if (!open) animate(zoom as never, "opacity", 0, { dur: 90, delay: dur - 30 });
+  };
+
+  const goPage = (p: number) => {
+    setPage(p);
+    animate(strip as never, "translateX", -p * W, { dur: 260, easing: "out" });
+  };
+
+  // ---- System sheet ----
+  const [sheet, setSheet] = createSignal(false);
+  const [largest, setLargest] = createSignal(0);
+  const [free, setFree] = createSignal(0);
+  const [held, setHeld] = createSignal(0);
+  const [music, setMusic] = createSignal("No player");
+  const [result, setResult] = createSignal("");
+  let sheetView: unknown;
+  let measureAt = 0;
+  let measureFrom = 0;
+  let measureFreeFrom = 0;
+  let measureWhat = "";
+  const measure = () => {
+    if (!nano || !nano.memory) {
+      setResult("This shim has no nano.memory (an older JS QuickJS)");
+      return;
+    }
+    setLargest(nano.memory(1));
+    setFree(nano.memory(0));
+    setHeld(nano.memory(2));
+    const m = nano.media ? nano.media(0) : -1;
+    setMusic(m >= 0 && m < 3 ? MUSIC[m] : "No player");
+  };
+  const openSheet = () => {
+    measure();
+    setResult(lean > 0
+      ? `Low memory: Home has ${kb(nano && nano.memory ? nano.memory(2) : 0)} of ${kb(lean)}`
+      : "Home's own block is held; it goes when an app opens.");
+    setSheet(true);
+    jump(sheetView as never, "opacity", 1);
+    animate(sheetView as never, "translateY", 0, { dur: 220, easing: "out" });
+  };
+  const closeSheet = () => {
+    setSheet(false);
+    animate(sheetView as never, "translateY", H, { dur: 200, easing: "in" });
+  };
+  const music_ = (op: number, what: string) => {
+    if (!nano || !nano.media || !nano.memory) return;
+    measureFrom = nano.memory(1);
+    measureFreeFrom = nano.memory(0);
+    measureWhat = what;
+    nano.media(op);
+    measureAt = 1;
+    setResult(`${what}: measuring...`);
+  };
+  const setClock = (d: number) => {
+    const n = Math.max(-12, Math.min(14, offset() + d));
+    setOffset(n);
+    try {
+      write("clock.txt", String(n));
+    } catch {
+      // read-only: the offset lasts until Home closes
+    }
+    readClock();
+  };
+  const sheetTap = (x: number, y: number) => {
+    if (y < 96) closeSheet();
+    else if (y >= 246 && y < 280) music_(1, "Pause");
+    else if (y >= 288 && y < 322) music_(2, "Stop");
+    else if (y >= 332 && y < 366 && x < 120) setClock(-1);
+    else if (y >= 332 && y < 366) setClock(1);
+    else if (y >= 378) closeSheet();
+  };
+
+  const open = (key: string) => {
+    if (busy) return;
+    if (key === "system") {
+      openSheet();
+      return;
+    }
+    if (!has(key)) {
+      setHint(`${app(key).name} is not on the iPod: ./start pocketjs packages`);
+      jump(hintBox as never, "opacity", 1);
+      animate(hintBox as never, "opacity", 0, { dur: 400, delay: 2500 });
+      return;
+    }
+    busy = true;
+    pending = key;
+    wait = 11; // 300 ms at 30 Hz, plus a frame showing the full colour
+    zoomTo(key, true);
+  };
+
+  const hitIcon = (x: number, y: number): string => {
+    if (y >= DOCK_Y && y < DOCK_Y + 64) {
+      const d = Math.floor((x - 8) / 56);
+      return d >= 0 && d < DOCK.length ? DOCK[d] : "";
+    }
+    if (y < PAGE_Y || y >= PAGE_Y + PAGE_H) return "";
+    for (const key of Object.keys(GRID)) {
+      const r = tileRect(key);
+      if (r.page !== page()) continue;
+      if (x >= r.x - 5 && x < r.x + TILE + 5 && y >= r.y - 4 && y < r.y + TILE + 16) return key;
+    }
+    return "";
+  };
+
+  let pressed = "";
+  const press = (key: string) => {
+    if (pressed && tiles[pressed]) animate(tiles[pressed] as never, "scale", 1, { dur: 120, easing: "out" });
+    pressed = key;
+    if (key && tiles[key]) animate(tiles[key] as never, "scale", 0.86, { dur: 90, easing: "out" });
+  };
+
+  createGesture({
+    axis: "x",
+    region: { rect: () => ({ x: 0, y: 0, w: W, h: H }) },
+    onDown: (c) => {
+      if (!busy && !sheet()) press(hitIcon(c.x, c.y));
+    },
+    onUp: () => press(""),
+    onCancel: () => press(""),
+    onPanStart: () => press(""),
+    onPanMove: (c) => {
+      if (busy || sheet()) return;
+      let x = -page() * W + c.dx;
+      if (x > 0) x = x / 3;
+      if (x < -(PAGES - 1) * W) x = -(PAGES - 1) * W + (x + (PAGES - 1) * W) / 3;
+      jump(strip as never, "translateX", x);
+    },
+    onPanEnd: (c) => {
+      if (sheet()) return;
+      let next = page();
+      if (c.dx < -W / 4 || c.vx < -300) next = Math.min(PAGES - 1, next + 1);
+      else if (c.dx > W / 4 || c.vx > 300) next = Math.max(0, next - 1);
+      goPage(next);
+    },
+    onTap: (c) => {
+      if (sheet()) {
+        sheetTap(c.x, c.y);
+        return;
+      }
+      const key = hitIcon(c.x, c.y);
+      if (key) open(key);
+      else if (c.y >= 344 && c.y < 362) goPage((page() + 1) % PAGES);
+    },
+  });
+
+  onFrame(() => {
+    if (wait > 0 && --wait === 0 && pending) {
+      const key = pending;
+      pending = "";
+      if (!nano || !nano.launch(key)) {
+        zoomTo(key, false);
+        busy = false;
+      }
+    }
+    if (tick++ % 30 === 0) readClock();
+    if (measureAt > 0 && nano && nano.memory) {
+      measureAt++;
+      // The player lets go of its buffers on its own thread: look at 1 s and 3 s.
+      if (measureAt === 31 || measureAt === 91) {
+        measure();
+        const now = nano.memory(1);
+        const freeNow = nano.memory(0);
+        setResult(`${measureWhat} (${measureAt === 31 ? 1 : 3} s): largest ${kb(measureFrom)} -> ${kb(now)}, free ${kb(measureFreeFrom)} -> ${kb(freeNow)}`);
+        if (measureAt === 91) measureAt = 0;
+      }
+    }
+  });
+
+  const icon = (key: string) => {
+    const a = app(key);
+    return (
+      <View class="w-[60] h-[72] flex-col items-center">
+        <View
+          ref={(el: unknown) => (tiles[key] = el)}
+          class={a.tile}
+        >
+          {a.glyph ? (
+            <Image class="w-[30] h-[30]" src={a.glyph} />
+          ) : (
+            <Text class={a.key === "fonts" ? "text-xl font-bold text-slate-900" : "text-xl font-bold text-white"}>{a.label}</Text>
+          )}
+        </View>
+        <Text class="mt-1 text-2xs text-white">{a.name}</Text>
+      </View>
+    );
+  };
+
+
+  // Coming back from an app: start zoomed in on it and shrink to its icon.
+  // First frame also greys out the apps whose package is not on the iPod.
+  const back = nano ? nano.from : "";
+  let first = true;
+  onFrame(() => {
+    if (!first) return;
+    first = false;
+    for (const a of APPS) if (!has(a.key) && tiles[a.key]) jump(tiles[a.key] as never, "opacity", 0.4);
+    if (back && (GRID[back] !== undefined || DOCK.indexOf(back) >= 0)) {
+      const r = tileRect(back);
+      if (r.page > 0) {
+        setPage(r.page);
+        jump(strip as never, "translateX", -r.page * W);
+      }
+      zoomTo(back, false);
+    }
+  });
+
+  readClock();
+
+  return (
+    <View class="w-full h-full bg-gradient-to-b from-[#1e1b4b] to-[#9d174d]">
+      {/* pocketjs14: no big translucent circles behind the pages; their
+          rounded spans (float math per row) and blends were most of a swipe frame. */}
+      <View class="absolute left-0 top-0 w-[240] h-[432]">
+        <View class="absolute left-0 top-[24] w-[240] h-[320]">
+          <View ref={(el: unknown) => (strip = el)} class="absolute left-0 top-0 w-[480] h-[320]">
+            <View class="absolute left-[12] top-[8] w-[216] h-[134] rounded-[20] bg-[#ffffff26] flex-col items-center justify-center">
+              <Text class="text-4xl font-bold text-white">{time()}</Text>
+              <Text class="text-sm text-white">{day()}</Text>
+              <Show
+                when={lean > 0}
+                fallback={<Text class="mt-1 text-2xs text-[#ffffffb0]">POCKETJS ON QUICKJS</Text>}
+              >
+                <Text class="mt-1 text-2xs text-[#fde68a]">LOW MEMORY: MUSIC OR BLUETOOTH</Text>
+              </Show>
+            </View>
+            <View class="absolute left-0 top-[162] w-[240] h-[72] flex-row">
+              {["physics", "tilt", "gestures", "type"].map((k) => icon(k))}
+            </View>
+            <View class="absolute left-0 top-[240] w-[240] h-[72] flex-row">
+              {["fonts", "hero", "vue"].map((k) => icon(k))}
+            </View>
+            <View class="absolute left-[240] top-0 w-[240] h-[320]">
+              <View class="absolute left-0 top-[14] w-[240] h-[72] flex-row">
+                {["notes", "system"].map((k) => icon(k))}
+              </View>
+              <View class="absolute left-[12] top-[100] w-[216] h-[120] rounded-[20] bg-[#ffffff1f] flex-col p-3 gap-1">
+                <Text class="text-sm font-bold text-white">iPod nano 7G</Text>
+                <Text class="text-xs text-white">Apps in JavaScript and TypeScript</Text>
+                <Text class="text-xs text-white">Solid and Vue, QuickJS on the iPod</Text>
+                <Text class="text-xs text-[#ffffffb0]">Swipe back for the clock</Text>
+              </View>
+            </View>
+          </View>
+        </View>
+        <View class="absolute left-[104] top-[348] w-[32] h-[8] flex-row justify-between">
+          <View class={page() === 0 ? "w-[8] h-[8] rounded-full bg-white" : "w-[8] h-[8] rounded-full bg-[#ffffff59]"} />
+          <View class={page() === 1 ? "w-[8] h-[8] rounded-full bg-white" : "w-[8] h-[8] rounded-full bg-[#ffffff59]"} />
+        </View>
+        <View class="absolute left-[6] top-[364] w-[228] h-[64] rounded-[20] bg-[#ffffff33]" />
+        <View class="absolute left-[8] top-[364] w-[224] h-[64] flex-row">
+          {DOCK.map((k) => (
+            <View class="w-[56] h-[64] items-center justify-center">
+              <View
+                ref={(el: unknown) => (tiles[k] = el)}
+                class={app(k).tile}
+              >
+                <Image class="w-[30] h-[30]" src={app(k).glyph!} />
+              </View>
+            </View>
+          ))}
+        </View>
+      </View>
+      <Text class="absolute left-[14] top-[4] text-xs font-bold text-white">{time()}</Text>
+      <Text class="absolute left-[80] top-[4] w-[80] text-center text-2xs text-[#ffffffb0]">PocketJS</Text>
+      <Text class="absolute right-[44] top-[4] text-2xs text-white">{charging() ? `${battery()}% +` : `${battery()}%`}</Text>
+      <View class="absolute left-[200] top-[6] w-[22] h-[11] rounded-sm bg-[#ffffff80]" />
+      <View class="absolute left-[201] top-[7] w-[20] h-[9] rounded-sm bg-[#1e1b4b]" />
+      <View ref={(el: unknown) => (batFill = el)} class="absolute left-[202] top-[8] w-[14] h-[7] rounded-sm bg-white" />
+      <View class="absolute left-[222] top-[9] w-[2] h-[5] bg-[#ffffff80]" />
+      <View ref={(el: unknown) => (hintBox = el)} class="absolute left-[8] top-[296] w-[224] h-[44] rounded-xl bg-[#000000c0] items-center justify-center opacity-0">
+        <Text class="text-2xs text-white">{hint()}</Text>
+      </View>
+      <View ref={(el: unknown) => (sheetView = el)} class="absolute left-0 top-0 w-[240] h-[432] opacity-0" style={{ translateY: 432 }}>
+        <View class="absolute left-0 top-[92] w-[240] h-[340] rounded-[20] bg-[#18153a] flex-col px-4 pt-3">
+          <Text class="text-xl font-bold text-white">System</Text>
+          <Text class="mt-2 text-xs text-[#a5b4fc]">{`Largest free block  ${kb(largest())}`}</Text>
+          <Text class="mt-1 text-xs text-[#a5b4fc]">{`Free in all  ${kb(free())}`}</Text>
+          <Text class="mt-1 text-xs text-[#a5b4fc]">{`Home holds  ${kb(held())}`}</Text>
+          <Text class="mt-1 text-xs text-white">{`Music  ${music()}`}</Text>
+          <Text class="mt-1 text-2xs text-[#fde68a]">{result()}</Text>
+        </View>
+        <View class="absolute left-[16] top-[246] w-[208] h-[34] rounded-xl bg-[#4338ca] items-center justify-center">
+          <Text class="text-sm font-bold text-white">Pause music</Text>
+        </View>
+        <View class="absolute left-[16] top-[288] w-[208] h-[34] rounded-xl bg-[#7f1d1d] items-center justify-center">
+          <Text class="text-sm font-bold text-white">Stop music (test)</Text>
+        </View>
+        <View class="absolute left-[16] top-[332] w-[96] h-[34] rounded-xl bg-[#334155] items-center justify-center">
+          <Text class="text-sm font-bold text-white">- 1 h</Text>
+        </View>
+        <Text class="absolute left-[112] top-[342] w-[16] text-center text-2xs text-white">{offset() >= 0 ? `+${offset()}` : `${offset()}`}</Text>
+        <View class="absolute left-[128] top-[332] w-[96] h-[34] rounded-xl bg-[#334155] items-center justify-center">
+          <Text class="text-sm font-bold text-white">+ 1 h</Text>
+        </View>
+        <View class="absolute left-[16] top-[378] w-[208] h-[34] rounded-xl bg-[#ffffff26] items-center justify-center">
+          <Text class="text-sm font-bold text-white">Done</Text>
+        </View>
+      </View>
+      <View ref={(el: unknown) => (zoom = el)} class="absolute left-0 top-0 w-[50] h-[50] rounded-[13] opacity-0 bg-gradient-to-b from-[#fde68a] to-[#f59e0b]" />
+    </View>
+  );
+}
