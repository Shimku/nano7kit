+import { createSignal, For } from "solid-js";
+import { Text, View } from "@pocketjs/framework/solid/components";
+import { TextField } from "@pocketjs/framework/osk";
+
+// Text input on the iPod nano 7G: the nano has no keyboard, so a tap on the
+// field opens the PocketJS on-screen keyboard (framework/osk) docked at the
+// bottom of the 240 x 432 panel. Typed text is laid out live in the fonts
+// the build baked; ✓ commits a line to the list (memory only, no files).
+export default function App() {
+  const [draft, setDraft] = createSignal("");
+  const [lines, setLines] = createSignal<string[]>(["Tap the field to type."]);
+  const submit = (text: string) => {
+    if (text.length === 0) return;
+    setLines([text, ...lines()].slice(0, 6));
+    setDraft("");
+  };
+  return (
+    <View class="w-full h-full flex-col bg-slate-950 px-3 pt-3">
+      <Text class="text-xs text-slate-400">INPUT ON A NANO</Text>
+      <Text class="text-lg font-bold text-white mb-2">Type</Text>
+      <TextField value={draft} onInput={setDraft} onSubmit={submit} placeholder="Say something" />
+      <Text class="text-xs text-slate-400 mt-2">{`${draft().length} characters`}</Text>
+      <Text class="text-2xl font-bold text-sky-300 mt-1">{draft() || "Aa"}</Text>
+      <Text class="text-sm text-slate-300">{draft() || "The quick brown fox"}</Text>
+      <View class="flex-col mt-3">
+        <For each={lines()}>{(line) => <Text class="text-sm text-slate-200 mb-1">{line}</Text>}</For>
+      </View>
+    </View>
+  );
+}
