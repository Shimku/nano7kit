diff --git a/apps/nano7g-talk/app.tsx b/apps/nano7g-talk/app.tsx
new file mode 100644
index 00000000..2e5b8885
--- /dev/null
+++ b/apps/nano7g-talk/app.tsx
@@ -0,0 +1,155 @@
+import { createSignal, For } from "solid-js";
+import { Text, View } from "@pocketjs/framework/solid/components";
+import { animate, jump } from "@pocketjs/framework/animation";
+import { createGesture } from "@pocketjs/framework/gesture";
+import { onFrame } from "@pocketjs/framework/lifecycle";
+import { Keyboard } from "../nano7g-notebook/keyboard.tsx";
+
+// Talk: a chat on the iPod nano 7G held on its side (pocketjs13). Tap the
+// message field and the Notes keyboard slides up; Send posts a bubble, and
+// Pocket, a canned bot, types back. Nothing leaves the iPod.
+
+const W = 432;
+const KB_TOP = 104;
+const CHARS = 40; // a bubble line, text-sm, about 7 px a character
+const CW = 7;
+
+interface Msg {
+  me: boolean;
+  lines: string[];
+  width: number;
+}
+
+function bubble(me: boolean, text: string): Msg {
+  const words = text.split(" ");
+  const lines: string[] = [];
+  let cur = "";
+  for (const w of words) {
+    if (cur.length && cur.length + 1 + w.length > CHARS) {
+      lines.push(cur);
+      cur = w;
+    } else cur = cur.length ? `${cur} ${w}` : w;
+  }
+  lines.push(cur);
+  const longest = lines.reduce((m, l) => Math.max(m, l.length), 0);
+  return { me, lines, width: Math.min(300, longest * CW + 22) };
+}
+
+const REPLIES = [
+  "Hi! I am Pocket. I live on this iPod nano, in JavaScript.",
+  "Everything you see is drawn by PocketJS on QuickJS. Not bad for 2012 hardware.",
+  "Try the keyboard: hold a key and slide, the magnifier follows your finger.",
+  "Press the menu key at the top right to go back home. I will be here.",
+  "Fun fact: this chat app is about the size of one song.",
+];
+
+function reply(text: string, n: number): string {
+  const t = text.toLowerCase();
+  if (/\b(hi|hello|hey)\b/.test(t)) return "Hello! Nice to meet you on an iPod.";
+  if (t.includes("?")) return "Good question. I only know canned answers, but I type them nicely.";
+  if (t.includes("ipod")) return "The 7th generation nano: 240 x 432 pixels, multi-touch, and now apps.";
+  return REPLIES[n % REPLIES.length]!;
+}
+
+export default function App() {
+  const [msgs, setMsgs] = createSignal<Msg[]>([
+    bubble(false, "Welcome to Talk. Tap the field below and say hi."),
+  ]);
+  const [draft, setDraft] = createSignal("");
+  const [typing, setTyping] = createSignal(false);
+  const [kb, setKb] = createSignal(false);
+  let tray: unknown;
+  let dots: unknown[] = [];
+  let pendingReply = "";
+  let wait = 0;
+  let sent = 0;
+  let frame = 0;
+
+  const showKb = (on: boolean) => {
+    setKb(on);
+    animate(tray as never, "translateY", on ? 0 : 140, { dur: 240, easing: "out" });
+  };
+
+  const send = () => {
+    const t = draft().trim();
+    if (!t) return;
+    setMsgs([...msgs(), bubble(true, t)].slice(-12));
+    setDraft("");
+    pendingReply = reply(t, sent++);
+    wait = 34;
+    setTyping(true);
+  };
+
+  const key = (k: string) => {
+    const d = draft();
+    if (k === "back") setDraft(d.slice(0, -1));
+    else if (k === "enter") send();
+    else if (k === "left" || k === "right") return;
+    else if (d.length < 120) setDraft(d + k);
+  };
+
+  createGesture({
+    region: { rect: () => ({ x: 0, y: 0, w: W, h: kb() ? KB_TOP : 240 }) },
+    onTap: (c) => {
+      const fieldY = kb() ? 72 : 206;
+      if (c.y >= fieldY && c.y < fieldY + 30) {
+        if (c.x > W - 70 && draft().trim()) send();
+        else if (!kb()) showKb(true);
+      } else if (kb()) showKb(false);
+    },
+  });
+
+  onFrame(() => {
+    frame++;
+    if (wait > 0 && --wait === 0) {
+      setTyping(false);
+      setMsgs([...msgs(), bubble(false, pendingReply)].slice(-12));
+    }
+    if (typing() && frame % 6 === 0) {
+      const lit = (frame / 6) % 3;
+      dots.forEach((d, i) => jump(d as never, "opacity", i === lit ? 1 : 0.35));
+    }
+  });
+
+  // With the keyboard up there is room for the newest message only.
+  const shown = () => (kb() ? msgs().slice(-1) : msgs().slice(-4));
+
+  return (
+    <View class="w-full h-full bg-[#000000]">
+      <View class="absolute left-0 top-0 w-[432] h-[28] bg-[#1c1c1e] flex-row items-center px-3 gap-2">
+        <View class="w-[20] h-[20] rounded-full bg-gradient-to-b from-[#86efac] to-[#16a34a] items-center justify-center">
+          <Text class="text-2xs font-bold text-white">P</Text>
+        </View>
+        <Text class="text-sm font-bold text-white">Pocket</Text>
+        <Text class="text-2xs text-[#8e8e93]">{typing() ? "typing..." : "online"}</Text>
+      </View>
+      <View class={kb() ? "absolute left-0 top-[30] w-[432] h-[40] flex-col justify-end px-2" : "absolute left-0 top-[30] w-[432] h-[172] flex-col justify-end px-2 gap-1"}>
+        <For each={shown()}>
+          {(m) => (
+            <View class={m.me ? "w-[416] flex-row justify-end" : "w-[416] flex-row justify-start"}>
+              <View class={m.me ? "rounded-xl bg-[#0a84ff] px-3 py-1 flex-col" : "rounded-xl bg-[#3a3a3c] px-3 py-1 flex-col"} style={{ width: m.width }}>
+                <For each={m.lines}>{(l) => <Text class="text-sm text-white">{l}</Text>}</For>
+              </View>
+            </View>
+          )}
+        </For>
+        {typing() ? (
+          <View class="w-[60] h-[24] rounded-xl bg-[#3a3a3c] flex-row items-center justify-center gap-1">
+            <View ref={(el: unknown) => (dots[0] = el)} class="w-[7] h-[7] rounded-full bg-white" />
+            <View ref={(el: unknown) => (dots[1] = el)} class="w-[7] h-[7] rounded-full bg-white" />
+            <View ref={(el: unknown) => (dots[2] = el)} class="w-[7] h-[7] rounded-full bg-white" />
+          </View>
+        ) : null}
+      </View>
+      <View class={kb() ? "absolute left-[8] top-[72] w-[416] h-[28] rounded-xl bg-[#1c1c1e] flex-row items-center px-3" : "absolute left-[8] top-[206] w-[416] h-[28] rounded-xl bg-[#1c1c1e] flex-row items-center px-3"}>
+        <Text class={draft() ? "w-[340] text-sm text-white" : "w-[340] text-sm text-[#636366]"}>{draft() ? `${draft().slice(-46)}|` : "Message"}</Text>
+        <View class={draft() ? "w-[52] h-[22] rounded-xl bg-[#0a84ff] items-center justify-center" : "w-[52] h-[22] rounded-xl bg-[#3a3a3c] items-center justify-center"}>
+          <Text class="text-xs font-bold text-white">Send</Text>
+        </View>
+      </View>
+      <View ref={(el: unknown) => (tray = el)} class="absolute left-0 top-0 w-[432] h-[240]" style={{ translateY: 140 }}>
+        <Keyboard top={KB_TOP} onKey={key} enter="send" active={kb} />
+      </View>
+    </View>
+  );
+}
