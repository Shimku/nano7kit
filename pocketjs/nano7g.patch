+    let package: &'static [u8] = alloc::boxed::Box::leak(package.into_boxed_slice());
+    let blob = &package[64..64 + atlas.len()];
+    let mut outside = Ui::new();
+    assert!(outside.load_font_atlas(blob));
+    assert!(outside.font_atlas(0).unwrap().bitmap_heap_bytes() > 0);
+    unsafe { crate::text::set_resident_region(package.as_ptr(), package.len()) };
+    let mut inside = Ui::new();
+    assert!(inside.load_font_atlas(blob));
+    // Cleared before asserting so a failure leaves no region for other tests.
+    unsafe { crate::text::set_resident_region(core::ptr::null(), 0) };
+    let (a, b) = (outside.font_atlas(0).unwrap(), inside.font_atlas(0).unwrap());
+    assert_eq!(b.bitmap_heap_bytes(), 0);
+    assert_eq!(a.bitmap, b.bitmap);
+    assert_eq!(outside.measure_text("AA", 0), inside.measure_text("AA", 0));
