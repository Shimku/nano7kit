diff --git a/apps/nano7g-physics/app.tsx b/apps/nano7g-physics/app.tsx
new file mode 100644
index 00000000..b69a2fe4
--- /dev/null
+++ b/apps/nano7g-physics/app.tsx
@@ -0,0 +1,77 @@
+import { createSignal } from "solid-js";
+import { Image, Text, View } from "@pocketjs/framework/solid/components";
+import { onCleanup, onMount } from "@pocketjs/framework/solid/lifecycle";
+import { createWorld, type Body, type World } from "@pocketjs/framework/physics";
+
+// ui.physics on the iPod nano 7G: balls in a box, stepped by the PocketJS
+// core (2D bodies, ops 52..56); the JavaScript only reacts to taps and hits.
+const W = 240;
+const FLOOR = 352;
+const R = 18;
+const BALLS = 6;
+
+export default function App() {
+  const [hits, setHits] = createSignal(0);
+  const [down, setDown] = createSignal(true);
+  const nodes: unknown[] = [];
+  let world: World | undefined;
+  const bodies: Body[] = [];
+  let seed = 7;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+
+  onMount(() => {
+    const w = createWorld({ gravity: [0, 900], substeps: 2, seed: 20261101 });
+    world = w;
+    w.collider({ shape: { chain: [[0, 0], [0, FLOOR], [W, FLOOR], [W, 0]], radius: 2, closed: true }, restitution: 0.7, friction: 0.4 });
+    for (let i = 0; i < BALLS; i++) {
+      bodies.push(w.body({
+        views: [nodes[i] as never],
+        shape: { circle: R },
+        position: [30 + i * 36, 60 + (i % 2) * 40],
+        velocity: [(i - 2.5) * 40, 0],
+        restitution: 0.6,
+        friction: 0.3,
+        hitSpeed: 160,
+        pickable: true,
+        // Lit from the top left, so they do not turn: a rotated image is a
+        // per-pixel resample (10.7 M instructions a frame), a moved one a blit.
+        maxSpin: 0,
+      }));
+    }
+    w.onHit(() => setHits(hits() + 1));
+  });
+  onCleanup(() => world?.destroy());
+
+  const shake = () => {
+    for (const b of bodies) b.impulse((rand() - 0.5) * 900, -500 - rand() * 600);
+  };
+  const flip = () => {
+    const next = !down();
+    setDown(next);
+    world?.setGravity(0, next ? 900 : -900);
+    for (const b of bodies) b.wake();
+  };
+
+  return (
+    <View class="w-full h-full bg-slate-900">
+      <View class="absolute left-0 top-0 w-[240] h-[352] bg-slate-800" />
+      <Image ref={(el: unknown) => (nodes[0] = el)} class="absolute left-0 top-0 w-[36] h-[36]" src="nano7g-ball-blue.svg" />
+      <Image ref={(el: unknown) => (nodes[1] = el)} class="absolute left-0 top-0 w-[36] h-[36]" src="nano7g-ball-emerald.svg" />
+      <Image ref={(el: unknown) => (nodes[2] = el)} class="absolute left-0 top-0 w-[36] h-[36]" src="nano7g-ball-amber.svg" />
+      <Image ref={(el: unknown) => (nodes[3] = el)} class="absolute left-0 top-0 w-[36] h-[36]" src="nano7g-ball-rose.svg" />
+      <Image ref={(el: unknown) => (nodes[4] = el)} class="absolute left-0 top-0 w-[36] h-[36]" src="nano7g-ball-violet.svg" />
+      <Image ref={(el: unknown) => (nodes[5] = el)} class="absolute left-0 top-0 w-[36] h-[36]" src="nano7g-ball-cyan.svg" />
+      <Text class="absolute left-[12] top-[10] text-xs text-slate-300">UI.PHYSICS ON A NANO</Text>
+      <Text class="absolute right-[12] top-[10] text-xs text-slate-300">{`HITS ${hits()}`}</Text>
+      <View class="absolute left-[12] top-[364] w-[84] h-[52] items-center justify-center rounded-xl bg-blue-600 active:bg-blue-800" focusable onPress={shake}>
+        <Text class="text-base font-bold text-white">Shake</Text>
+      </View>
+      <View class="absolute left-[104] top-[364] w-[84] h-[52] items-center justify-center rounded-xl bg-slate-600 active:bg-slate-700" focusable onPress={flip}>
+        <Text class="text-base font-bold text-white">{down() ? "Up" : "Down"}</Text>
+      </View>
+    </View>
+  );
+}
