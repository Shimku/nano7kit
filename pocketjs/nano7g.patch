+#define PN_LEAN_CUT (640u << 10)   /* at most this much under the full block */
+#define PN_LEAN_SLACK (16u << 10)  /* left in the OS block for its own use */
+#define PN_LEAN_KEEP_FREE (1536u << 10)
+
+static void drop_heap(void)
+{
+    if (HB_APP_AUX_BLOCK) {
+        hb_os_free(HB_APP_AUX_BLOCK);
+        HB_APP_AUX_BLOCK = 0;
+    }
+    s_heap = 0;
+    s_heap_len = 0;
+}
+
+/* One OS block for app `index`: exactly the heap it needs (measured ARM peak
+ * plus margin) plus the private stack. Taken only if the OS still has at
+ * least POCKETNANO_OS_KEEP_LARGEST in one block and POCKETNANO_OS_KEEP_FREE
+ * in all afterwards; checked after the allocation, because the block may
+ * come from somewhere other than the largest one. */
+static int grab_heap(uint32_t index)
+{
+    uint32_t want;
+    /* A cached relaunch keeps the last run's block registered: free it. */
+    drop_heap();
+    s_stack_len = POCKETNANO_BOOT_STACK + pocketnano_stack_extra(index);
+    want = (pocketnano_heap_need(index) + s_stack_len + 4095u) & ~4095u;
+    s_need = want;
+    s_seen_largest = hb_os_heap_largest();
+    s_seen_free = hb_os_heap_free();
+    s_lean = 0;
+    if (s_seen_largest < want) {
+        /* pocketjs15 lean mode: music or Bluetooth headphones split the OS's
+         * 4 MB block (2048 KB largest on the iPod, and neither pause nor stop
+         * gives it back). The heap figures carry a 256 to 512 KB margin over
+         * the measured peak, so take what there is, down to PN_LEAN_CUT
+         * below the full figure. The private stack keeps its size: QuickJS's
+         * stack limit is set from it. The app may still run out later: then
+         * its red screen says OUT OF MEMORY and a tap goes home. */
+        uint32_t floor_ = want > PN_LEAN_CUT ? want - PN_LEAN_CUT : want;
+        uint32_t room = s_seen_largest > PN_LEAN_SLACK ? (s_seen_largest - PN_LEAN_SLACK) & ~4095u : 0;
+        /* and leave the OS PN_LEAN_KEEP_FREE in all (the usual 2 MB less
+         * 512 KB: with music on, its buffers are already allocated). */
+        if (s_seen_free < PN_LEAN_KEEP_FREE + (64u << 10))
+            return 0;
+        if (room > s_seen_free - PN_LEAN_KEEP_FREE)
+            room = (s_seen_free - PN_LEAN_KEEP_FREE) & ~4095u;
+        if (room < floor_ || room <= s_stack_len + (256u << 10))
+            return 0;
+        want = room;
+        s_lean = 1;
+    }
+    s_heap = hb_os_alloc(want);
+    if (!s_heap)
+        return 0;
+    HB_APP_AUX_BLOCK = s_heap;
+    /* Lean mode leaves the OS half the usual largest block (512 KB) and
+     * 1.5 MB in all: its own allocations are small while a raw-surface app
+     * runs. A hardware test (pocketjs15). */
+    if (hb_os_heap_largest() < (s_lean ? POCKETNANO_OS_KEEP_LARGEST / 2 : POCKETNANO_OS_KEEP_LARGEST)
+        || hb_os_heap_free() < (s_lean ? PN_LEAN_KEEP_FREE : POCKETNANO_OS_KEEP_FREE)) {
+        pocketnano_log("PJTIGHT", hb_os_heap_free(), hb_os_heap_largest());
+        drop_heap();
+        return 0;
+    }
+    /* The private stack is the last POCKETNANO_BOOT_STACK bytes of the
+     * block; the Rust heap gets the rest.
+     *
+     * pocketjs17 (nano7kit rc5): the OS allocator only promises 4-byte
+     * alignment. A block 4 bytes past an 8-byte boundary (which one the OS
+     * hands out depends on what ran since boot) gave a private stack top
+     * that was not 8-byte aligned, against the AAPCS. The C guest's
+     * pocket_op_arg records (int64 and double inside, 8-byte aligned) then
+     * sat at 4 mod 8 on that stack, and pocket_runtime_op refused the first
+     * op with arguments: "createNode (status -2, 0 nodes made)". On the
+     * iPod JS QuickJS worked after a fresh boot and failed after any other
+     * app. The top is rounded down to 16 bytes; on_stack rounds again. */
+    s_heap_len = want - s_stack_len;
+    s_stack_lo = (uint32_t *)((char *)s_heap + s_heap_len);
+    s_stack_hi = (uint32_t *)(((uintptr_t)s_heap + want) & ~(uintptr_t)15u);
+    if (s_lean)
+        pocketnano_log("PJLEAN", want, s_need);
+    pocketnano_log("PJHEAP", want, s_seen_largest);
+    pocketnano_log("PJOS", hb_os_heap_free(), hb_os_heap_largest());
+    /* The block's and the stack top's offsets past 16 bytes (rc5: 4 or 12
+     * on the block is the case that used to fail; the top is always 0). */
+    pocketnano_log("PJALIGN", (uint32_t)(uintptr_t)s_heap & 15u, (uint32_t)(uintptr_t)s_stack_hi & 15u);
+    return 1;
+}
+
+static void no_memory(void)
+{
+    char a[40], b[40], *o;
+    o = put_s(a, "NEEDS ");
+    o = put_u(o, s_need / 1024u);
+    put_s(o, "K IN ONE BLOCK");
+    o = put_s(b, "FREE ");
+    o = put_u(o, s_seen_free / 1024u);
+    o = put_s(o, "K, LARGEST ");
+    o = put_u(o, s_seen_largest / 1024u);
+    put_s(o, "K");
+    pocketnano_log("PJNOMEM", s_need, s_seen_largest);
+    log_flush();
+    screen("NOT ENOUGH MEMORY", a, b, 0x7f1d1d);
+    if (s_home >= 0 && (int)s_index != s_home)
+        text(12, 120, "TAP TO GO BACK HOME", 1, 0xffffff);
+    else if (s_count > 1)
+        text(12, 120, "TAP FOR THE APP LIST", 1, 0xffffff);
+    if (s_seen_largest < (3072u << 10)) {
+        /* pocketjs15: the usual cause, and what helps (Free RAM on the iPod). */
+        text(12, 150, "MUSIC OR BLUETOOTH HOLDS THE", 1, 0xfecaca);
+        text(12, 164, "BIG BLOCK. PAUSE DOES NOT FREE", 1, 0xfecaca);
+        text(12, 178, "IT. DISCONNECT THE HEADPHONES,", 1, 0xfecaca);
+        text(12, 192, "OR REBOOT WITHOUT MUSIC", 1, 0xfecaca);
+        text(12, 206, "(HOME+SLEEP), THEN TRY AGAIN.", 1, 0xfecaca);
+    }
+}
+
+/* A QuickJS app whose package file is not on the volume. */
+static void no_package(const char *path)
+{
+    pocketnano_log("PJNOPKG", s_index, 0);
+    log_flush();
+    screen("PACKAGE MISSING", "COPY IN DISK MODE TO", path, 0x7f1d1d);
+    if (s_home >= 0)
+        text(12, 120, "TAP TO GO BACK HOME", 1, 0xffffff);
+    else if (s_count > 1)
+        text(12, 120, "TAP TO GO BACK TO THE MENU", 1, 0xffffff);
+}
+
+/* Rows are 46 px while they fit; a longer list shares the screen (40 px for 9). */
+static int menu_pitch(void)
+{
+    if (s_rows * PN_MENU_ROW + PN_MENU_TOP <= PN_MENU_END)
+        return PN_MENU_ROW;
+    return (PN_MENU_END - PN_MENU_TOP) / (int)s_rows;
+}
+
+static void draw_menu(void)
+{
+    uint32_t i;
+    hb_raw_fill(0x0f172a);
+    text(12, 16, POCKETNANO_TITLE, 2, 0xffffff);
+    text(12, 44, "TAP AN APP. HOME TO EXIT", 1, 0x94a3b8);
+    int pitch = menu_pitch(), h = pitch - 8;
+    for (i = 0; i < s_rows; i++) {
+        int y = PN_MENU_TOP + (int)i * pitch;
+        hb_raw_fill_rect(12, y, PN_W - 24, h, 0x1e293b);
+        hb_raw_fill_rect(12, y, 4, h, 0x0ea5e9);
+        const char *t = pocketnano_title(i);
+        uint32_t n = 0;
+        while (t[n]) n++;
+        if (n * 16u <= (uint32_t)(PN_W - 40))
+            text(26, y + (h - 16) / 2, t, 2, 0xf1f5f9);
+        else
+            text(26, y + (h - 8) / 2, t, 1, 0xf1f5f9);   /* long titles: small type */
+    }
+}
+
+static int menu_row(const hb_spoint_t *t)
+{
+    int row, pitch = menu_pitch();
+    if (t->x < 12 || t->x >= PN_W - 12 || t->y < PN_MENU_TOP)
+        return -1;
+    row = (t->y - PN_MENU_TOP) / pitch;
+    if (row >= (int)s_rows || (t->y - PN_MENU_TOP) % pitch >= pitch - 8)
+        return -1;
+    return row;
+}
+
+static void open_menu(void)
+{
+    s_state = PN_MENU;
+    s_menu_hit = -1;
+    s_wait_release = 1;
+    draw_menu();
+}
+
+/* Take app `index`'s block and boot it. `quiet`: from or to the home
+ * screen, so the last frame stays up while it loads (the home screen's
+ * zoom ends on the app's colour, the app's last frame leads back home).
+ * On failure the screen says why and a tap goes back. */
+static int start_app(uint32_t index, int quiet)
+{
+    s_index = index;
+    if (pocketnano_package(index) && !pocketnano_heap_need(index)) {
+        no_package(pocketnano_package(index));
+        s_state = PN_NOMEM;
+        s_wait_release = 1;
+        return 0;
+    }
+    if (!grab_heap(index)) {
+        no_memory();
+        s_state = PN_NOMEM;
+        s_wait_release = 1;
+        return 0;
+    }
+    s_quiet = quiet;
+    s_fail_text[0] = 0;
+    s_fail_code = s_fail_line = 0;
+    if (!quiet)
+        screen("LOADING", pocketnano_title(index), 0, 0x0f172a);
+    s_state = PN_BOOT;
+    s_ticked = 0;
+    s_down_seen = 0;
+    return 1;
+}
+
+/* Back to the home screen (or the list without one). */
+static void go_back(void)
+{
+    if (s_home >= 0 && start_app((uint32_t)s_home, 1))
+        return;
+    if (s_home >= 0 && s_state == PN_NOMEM)
+        return;     /* the home screen itself does not fit: say so */
+    open_menu();
+}
+
+void hb_raw_init(int w, int h)
+{
+    s_fb = hb_raw_fb();
+    s_state = PN_FAILED;
+    hb_trace_init();
+    log_open();
+    s_fail_text[0] = 0;
+    if (w != PN_W || h != PN_H) {
+        screen("UNEXPECTED SCREEN SIZE", 0, 0, 0x7f1d1d);
+        return;
+    }
+    /* A cached relaunch keeps the last run's block registered: free it. */
+    drop_heap();
+    s_boot_stack = !hb_fs_exists(PN_NO_STACK_FLAG);
+    s_count = pocketnano_count();
+    s_rows = pocketnano_menu_count();
+    s_index = 0;
+    s_home = -1;
+    s_launch = -1;
+    s_from[0] = 0;
+    {
+        int h = pocketnano_find("home", 4);
+        /* The home screen when its package is on the volume. */
+        if (h >= 0 && pocketnano_heap_need((uint32_t)h) != 0)
+            s_home = h;
+    }
+#ifdef POCKETNANO_QUICKJS
+    /* bit 8: the QuickJS library (JS Samples can have as many rows) */
+    pocketnano_log("PJOPEN", s_rows | 0x100u, s_boot_stack);
+#else
+    pocketnano_log("PJOPEN", s_rows, s_boot_stack);
+#endif
+    if (s_home >= 0)
+        pocketnano_log("PJHOME", (uint32_t)s_home, s_count);
+    log_flush();
+    if (s_home >= 0) {
+        hb_raw_fill(0x000000);
+        if (start_app((uint32_t)s_home, 1))
+            return;
+        if (s_state == PN_NOMEM)
+            return;
+    }
+    if (s_count > 1) {
+        /* The menu needs no heap: each app's block is taken when it is
+         * picked and given back when it returns to the menu. */
+        open_menu();
+        s_wait_release = 0;
+        return;
+    }
+    if (pocketnano_package(0) && !pocketnano_heap_need(0)) {
+        no_package(pocketnano_package(0));
+        return;
+    }
+    if (!grab_heap(0)) {
+        no_memory();
+        return;
+    }
+    screen("LOADING", 0, 0, 0x0f172a);
+    s_state = PN_BOOT;
+}
+
+static uint32_t buttons(void)
+{
+    uint32_t b = 0;
+    if (hb_button_pressed(HB_BTN_VOL_UP)) b |= PN_BTN_UP;
+    if (hb_button_pressed(HB_BTN_VOL_DOWN)) b |= PN_BTN_DOWN;
+    return b;
+}
+
+/* ---- The other fingers (multi-touch) ----
+ *
+ * The OS keeps one small queue per finger (8 heads, 0x18 bytes apart, the
+ * SDK's hb_touch_poll_multi layout); its own touch task consumes them too,
+ * so a sample can be there for one heartbeat and gone the next. On the
+ * iPod (pocketjs11) a second finger showed up for a split second only. So
+ * this does not trust one snapshot a frame:
+ *
+ *   - every queued sample is read (oldest first), not only the newest, and
+ *     the newest of each queue is remembered, so a sample is used once and
+ *     a stale one left behind is not taken for a new touch;
+ *   - a contact (queue, OS touch id) lives until its queue says it lifted,
+ *     or it has had no new sample for PN_TRACK_HOLD_US while its queue no
+ *     longer shows it; all contacts end when the resident's point lifts
+ *     (that point decides when a touch starts and ends);
+ *   - which status means "lifted" is learned from the first queue when the
+ *     resident's point lifts (the SDK headers disagree: 1, or 2), and logged
+ *     once as PJTUP;
+ *   - the resident's own finger is left out: the contact nearest its point
+ *     (and any other within PN_TRACK_SAME px of it).
+ *
+ * Raw samples go to the log file as PJTRAW lines (queue, status, id, x, y;
+ * at most PN_TRAW_MAX per app run) and every 10 s a PJTOUCH summary goes to
+ * the trace ring, so the next hardware test shows what the panel sent. */
+#define PN_TOUCH_BASE 0x089a5298u
+#define PN_TOUCH_STRIDE 0x18u
+#define PN_TOUCH_LISTS 8
+#define PN_TRACK 8
+#define PN_TRACK_HOLD_US 600000u
+#define PN_TRACK_SAME 24
+#define PN_TRAW_MAX 60u
+
+typedef struct {
+    uint8_t live, list, status;
+    uint16_t id;
+    int16_t x, y;
+    uint32_t seen_us;
+} pn_track_t;
+
+static pn_track_t s_track[PN_TRACK];
+static uint32_t s_q_node[PN_TOUCH_LISTS], s_q_sig[PN_TOUCH_LISTS];
+/* touch-snapshot: a lifted finger's status. No longer learned: the iPod logs
+ * (3 Nov, pj-touch-diag) show land 0, move 2, lift 1 on every queue, the rule
+ * the launcher latch and Mario 64 use. Learning it from the first lift could
+ * pick a wrong sample, and the value outlived the sub-app that learned it. */
+static int s_up_status = 1;
+static int s_was_down, s_lift_frames;
+static uint32_t s_down_mask;     /* statuses the first queue sent during this stroke */
+static uint32_t s_traw_lines;
+/* Diagnostic (pj-touch-diag): why contacts ended (PJTKILL), and the raw
+ * queues in the first PN_TD_MAX frames that hold a second finger (PJTQ, one
+ * line per non-empty queue) with what reached the app (PJTF). */
+static uint32_t s_tk_status, s_tk_ended, s_tk_hold, s_tk_mb, s_tk_lines;
+static uint32_t s_td_frames;
+static int s_td_this, s_td_any;
+#define PN_TD_MAX 12u
+/* PJTOUCH window: queues that sent samples, statuses seen, most extra
+ * contacts at once, samples on queues 1 to 7, distinct ids on queue 0. */
+static uint32_t s_tw_lists, s_tw_status, s_tw_extra, s_tw_samples, s_tw_ids;
+static uint16_t s_tw_last_id0 = 0xffff;
+
+static int pn_ram(uint32_t a) { return a >= 0x08000000u && a < 0x10000000u; }
+
+static void pn_log_raw(const char *tag, uint32_t v1, uint32_t v2);
+
+static pn_track_t *track_find(uint32_t list, uint32_t id)
+{
+    int i;
+    for (i = 0; i < PN_TRACK; i++)
+        if (s_track[i].live && s_track[i].list == list && s_track[i].id == (uint16_t)id)
+            return &s_track[i];
+    return 0;
+}
+
+static void track_sample(uint32_t list, uint32_t id, uint32_t status, int x, int y, uint32_t now)
+{
+    pn_track_t *t = track_find(list, id);
+    s_tw_lists |= 1u << list;
+    s_tw_status |= 1u << (status & 7);
+    if (list) {
+        s_tw_samples++;
+    } else if ((uint16_t)id != s_tw_last_id0) {
+        s_tw_last_id0 = (uint16_t)id;
+        s_tw_ids++;
+    }
+    if ((list || !t) && s_traw_lines < PN_TRAW_MAX) {
+        s_traw_lines++;
+        pn_log_raw("PJTRAW", list << 24 | (status & 0xffu) << 16 | (id & 0xffffu),
+                   (uint32_t)(x & 0xffff) << 16 | (uint32_t)(y & 0xffff));
+    }
+    if (s_up_status >= 0 && (int)status == s_up_status) {
+        if (t) {
+            s_tk_status += t->live;
+            t->live = 0;
+        }
+        return;
+    }
+    if (!t) {
+        int i;
+        for (i = 0; i < PN_TRACK && s_track[i].live; i++) {}
+        if (i == PN_TRACK)
+            return;
+        t = &s_track[i];
+        t->live = 1;
+        t->list = (uint8_t)list;
+        t->id = (uint16_t)id;
+    }
+    t->status = (uint8_t)status;
+    t->x = (int16_t)x;
+    t->y = (int16_t)y;
+    t->seen_us = now;
+}
+
+/* Read every queue: new samples update the contacts; returns the queues'
+ * newest statuses (one byte each, 0xff for empty) in present[]. */
+static uint8_t s_q_stream[PN_TOUCH_LISTS], s_q_ended[PN_TOUCH_LISTS];
+static uint32_t s_q_last_id[PN_TOUCH_LISTS], s_q_last_xy[PN_TOUCH_LISTS];
+static uint32_t s_fed_sig[PN_TOUCH_LISTS];   /* the last sample given to track_sample, per queue */
+static uint32_t s_src_queue, s_src_snap;      /* second-finger samples: from a queue poll, from the snapshot */
+
+static uint32_t pn_sig(uint32_t id, uint32_t st, int32_t x, int32_t y)
+{
+    return id * 2654435761u ^ st << 24 ^ (uint32_t)(x & 0xfff) << 12 ^ (uint32_t)(y & 0xfff);
+}
+
+/* touch-snapshot: the launcher copies every queue's newest sample at each touch
+ * event, before the OS drains the queues, into a block right after hb_shared
+ * (nanoapps/system/silver_resident_na/touch_latch.h, hb_touch_snap_t). Polling
+ * the queues from a frame races that drain: in the 3 Nov logs whole Gestures
+ * runs saw no queue sample at all (no PJTRAW, no second finger) while others saw
+ * one every frame. Older launchers have no snapshot (magic differs): then only
+ * the queue poll runs, as before. */
+#define PN_SNAP_MAGIC 0x504e5354u
+typedef struct {
+    uint32_t magic;
+    volatile uint32_t seq;
+    volatile int32_t finger[PN_TOUCH_LISTS][4];   /* id, status (0xff: empty), x, y */
+} pn_snap_t;
+static uint32_t s_snap_seq;
+
+static volatile pn_snap_t *pn_snap(void)
+{
+    volatile pn_snap_t *sp;
+    if (!hb_shared)
+        return 0;
+    sp = (volatile pn_snap_t *)((char *)hb_shared + sizeof(hb_shared_t));
+    return sp->magic == PN_SNAP_MAGIC ? sp : 0;
+}
+
+static void track_sample(uint32_t list, uint32_t id, uint32_t status, int x, int y, uint32_t now);
+
+/* After the queue poll: feed each queue's snapshot sample once (the same
+ * sample read from the queue is not fed twice), and let it count as present. */
+static void read_snapshot(uint32_t now, uint8_t present_status[PN_TOUCH_LISTS],
+                          uint16_t present_id[PN_TOUCH_LISTS])
+{
+    volatile pn_snap_t *sp = pn_snap();
+    uint32_t q, seq;
+    if (!sp)
+        return;
+    seq = sp->seq;
+    if (seq == s_snap_seq)
+        return;
+    s_snap_seq = seq;
+    for (q = 0; q < PN_TOUCH_LISTS; q++) {
+        uint32_t id = (uint32_t)sp->finger[q][0], st = (uint32_t)sp->finger[q][1] & 0xffu, sig;
+        int32_t x = sp->finger[q][2], y = sp->finger[q][3];
+        if (st == 0xffu)
+            continue;
+        s_q_ended[q] = 0;
+        if (present_status[q] == 0xff) {
+            present_status[q] = (uint8_t)st;
+            present_id[q] = (uint16_t)id;
+        }
+        sig = pn_sig(id, st, x, y);
+        if (sig == s_fed_sig[q])
+            continue;
+        s_fed_sig[q] = sig;
+        if (q)
+            s_src_snap++;
+        track_sample(q, id, st, (int16_t)x, (int16_t)y, now);
+    }
+}
+
+static void read_queues(uint32_t now, int learn, uint8_t present_status[PN_TOUCH_LISTS],
+                        uint16_t present_id[PN_TOUCH_LISTS])
+{
+    uint32_t q;
+    for (q = 0; q < PN_TOUCH_LISTS; q++) {
+        volatile uint32_t *head = (volatile uint32_t *)(PN_TOUCH_BASE + q * PN_TOUCH_STRIDE);
+        uint32_t nodes[16], sigs[16];
+        uint32_t end = head[4], node, n = 0, i, from = 0;
+        present_status[q] = 0xff;
+        s_q_ended[q] = 0;
+        if (head[5] == 0 || !pn_ram(end)) {
+            /* A streaming queue (it repeats a still finger's sample every
+             * frame) that is now empty: that finger lifted, no need to
+             * wait PN_TRACK_HOLD_US. A sparse queue (samples only on
+             * change) never repeats, so its emptiness means nothing. */
+            s_q_ended[q] = s_q_stream[q];
+            continue;
+        }
+        node = *(volatile uint32_t *)end;
+        while (node != end && pn_ram(node) && n < 16) {
+            volatile int32_t *v = (volatile int32_t *)(node + 8);
+            uint8_t st = *((volatile uint8_t *)(node + 8) + 4);
+            nodes[n] = node;
+            sigs[n] = pn_sig((uint32_t)v[0], st, v[2], v[3]);
+            n++;
+            node = *(volatile uint32_t *)node;
+        }
+        if (!n) {
+            s_q_ended[q] = s_q_stream[q];
+            continue;
+        }
+        for (i = 0; i < n; i++)
+            if (nodes[i] == s_q_node[q] && sigs[i] == s_q_sig[q])
+                from = i + 1;
+        if (from < n && from > 0) {
+            volatile int32_t *a = (volatile int32_t *)(nodes[from - 1] + 8);
+            volatile int32_t *b = (volatile int32_t *)(nodes[from] + 8);
+            if (a[0] == b[0] && a[2] == b[2] && a[3] == b[3])
+                { if (!s_q_stream[q]) pocketnano_log("PJTSTR", q, now / 1000u); s_q_stream[q] = 1; }
+        } else if (from == 0 && s_q_node[q] && nodes[0] != s_q_node[q]) {
+            volatile int32_t *b = (volatile int32_t *)(nodes[n - 1] + 8);
+            if ((uint32_t)b[0] == s_q_last_id[q] && (uint32_t)(b[2] << 16 | (b[3] & 0xffff)) == s_q_last_xy[q])
+                { if (!s_q_stream[q]) pocketnano_log("PJTSTR", q, now / 1000u); s_q_stream[q] = 1; }   /* a fresh node with the same sample */
+        }
+        for (i = from; i < n; i++) {
+            volatile int32_t *v = (volatile int32_t *)(nodes[i] + 8);
+            uint32_t st = *((volatile uint8_t *)(nodes[i] + 8) + 4);
+            if (q == 0 && !learn)
+                s_down_mask |= 1u << (st & 31);
+            s_fed_sig[q] = sigs[i];
+            if (q)
+                s_src_queue++;
+            track_sample(q, (uint32_t)v[0], st, (int16_t)v[2], (int16_t)v[3], now);
+        }
+        s_q_node[q] = nodes[n - 1];
+        s_q_sig[q] = sigs[n - 1];
+        {
+            volatile int32_t *v = (volatile int32_t *)(nodes[n - 1] + 8);
+            s_q_last_id[q] = (uint32_t)v[0];
+            s_q_last_xy[q] = (uint32_t)(v[2] << 16 | (v[3] & 0xffff));
+            present_status[q] = *((volatile uint8_t *)(nodes[n - 1] + 8) + 4);
+            present_id[q] = (uint16_t)v[0];
+        }
+    }
+}
+
+static uint8_t s_present_status[PN_TOUCH_LISTS];
+static uint16_t s_present_id[PN_TOUCH_LISTS];
+
+/* pj-touch-diag: while the resident's point is down, a frame whose queues
+ * hold a second finger (a sample on queue 1..7, or two ids on queue 0) is
+ * logged as PJTQ lines: v1 = frame<<24 | queue<<20 | nodes<<16 | the first
+ * four statuses (4 bits each, oldest first); v2 = newest id<<24 | x<<12 | y. */
+static void dump_queues(void)
+{
+    uint32_t q, lines[PN_TOUCH_LISTS], v2s[PN_TOUCH_LISTS], nq = 0, i;
+    uint32_t id0 = 0xffffffffu;
+    int two = 0;
+    for (q = 0; q < PN_TOUCH_LISTS; q++) {
+        volatile uint32_t *head = (volatile uint32_t *)(PN_TOUCH_BASE + q * PN_TOUCH_STRIDE);
+        uint32_t end = head[4], node, last = 0, n = 0, packed = 0;
+        if (head[5] == 0 || !pn_ram(end))
+            continue;
+        node = *(volatile uint32_t *)end;
+        while (node != end && pn_ram(node) && n < 16) {
+            volatile int32_t *v = (volatile int32_t *)(node + 8);
+            uint32_t st = *((volatile uint8_t *)(node + 8) + 4);
+            if (n < 4)
+                packed |= (st & 15u) << (12 - 4 * n);
+            if (q == 0) {
+                if (id0 == 0xffffffffu)
+                    id0 = (uint32_t)v[0];
+                else if ((uint32_t)v[0] != id0)
+                    two = 1;
+            }
+            last = node;
+            n++;
+            node = *(volatile uint32_t *)node;
+        }
+        if (!n)
+            continue;
+        if (q)
+            two = 1;
+        {
+            volatile int32_t *v = (volatile int32_t *)(last + 8);
+            lines[nq] = q << 20 | (n & 15u) << 16 | packed;
+            v2s[nq] = ((uint32_t)v[0] & 0xffu) << 24 | ((uint32_t)v[2] & 0xfffu) << 12 | ((uint32_t)v[3] & 0xfffu);
+            nq++;
+        }
+    }
+    if (!two)
+        return;
+    s_td_frames++;
+    s_td_this = 1;
+    s_td_any = 1;
+    for (i = 0; i < nq; i++)
+        pn_log_raw("PJTQ", s_td_frames << 24 | lines[i], v2s[i]);
+}
+
+/* touch-snapshot: each sub-app run starts with a clean tracker and fresh
+ * diagnostic budgets (these statics outlive a run: Home and Gestures share
+ * one JS QuickJS image). */
+static void pn_touch_reset(void)
+{
+    uint32_t i;
+    for (i = 0; i < PN_TRACK; i++)
+        s_track[i].live = 0;
+    for (i = 0; i < PN_TOUCH_LISTS; i++) {
+        s_q_node[i] = s_q_sig[i] = s_fed_sig[i] = 0;
+        s_q_stream[i] = s_q_ended[i] = 0;
+    }
+    s_td_frames = 0;
+    s_td_any = 0;
+    s_tk_status = s_tk_ended = s_tk_hold = s_tk_mb = s_tk_lines = 0;
+    s_traw_lines = 0;
+    s_src_queue = s_src_snap = 0;
+}
+
+/* Every frame in every state (menu and loading too): read the queues and
+ * learn the lift status from the first queue just after a lift, so the
+ * first chord in an app already knows it. */
+static void touch_poll(const hb_spoint_t *touch)
+{
+    uint32_t now = hb_time_uptime_us();
+    int i;
+    /* Just lifted (three frames, for a late sample): the first queue's
+     * newest status, if it never came while the finger was down, names
+     * "lifted". */
+    if (touch->down && !s_was_down)
+        s_down_mask = 0;
+    if (!touch->down && s_was_down)
+        s_lift_frames = 3;
+    s_td_this = 0;
+    if (touch->down && s_td_frames < PN_TD_MAX)
+        dump_queues();
+    read_queues(now, !touch->down && s_lift_frames > 0, s_present_status, s_present_id);
+    read_snapshot(now, s_present_status, s_present_id);
+    hb_touch_drain_all();   /* every frame, up or down, as Mario 64 does: a queue nobody pops keeps old samples in front */
+    if (s_lift_frames > 0 && !touch->down)
+        s_lift_frames--;
+    if (!touch->down && s_was_down) {
+        for (i = 0; i < PN_TRACK; i++)
+            s_tk_mb += s_track[i].live;
+        if (s_td_any && s_tk_lines < 20u) {
+            /* a stroke with a second finger ended: why its contacts ended, and
+             * the lift status learned so far (-1: not yet) */
+            s_tk_lines++;
+            pocketnano_log("PJTKILL", s_tk_status << 16 | (s_tk_ended & 0xffffu), s_tk_hold << 16 | (s_tk_mb & 0xffffu));
+            pocketnano_log("PJTUPV", (uint32_t)s_up_status, s_down_mask);
+            pocketnano_log("PJTSRC", s_src_queue, s_src_snap);
+            if (s_tk_lines <= 5u)
+                pocketnano_log_soon();
+        }
+        s_td_any = 0;
+    }
+    s_was_down = touch->down;
+    if (!touch->down)
+        for (i = 0; i < PN_TRACK; i++)
+            s_track[i].live = 0;
+}
+
+static void read_fingers(const hb_spoint_t *touch)
+{
+    int32_t out[4 * 3];
+    const uint8_t *present_status = s_present_status;
+    const uint16_t *present_id = s_present_id;
+    uint32_t now = hb_time_uptime_us(), slots = 0;
+    int i, k = 0, nearest = -1, extra = 0;
+    int32_t best = 0x7fffffff;
+    if (!touch->down) {
+        pocketnano_fingers(out, 0);
+        return;
+    }
+    hb_touch_drain_all();   /* keep the queues moving, as before */
+    for (i = 0; i < PN_TRACK; i++) {
+        pn_track_t *t = &s_track[i];
+        int32_t dx, dy, d;
+        if (!t->live)
+            continue;
+        if (s_q_ended[t->list] && t->list != 0) {
+            s_tk_ended++;
+            t->live = 0;
+            continue;
+        }
+        if (now - t->seen_us > PN_TRACK_HOLD_US
+            && !(present_status[t->list] != 0xff && present_id[t->list] == t->id
+                 && (int)present_status[t->list] != s_up_status)) {
+            s_tk_hold++;
+            t->live = 0;
+            continue;
+        }
+        dx = t->x - touch->x;
+        dy = t->y - touch->y;
+        d = dx * dx + dy * dy;
+        if (d < best) {
+            best = d;
+            nearest = i;
+        }
+    }
+    for (i = 0; i < PN_TRACK && k < 4; i++) {
+        pn_track_t *t = &s_track[i];
+        int32_t dx, dy, j, dup = 0;
+        if (!t->live || i == nearest)
+            continue;
+        dx = t->x - touch->x;
+        dy = t->y - touch->y;
+        if (dx * dx + dy * dy < PN_TRACK_SAME * PN_TRACK_SAME)
+            continue;
+        /* The same finger in two queues: keep the first. */
+        for (j = 0; j < k; j++) {
+            int32_t ex = out[j * 3 + 1] - t->x, ey = out[j * 3 + 2] - t->y;
+            if (ex * ex + ey * ey < PN_TRACK_SAME * PN_TRACK_SAME)
+                dup = 1;
+        }
+        if (dup)
+            continue;
+        out[k * 3] = i;
+        out[k * 3 + 1] = t->x;
+        out[k * 3 + 2] = t->y;
+        slots |= 1u << i;
+        k++;
+    }
+    extra = k;
+    if ((uint32_t)extra > s_tw_extra)
+        s_tw_extra = (uint32_t)extra;
+    if ((uint32_t)(k + 1) > s_fingers_max) {
+        s_fingers_max = (uint32_t)(k + 1);
+        pocketnano_log("PJFING", (uint32_t)(k + 1), slots << 1 | 1u);
+    }
+    if (s_td_this) {
+        int live = 0;
+        for (i = 0; i < PN_TRACK; i++)
+            live += s_track[i].live;
+        pn_log_raw("PJTF", s_td_frames << 24 | (uint32_t)live << 8 | (uint32_t)k,
+                   ((uint32_t)touch->x & 0xfffu) << 12 | ((uint32_t)touch->y & 0xfffu));
+    }
+    pocketnano_fingers(out, k);
+}
+
+/* Core retained-memory counters (Ui::memory_counters): PJNODES slots and
+ * live nodes, PJNODEB node size and arena bytes, PJLAYN layout nodes and
+ * style records, PJTEXN texture slots and live bytes, PJTXTC cached text
+ * layouts and bytes, PJGLYA glyph pages and anim tracks, PJTEXR retained. */
+static void pocketnano_counters(void)
+{
+    pocketnano_log("PJNODES", pocketnano_counter(0), pocketnano_counter(1));
+    pocketnano_log("PJNODEB", pocketnano_counter(2), pocketnano_counter(13));
+    pocketnano_log("PJLAYN", pocketnano_counter(3), pocketnano_counter(11));
+    pocketnano_log("PJTEXN", pocketnano_counter(4), pocketnano_counter(5));
+    pocketnano_log("PJTXTC", pocketnano_counter(7), pocketnano_counter(8));
+    pocketnano_log("PJGLYA", pocketnano_counter(9), pocketnano_counter(10));
+    pocketnano_log("PJTEXR", pocketnano_counter(12), pocketnano_counter(6));
+}
+
+/* Every 10 s with PJFPS, if any queue sent samples: what the panel did. */
+static void touch_summary(void)
+{
+    if (!s_tw_lists)
+        return;
+    pocketnano_log("PJTOUCH", s_tw_lists | (s_tw_status & 0xffu) << 8 | (s_tw_extra & 0xffu) << 16,
+                   (s_tw_samples & 0xffffu) | (s_tw_ids > 0xffffu ? 0xffffu : s_tw_ids) << 16);
+    s_tw_lists = s_tw_status = s_tw_extra = s_tw_samples = s_tw_ids = 0;
+}
+
+static void opaque(const int32_t *rects, int n)
+{
+    int i, x, y;
+    for (i = 0; i < n; i++) {
+        int x0 = rects[i * 4], y0 = rects[i * 4 + 1];
+        int x1 = x0 + rects[i * 4 + 2], y1 = y0 + rects[i * 4 + 3];
+        if (x0 < 0) x0 = 0;
+        if (y0 < 0) y0 = 0;
+        if (x1 > PN_W) x1 = PN_W;
+        if (y1 > PN_H) y1 = PN_H;
+        for (y = y0; y < y1; y++) {
+            uint32_t *row = s_fb + y * PN_W;
+            for (x = x0; x < x1; x++) row[x] |= 0xff000000u;
+        }
+    }
+}
+
+static int s_exit_hook;
+
+__attribute__((noinline))
+static void guarded(const hb_spoint_t *touch, uint32_t now)
+{
+    int32_t rects[PN_MAX_REGIONS * 4];
+    int32_t accel[3] = { 0, 0, 0 };
+    int n;
+    if (__builtin_setjmp(s_jump)) {
+        int booting = s_state == PN_BOOT || s_state == PN_LOAD;
+        s_state = PN_FAILED;
+        show_failure();
+        if (booting && s_home >= 0 && (int)s_index == s_home && s_home_retries < 2)
+            s_retry_home = 1;
+        return;
+    }
+#ifdef POCKETNANO_QUICKJS
+    if (s_exit_hook) {
+        /* The menu key: nano.onexit() (Notes saves), guarded like a frame. */
+        extern void pocketqjs_exit_hook(void);
+        pocketqjs_exit_hook();
+        return;
+    }
+#endif
+    if (s_state == PN_BOOT) {
+        uint32_t here = (uint32_t)__builtin_frame_address(0);
+        pocketnano_log("PJBOOT", s_index, here);
+        boot();
+        s_state = PN_LOAD;
+        s_load_step = 0;
+    }
+    if (s_state == PN_LOAD) {
+        /* QuickJS apps boot over several heartbeats (read the files, make
+         * the realm, run the bundle); each step's time goes to the trace. */
+        uint32_t t_step = hb_time_uptime_us(), step = pocketnano_boot_step();
+        if (step != 2)
+            pocketnano_log("PJSTEP", ++s_load_step, hb_time_uptime_us() - t_step);
+        if (step == 0 && s_quiet)
+            return;
+        if (step == 0) {
+            char line[24], *o = put_s(line, "STEP ");
+            o = put_u(o, s_load_step + 1);
+            put_s(o, " OF 3");
+            screen("LOADING", pocketnano_title(s_index), line, 0x0f172a);
+            return;
+        }
+        s_state = PN_RUN;
+        if ((int)s_index == s_home)
+            s_home_retries = 0;
+        s_trace_peak = 0;
+        s_fingers_max = 1;
+        pn_touch_reset();
+        pocketnano_log("PJTSNAP", pn_snap() ? 1u : 0u, s_snap_seq);
+        s_win_start = s_run_start = hb_time_uptime_us();
+        s_win_ticks = s_win_slowest = s_run_ticks = 0;
+        pocketnano_log("PJLIVE", pocketnano_heap_used(), pocketnano_heap_peak());
+#ifdef POCKETNANO_QUICKJS
+        {
+            extern uint32_t pocketqjs_js_bytes(void);
+            extern void pocketqjs_collect(void);
+            uint32_t before = pocketqjs_js_bytes();
+            /* Boot leaves the parser's garbage: collect it once. */
+            pocketqjs_collect();
+            pocketnano_log("PJQJS", before, pocketqjs_js_bytes());
+            pocketnano_log("PJGC", pocketnano_heap_used(), pocketnano_heap_peak());
+        }
+#endif
+        if (s_boot_stack)
+            pocketnano_log("PJSTK", stack_used(), s_stack_len);
+#ifdef POCKETNANO_QUICKJS
+        {
+            extern uint32_t pocketqjs_bytecode_used(void);
+            if (step == 1)
+                pocketnano_log("PJBC", pocketqjs_bytecode_used(), s_index);
+        }
+#endif
+        if (step == 1)
+            return;   /* the first frame gets its own heartbeat */
+    }
+    if (pocketnano_motion()) {
+        hb_accel_read_raw(accel);
+        s_accel[0] = accel[0];
+        s_accel[1] = accel[1];
+        s_accel[2] = accel[2];
+    }
+    read_fingers(touch);
+    n = pocketnano_frame(buttons(), touch->x, touch->y, touch->down, accel, now, rects);
+    opaque(rects, n);
+}
+
+static hb_spoint_t s_g_touch;
+static uint32_t s_g_now;
+
+static void guarded_entry(void) { guarded(&s_g_touch, s_g_now); }
+
+/* Boot and frames go through here: on the private stack unless the flag
+ * file turned it off. Only the shim's own frames sit on the OS stack. */
+static void run_core(const hb_spoint_t *touch, uint32_t now)
+{
+    if (!s_boot_stack) {
+        guarded(touch, now);
+        return;
+    }
+    if (s_state == PN_BOOT) {
+        uint32_t *p;
+        for (p = s_stack_lo; p < s_stack_hi; p++) *p = PN_STACK_FILL;
+    }
+    s_g_touch = *touch;
+    s_g_now = now;
+    on_stack(guarded_entry, s_stack_hi);
+}
+
+static void menu_frame(const hb_spoint_t *t)
+{
+    if (s_wait_release) {
+        if (!t->down)
+            s_wait_release = 0;
+        return;
+    }
+    if (t->down) {
+        if (s_menu_hit < 0)
+            s_menu_hit = menu_row(t);
+        return;
+    }
+    if (s_menu_hit >= 0) {
+        uint32_t row = (uint32_t)s_menu_hit;
+        s_menu_hit = -1;
+        start_app(row, 0);
+    }
+}
+
+void hb_raw_frame(const hb_spoint_t *touch)
+{
+    uint32_t t0, dt, peak;
+    hb_spoint_t t;
+    if (s_state == PN_FAILED && s_retry_home) {
+        /* Home stopped while booting (pocketjs14: an intermittent createNode
+         * refusal): the reason is in the log; boot it again in a fresh block. */
+        s_retry_home = 0;
+        s_home_retries++;
+        pocketnano_log("PJRETRY", (uint32_t)s_home, (uint32_t)s_home_retries);
+        log_flush();
+        drop_heap();
+        s_from[0] = 0;
+        if (start_app((uint32_t)s_home, 1))
+            return;
+        if (s_state != PN_NOMEM)
+            open_menu();
+        return;
+    }
+    if (s_state == PN_FAILED) {
+        /* With a home screen, a tap after the message goes back home: the
+         * failed app's block goes whole, the home screen gets a fresh one.
+         * pocketjs15: Home itself retries on a tap too. */
+        if (s_home >= 0) {
+            /* Only a fresh tap, 2 s on: the finger that was typing when the
+             * app stopped must not wipe the message (pocketjs13 Notes). */
+            if (!touch->down)
+                s_fail_armed = 1;
+            if (touch->down) {
+                if (s_fail_armed && hb_time_uptime_us() - s_fail_at > 2000000u)
+                    s_wait_release = 2;
+            } else if (s_wait_release == 2) {
+                s_wait_release = 0;
+                drop_heap();
+                s_from[0] = 0;
+                go_back();
+            }
+        }
+        return;
+    }
+    touch_poll(touch);
+    if (s_state == PN_MENU) {
+        menu_frame(touch);
+        return;
+    }
+    if (s_state == PN_NOMEM) {
+        /* A tap (press and release) goes back to the menu. */
+        if (touch->down)
+            s_wait_release = 0;
+        else if (!s_wait_release) {
+            if (s_home >= 0 && (int)s_index != s_home)
+                go_back();
+            else
+                open_menu();
+        }
+        return;
+    }
+    /* Remember a touch-down between ticks so a quick tap still lands. */
+    if (touch->down) {
+        s_down_at = *touch;
+        s_down_seen = 1;
+    }
+    t0 = hb_time_uptime_us();
+    if (s_ticked && (int32_t)(t0 - s_next_us) < -(int32_t)PN_EARLY_US)
+        return;
+    if (!s_ticked || (int32_t)(t0 - s_next_us) > (int32_t)PN_PERIOD_US)
+        s_next_us = t0 + PN_PERIOD_US;
+    else
+        s_next_us += PN_PERIOD_US;
+    s_ticked = 1;
+    t = touch->down ? *touch : (s_down_seen ? s_down_at : *touch);
+    s_down_seen = 0;
+    run_core(&t, t0);
+    dt = hb_time_uptime_us() - t0;
+    if (s_boot_stack && s_state != PN_FAILED && !stack_guard_ok()) {
+        /* The private stack reached its last 256 bytes: below is the heap,
+         * so stop now, with a reason, instead of a fault later. */
+        pocketnano_log("PJSTKX", stack_used(), s_stack_len);
+        s_fail_code = 7;
+        s_fail_line = stack_used();
+        put_s(s_fail_text, "PRIVATE STACK FULL (C RECURSION)");
+        s_state = PN_FAILED;
+        show_failure();
+        return;
+    }
+    s_frames++;
+    if (s_state != PN_RUN)
+        return;
+    if (pocketnano_wants_menu()) {
+        uint32_t left;
+        s_exit_hook = 1;
+        run_core(&t, hb_time_uptime_us());
+        s_exit_hook = 0;
+        if (s_state == PN_FAILED)
+            return;
+        if (s_boot_stack)
+            pocketnano_log("PJSTK", stack_used(), s_stack_len);
+        pocketnano_log("PJEND", s_run_ticks, (hb_time_uptime_us() - s_run_start) / 1000u);
+        left = pocketnano_stop();
+        pocketnano_log("PJFREE", left, pocketnano_heap_peak());
+        log_flush();
+        drop_heap();
+        if (s_home >= 0 && (int)s_index != s_home) {
+            const char *k = pocketnano_key(s_index);
+            uint32_t i;
+            for (i = 0; k[i] && i < sizeof s_from - 1; i++) s_from[i] = k[i];
+            s_from[i] = 0;
+            go_back();
+            return;
+        }
+        open_menu();
+        return;
+    }
+    if (s_launch >= 0) {
+        /* The home screen asked for an app: its zoom has ended on the
+         * app's colour, which stays up while the app loads. */
+        uint32_t left, next = (uint32_t)s_launch;
+        s_launch = -1;
+        pocketnano_log("PJEND", s_run_ticks, (hb_time_uptime_us() - s_run_start) / 1000u);
+        left = pocketnano_stop();
+        pocketnano_log("PJFREE", left, pocketnano_heap_peak());
+        log_flush();
+        drop_heap();
+        s_from[0] = 0;
+        if (!start_app(next, 1) && s_state != PN_NOMEM)
+            go_back();
+        return;
+    }
+    /* The log file: after the first frame (boot lines), when asked (a save,
+     * a peak), else every 30 s when dirty. A slow write leaves its own line. */
+    if (s_run_ticks == 0 || s_log_soon || (int32_t)(t0 - s_log_flush_at) >= (int32_t)PN_FLUSH_US) {
+        log_flush();
+        if (s_log_write_us > 40000u) {
+            pocketnano_log("PJLOGW", s_log_write_us, s_log_len);
+            s_log_write_us = 0;
+        }
+    }
+    s_run_ticks++;
+    s_win_ticks++;
+    if (dt > s_win_slowest)
+        s_win_slowest = dt;
+    if ((int32_t)(t0 - s_win_start) >= (int32_t)PN_LOG_US) {
+        uint32_t span = t0 - s_win_start;
+        pocketnano_log("PJFPS", (uint32_t)(((uint64_t)s_win_ticks * 10000000u) / span), s_win_slowest);
+        if (pocketnano_motion()) {
+            pocketnano_log("PJACCXY", (uint32_t)s_accel[0], (uint32_t)s_accel[1]);
+            pocketnano_log("PJACCZ", (uint32_t)s_accel[2], s_index);
+        }
+        touch_summary();
+        s_win_start = t0;
+        s_win_ticks = s_win_slowest = 0;
+    }
+    if (dt > s_slowest_us && s_frames > 2) {
+        s_slowest_us = dt;
+        pocketnano_log("PJSLOW", dt, s_frames);
+    }
+#ifdef POCKETNANO_QUICKJS
+    {
+        /* After a page change (live nodes moved by 48+ and settled for 8
+         * ticks): heap in use now and the core counters, so growth that is
+         * not a new peak still shows. */
+        static uint32_t s_cnt_nodes, s_cnt_tick, s_cnt_pending;
+        extern uint32_t pocketqjs_c_used(void);
+        uint32_t live = pocketnano_counter(1);
+        if (live + 48 <= s_cnt_nodes || live >= s_cnt_nodes + 48) {
+            /* A page went away (Motion Lab destroys the old page first):
+             * collect its JS garbage now, before the next page's
+             * animations stack on top of it (pocketjs16: ~50-100 KB of the
+             * Motion Lab peak was the old page waiting for the threshold). */
+            if (live + 48 <= s_cnt_nodes && s_frames > 2) {
+                extern void pocketqjs_collect(void);
+                pocketqjs_collect();
+            }
+            s_cnt_nodes = live;
+            s_cnt_pending = 1;
+            s_cnt_tick = s_run_ticks;
+        } else if (s_cnt_pending && s_run_ticks - s_cnt_tick >= 8) {
+            s_cnt_pending = 0;
+            pocketnano_log("PJNOW", pocketnano_heap_used(), pocketqjs_c_used());
+            pocketnano_log("PJSHAPE", pocketnano_shape_bytes(), s_index);
+            pocketnano_counters();
+        }
+    }
+#endif
+    peak = pocketnano_heap_peak();
+    if (peak >= s_trace_peak + (64u << 10)) {
+        s_trace_peak = peak;
+        pocketnano_log("PJPEAK", peak, s_heap_len);
+        s_log_soon = 1;
+#ifdef POCKETNANO_QUICKJS
+        {
+            /* Of the block in use now: QuickJS's (libc) bytes, the rest. */
+            extern uint32_t pocketqjs_c_used(void);
+            extern void pocketqjs_memory_log(void);
+            pocketnano_log("PJSPLIT", pocketqjs_c_used(), pocketnano_heap_used() - pocketqjs_c_used());
+            pocketnano_log("PJSHAPE", pocketnano_shape_bytes(), s_index);
+            pocketnano_counters();
+            pocketqjs_memory_log();
+        }
+#endif
+    }
+}
diff --git a/programs/nano7g/nanoapps/pocketqjs.c b/programs/nano7g/nanoapps/pocketqjs.c
new file mode 100644
index 00000000..23c9f05c
--- /dev/null
+++ b/programs/nano7g/nanoapps/pocketqjs.c
@@ -0,0 +1,856 @@
+/*
+ * pocketqjs.c - QuickJS for PocketJS NanoApps builds (make QUICKJS=1).
+ *
+ * Compiled against newlib's headers (not the SDK's freestanding ones) with
+ * QuickJS and the canonical guest. Everything the app allocates, Rust,
+ * QuickJS and newlib, comes from one dlmalloc space (Doug Lea, public
+ * domain, fetched at build time) laid over the app's OS heap block, so the
+ * resident frees all of it with the block. The space never grows: when it is
+ * full malloc returns NULL and QuickJS throws "out of memory".
+ *
+ * newlib runs without an OS: no files, no sbrk, the clock is the uptime
+ * counter (Date starts at POCKETQJS_EPOCH, the 7G has no clock call here).
+ */
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/time.h>
+#include <sys/stat.h>
+#include "quickjs.h"
+#include "pocket_guest_quickjs.h"
+
+/* pocketnano.c: the trace ring and the log file. */
+void pocketnano_log(const char *tag, uint32_t v1, uint32_t v2);
+#define hb_trace_log pocketnano_log
+
+#define ONLY_MSPACES 1
+#define MSPACES 1
+#define HAVE_MMAP 0
+#define HAVE_MORECORE 0
+#define USE_LOCKS 0
+#define USE_DL_PREFIX 1
+#define LACKS_SYS_MMAN_H 1
+#define LACKS_UNISTD_H 1
+#define LACKS_SYS_PARAM_H 1
+#define LACKS_SCHED_H 1
+#define LACKS_TIME_H 1
+#define NO_MALLOC_STATS 1
+#define NO_MALLINFO 1
+#define MALLOC_FAILURE_ACTION errno = ENOMEM
+#define FOOTERS 0
+#define INSECURE 1
+#define MALLOC_ALIGNMENT 8
+#define ABORT pocketqjs_abort()
+void pocketqjs_abort(void) __attribute__((noreturn));
+#include DLMALLOC_C
+
+#ifndef POCKETQJS_EPOCH
+#define POCKETQJS_EPOCH 1767225600u /* 2026-01-01T00:00:00Z */
+#endif
+
+extern void pocketnano_fail(uint32_t code, uint32_t line) __attribute__((noreturn));
+extern uint32_t hb_time_uptime_us(void);
+
+static mspace s_ms;
+static size_t s_used, s_peak;
+
+void pocketqjs_abort(void) { pocketnano_fail(5, 0); }
+
+/* Bytes held through libc malloc (QuickJS's own allocations), and the
+ * block's length: the frame hook below sizes QuickJS's GC trigger from them. */
+static size_t s_c_used, s_len;
+
+/* Spare spaces: memory inside the block that the app no longer needs but
+ * cannot give back to the main space (the package's JavaScript text, once
+ * the bundle ran from bytecode, sits in the middle of the package's
+ * allocation). Each gets its own dlmalloc space, tried before the main one;
+ * nothing in them is ever handed back, the whole block goes at the end. */
+#define PQ_SPARES 2
+static mspace s_x[PQ_SPARES];
+static uintptr_t s_x_lo[PQ_SPARES], s_x_hi[PQ_SPARES];
+static int s_nx;
+static size_t s_x_used, s_x_len;
+
+static void forget_runtime(void);
+
+void pocketqjs_heap_init(void *base, size_t length)
+{
+    /* A new app's block: the last QuickJS runtime went with the old one
+     * (pocketjs13: Tilt after a QuickJS app logged through a dead runtime). */
+    forget_runtime();
+    s_used = s_peak = s_c_used = 0;
+    s_nx = 0;
+    s_x_used = s_x_len = 0;
+    s_len = length;
+    s_ms = create_mspace_with_base(base, length, 0);
+    if (!s_ms)
+        pocketnano_fail(6, 0);
+}
+size_t pocketqjs_heap_used(void) { return s_used; }
+uint32_t pocketqjs_c_used(void) { return (uint32_t)s_c_used; }
+/* The main space's peak: what the block must hold (the spare spaces are
+ * inside allocations it already counts). */
+size_t pocketqjs_heap_peak(void) { return s_peak; }
+uint32_t pocketqjs_spare_used(void) { return (uint32_t)s_x_used; }
+uint32_t pocketqjs_spare_len(void) { return (uint32_t)s_x_len; }
+
+static int spare_of(const void *p)
+{
+    uintptr_t a = (uintptr_t)p;
+    int i;
+    for (i = 0; i < s_nx; i++)
+        if (a >= s_x_lo[i] && a < s_x_hi[i])
+            return i;
+    return -1;
+}
+static mspace space_of(const void *p)
+{
+    int i = spare_of(p);
+    return i < 0 ? s_ms : s_x[i];
+}
+
+/* Hand [p, p + n) to the allocator as a spare space. */
+void pocketqjs_donate(void *p, size_t n)
+{
+    uintptr_t lo = ((uintptr_t)p + 15u) & ~(uintptr_t)15u;
+    uintptr_t hi = ((uintptr_t)p + n) & ~(uintptr_t)15u;
+    mspace m;
+    if (s_nx >= PQ_SPARES || hi <= lo || hi - lo < (64u << 10))
+        return;
+    m = create_mspace_with_base((void *)lo, hi - lo, 0);
+    if (!m)
+        return;
+    s_x[s_nx] = m;
+    s_x_lo[s_nx] = lo;
+    s_x_hi[s_nx] = hi;
+    s_nx++;
+    s_x_len += hi - lo;
+    hb_trace_log("PJSPARE", (uint32_t)(hi - lo), (uint32_t)s_nx);
+}
+
+static void *track(void *p)
+{
+    if (p) {
+        if (spare_of(p) >= 0) {
+            s_x_used += mspace_usable_size(p);
+        } else {
+            s_used += mspace_usable_size(p);
+            if (s_used > s_peak)
+                s_peak = s_used;
+        }
+    }
+    return p;
+}
+static void untrack(void *p)
+{
+    if (p) {
+        if (spare_of(p) >= 0)
+            s_x_used -= mspace_usable_size(p);
+        else
+            s_used -= mspace_usable_size(p);
+    }
+}
+
+static void *raw_alloc(mspace m, size_t size, size_t align)
+{
+    return align <= 8 ? mspace_malloc(m, size) : mspace_memalign(m, align, size);
+}
+
+void *pocketqjs_alloc(size_t size, size_t align)
+{
+    void *p = 0;
+    int i;
+    if (!s_ms)
+        return 0;
+    for (i = 0; i < s_nx && !p; i++)
+        p = raw_alloc(s_x[i], size, align);
+    if (!p)
+        p = raw_alloc(s_ms, size, align);
+    return track(p);
+}
+void pocketqjs_free(void *p)
+{
+    if (!p || !s_ms)
+        return;
+    untrack(p);
+    mspace_free(space_of(p), p);
+}
+void *pocketqjs_realloc(void *p, size_t size, size_t align)
+{
+    void *q;
+    size_t old;
+    if (!p)
+        return pocketqjs_alloc(size, align);
+    old = mspace_usable_size(p);
+    if (align <= 8) {
+        int spare = spare_of(p) >= 0;
+        q = mspace_realloc(space_of(p), p, size);
+        if (q) {
+            if (spare) s_x_used -= old; else s_used -= old;
+            return track(q);
+        }
+    }
+    q = pocketqjs_alloc(size, align);
+    if (q) {
+        memcpy(q, p, old < size ? old : size);
+        pocketqjs_free(p);
+    }
+    return q;
+}
+
+/* libc's allocator is the same space. */
+void *malloc(size_t n)
+{
+    void *p = pocketqjs_alloc(n, 8);
+    if (p)
+        s_c_used += mspace_usable_size(p);
+    return p;
+}
+void free(void *p)
+{
+    if (p && s_ms)
+        s_c_used -= mspace_usable_size(p);
+    pocketqjs_free(p);
+}
+void *realloc(void *p, size_t n)
+{
+    size_t old = p && s_ms ? mspace_usable_size(p) : 0;
+    void *q = pocketqjs_realloc(p, n, 8);
+    if (q) {
+        s_c_used -= old;
+        s_c_used += mspace_usable_size(q);
+    }
+    return q;
+}
+void *calloc(size_t a, size_t b)
+{
+    size_t n;
+    void *p;
+    if (b && a > (size_t)-1 / b)
+        return 0;
+    n = a * b;
+    p = malloc(n);
+    if (p)
+        memset(p, 0, n);
+    return p;
+}
+void *memalign(size_t align, size_t n) { return pocketqjs_alloc(n, align); }
+size_t malloc_usable_size(void *p) { return p ? mspace_usable_size(p) : 0; }
+struct _reent;
+void *_malloc_r(struct _reent *r, size_t n) { (void)r; return malloc(n); }
+void _free_r(struct _reent *r, void *p) { (void)r; free(p); }
+void *_realloc_r(struct _reent *r, void *p, size_t n) { (void)r; return realloc(p, n); }
+void *_calloc_r(struct _reent *r, size_t a, size_t b) { (void)r; return calloc(a, b); }
+
+/* newlib system calls: no OS underneath. */
+void *_sbrk(ptrdiff_t n) { (void)n; errno = ENOMEM; return (void *)-1; }
+int _write(int fd, const void *b, size_t n) { (void)fd; (void)b; return (int)n; }
+int _read(int fd, void *b, size_t n) { (void)fd; (void)b; (void)n; return 0; }
+int _close(int fd) { (void)fd; return -1; }
+int _lseek(int fd, int o, int w) { (void)fd; (void)o; (void)w; return -1; }
+int _fstat(int fd, struct stat *st) { (void)fd; memset(st, 0, sizeof *st); st->st_mode = S_IFCHR; return 0; }
+int _isatty(int fd) { (void)fd; return 1; }
+int _getpid(void) { return 1; }
+int _kill(int pid, int sig) { (void)pid; (void)sig; errno = EINVAL; return -1; }
+void _exit(int code) { pocketnano_fail(7, (uint32_t)code); }
+void abort(void) { pocketnano_fail(5, 1); }
+void __assert_func(const char *file, int line, const char *fn, const char *expr)
+{
+    (void)file; (void)fn; (void)expr;
+    pocketnano_fail(8, (uint32_t)line);
+}
+
+/* A 64-bit microsecond clock from the 32-bit uptime counter (wraps in 71 min). */
+static uint32_t s_last;
+static uint64_t s_high;
+static uint64_t now_us(void)
+{
+    uint32_t t = hb_time_uptime_us();
+    if (t < s_last)
+        s_high += 1ull << 32;
+    s_last = t;
+    return s_high | t;
+}
+int _gettimeofday(struct timeval *tv, void *tz)
+{
+    uint64_t us = now_us();
+    (void)tz;
+    if (tv) {
+        tv->tv_sec = (time_t)(POCKETQJS_EPOCH + us / 1000000u);
+        tv->tv_usec = (suseconds_t)(us % 1000000u);
+    }
+    return 0;
+}
+
+#ifndef POCKETQJS_STRIP
+#define POCKETQJS_STRIP JS_STRIP_SOURCE
+#endif
+
+static JSRuntime *s_rt;
+static JSContext *s_ctx;
+
+static void forget_runtime(void)
+{
+    s_rt = 0;
+    s_ctx = 0;
+}
+
+/* A runtime and realm in the space, with the canonical guest attached. */
+/* Precompiled bytecode (pocketqjsc, a .qjsbc file beside the package).
+ * The canonical guest's evaluate parses the bundle on the device: the
+ * biggest part of a QuickJS app's boot. When the app handed us bytecode
+ * made from exactly this bundle (same length, same FNV-1a), the bundle is
+ * read from it instead (JS_ReadObject over the file, not copied) and run.
+ * Anything else falls back to parsing, so a stale file costs time only. */
+#define PQBC_MAGIC 0x43425150u   /* "PQBC" */
+#define PQBC_VERSION 1u
+#define PQBC_HEADER 20u
+static uint8_t *s_bc;
+static size_t s_bc_len;
+static pocket_guest_quickjs *s_guest;
+static pocket_guest_v1 s_api;
+static char s_bc_error[256];
+static uint32_t s_bc_used;    /* 1: the last boot ran from bytecode */
+
+static uint32_t rd32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+
+uint32_t pocketqjs_fnv1a(const uint8_t *p, size_t n)
+{
+    uint32_t h = 2166136261u;
+    while (n--) { h ^= *p++; h *= 16777619u; }
+    return h;
+}
+
+/* The bytecode buffer is ours: freed once its functions are read (QuickJS
+ * copies them; the atoms of an app's bytecode never match the runtime's,
+ * so reading it in place, JS_READ_OBJ_ROM_DATA, would copy anyway). */
+uint8_t *pocketqjs_bytecode_buffer(size_t length)
+{
+    return (uint8_t *)pocketqjs_alloc(length, 8);
+}
+static void drop_bytecode(void)
+{
+    if (s_bc)
+        pocketqjs_free((void *)s_bc);
+    s_bc = 0;
+    s_bc_len = 0;
+}
+void pocketqjs_set_bytecode(uint8_t *bytes, size_t length)
+{
+    s_bc = bytes;
+    s_bc_len = length;
+}
+
+uint32_t pocketqjs_bytecode_used(void) { return s_bc_used; }
+
+static int32_t bc_evaluate(void *opaque, pocket_runtime *runtime, const uint8_t *code, size_t length)
+{
+    size_t source = length && code[length - 1] == 0 ? length - 1 : length;
+    const uint8_t *bc = s_bc;
+    JSValue fn, result;
+    s_bc_used = 0;
+    if (!bc || s_bc_len < PQBC_HEADER || rd32(bc) != PQBC_MAGIC || rd32(bc + 4) != PQBC_VERSION
+        || rd32(bc + 8) != source || rd32(bc + 16) != s_bc_len - PQBC_HEADER
+        || rd32(bc + 12) != pocketqjs_fnv1a(code, source)) {
+        drop_bytecode();
+        return pocket_guest_quickjs_vtable()->evaluate(opaque, runtime, code, length);
+    }
+    fn = JS_ReadObject(s_ctx, bc + PQBC_HEADER, s_bc_len - PQBC_HEADER, JS_READ_OBJ_BYTECODE);
+    drop_bytecode();
+    if (!JS_IsException(fn)) {
+        /* The bundle's text is not read again (the package is admitted and
+         * hashed, the functions are read): let the realm use its bytes. */
+        pocketqjs_donate((void *)code, length);
+        result = JS_EvalFunction(s_ctx, fn);   /* takes fn */
+        if (!JS_IsException(result)) {
+            JS_FreeValue(s_ctx, result);
+            s_bc_used = 1;
+            return pocket_guest_quickjs_vtable()->collect(opaque);
+        }
+    }
+    {
+        JSValue e = JS_GetException(s_ctx);
+        const char *m = JS_ToCString(s_ctx, e);
+        size_t n = m ? strlen(m) : 0;
+        if (n > sizeof s_bc_error - 1) n = sizeof s_bc_error - 1;
+        memcpy(s_bc_error, m ? m : "", n);
+        s_bc_error[n] = 0;
+        if (m) JS_FreeCString(s_ctx, m);
+        if (JS_IsObject(e)) {   /* where it was thrown, as far as the buffer goes */
+            JSValue st = JS_GetPropertyStr(s_ctx, e, "stack");
+            const char *w = JS_IsString(st) ? JS_ToCString(s_ctx, st) : NULL;
+            size_t k = w ? strlen(w) : 0;
+            if (w && n + 3 < sizeof s_bc_error) {
+                if (k > sizeof s_bc_error - n - 4) k = sizeof s_bc_error - n - 4;
+                memcpy(s_bc_error + n, " | ", 3);
+                memcpy(s_bc_error + n + 3, w, k);
+                s_bc_error[n + 3 + k] = 0;
+            }
+            if (w) JS_FreeCString(s_ctx, w);
+            JS_FreeValue(s_ctx, st);
+        }
+        JS_FreeValue(s_ctx, e);
+    }
+    return -1;
+}
+
+/* ---- globalThis.offload: the device-local provider (src/local.rs) ----
+ * offload.local serves font.open / font.glyphs / font.stats / font.close /
+ * fs.read-text from /Apps/Data/PocketJS, one request per frame. The
+ * companion root is present but never connected (no link on the nano). */
+extern int32_t pocketnano_local_session(void);
+extern bool pocketnano_local_submit(uint32_t id, uint32_t op, const uint8_t *path, size_t path_len,
+                                    uint32_t generation, uint32_t slot, uint32_t count, const uint32_t *cps);
+extern size_t pocketnano_local_take(const uint8_t **out);
+
+static uint32_t prop_u32(JSContext *ctx, JSValueConst obj, const char *key)
+{
+    JSValue v = JS_GetPropertyStr(ctx, obj, key);
+    int32_t n = 0;
+    JS_ToInt32(ctx, &n, v);
+    JS_FreeValue(ctx, v);
+    return (uint32_t)n;
+}
+
+static JSValue js_local_session(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val; (void)argc; (void)argv;
+    return JS_NewInt32(ctx, pocketnano_local_session());
+}
+
+static JSValue js_local_take(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    const uint8_t *p = 0;
+    size_t n;
+    (void)this_val; (void)argc; (void)argv;
+    n = pocketnano_local_take(&p);
+    return n ? JS_NewStringLen(ctx, (const char *)p, n) : JS_UNDEFINED;
+}
+
+static JSValue js_local_submit(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    size_t len = 0, plen = 0;
+    const char *rec, *method = 0, *payload = 0;
+    JSValue obj, m, pl;
+    uint32_t id, op = 0, generation = 0, slot = 0, count = 0, cps[4] = {0, 0, 0, 0};
+    bool ok = false;
+    (void)this_val;
+    if (argc < 1)
+        return JS_FALSE;
+    rec = JS_ToCStringLen(ctx, &len, argv[0]);
+    if (!rec)
+        return JS_FALSE;
+    obj = len <= 4096 ? JS_ParseJSON(ctx, rec, len, "local request") : JS_EXCEPTION;
+    JS_FreeCString(ctx, rec);
+    if (JS_IsException(obj)) {
+        JS_FreeValue(ctx, JS_GetException(ctx));
+        return JS_FALSE;
+    }
+    id = prop_u32(ctx, obj, "id");
+    m = JS_GetPropertyStr(ctx, obj, "method");
+    pl = JS_GetPropertyStr(ctx, obj, "payload");
+    method = JS_ToCString(ctx, m);
+    payload = JS_IsUndefined(pl) ? 0 : JS_ToCStringLen(ctx, &plen, pl);
+    if (prop_u32(ctx, obj, "v") == 1 && id && method) {
+        if (!strcmp(method, "font.open")) op = 1;
+        else if (!strcmp(method, "font.glyphs")) op = 2;
+        else if (!strcmp(method, "font.stats")) op = 3;
+        else if (!strcmp(method, "fs.read-text")) op = 4;
+        else if (!strcmp(method, "font.close")) op = 5;
+    }
+    if (op == 2 && payload) {
+        JSValue args = JS_ParseJSON(ctx, payload, plen, "font batch");
+        if (!JS_IsException(args)) {
+            JSValue sc = JS_GetPropertyStr(ctx, args, "scalars");
+            uint32_t i;
+            generation = prop_u32(ctx, args, "generation");
+            slot = prop_u32(ctx, args, "slot");
+            count = prop_u32(ctx, sc, "length");
+            if (count > 4)
+                count = 0;
+            for (i = 0; i < count; i++) {
+                JSValue c = JS_GetPropertyUint32(ctx, sc, i);
+                int32_t n = 0;
+                JS_ToInt32(ctx, &n, c);
+                JS_FreeValue(ctx, c);
+                cps[i] = (uint32_t)n;
+            }
+            JS_FreeValue(ctx, sc);
+            JS_FreeValue(ctx, args);
+        } else {
+            JS_FreeValue(ctx, JS_GetException(ctx));
+        }
+        if (count)
+            ok = pocketnano_local_submit(id, op, 0, 0, generation, slot, count, cps);
+    } else if (op == 1 || op == 4) {
+        if (payload && plen < 128)
+            ok = pocketnano_local_submit(id, op, (const uint8_t *)payload, plen, 0, 0, 0, cps);
+    } else if (op) {
+        ok = pocketnano_local_submit(id, op, 0, 0, 0, 0, 0, cps);
+    }
+    if (payload)
+        JS_FreeCString(ctx, payload);
+    if (method)
+        JS_FreeCString(ctx, method);
+    JS_FreeValue(ctx, pl);
+    JS_FreeValue(ctx, m);
+    JS_FreeValue(ctx, obj);
+    return JS_NewBool(ctx, ok);
+}
+
+static JSValue js_companion_session(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val; (void)argc; (void)argv;
+    return JS_NewInt32(ctx, 0);
+}
+
+static JSValue js_companion_submit(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)ctx; (void)this_val; (void)argc; (void)argv;
+    return JS_FALSE;
+}
+
+static JSValue js_companion_take(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)ctx; (void)this_val; (void)argc; (void)argv;
+    return JS_UNDEFINED;
+}
+
+static void register_offload(JSContext *ctx)
+{
+    JSValue global = JS_GetGlobalObject(ctx);
+    JSValue io = JS_NewObject(ctx), local = JS_NewObject(ctx);
+    JS_SetPropertyStr(ctx, local, "session", JS_NewCFunction(ctx, js_local_session, "session", 0));
+    JS_SetPropertyStr(ctx, local, "submit", JS_NewCFunction(ctx, js_local_submit, "submit", 1));
+    JS_SetPropertyStr(ctx, local, "take", JS_NewCFunction(ctx, js_local_take, "take", 0));
+    JS_SetPropertyStr(ctx, io, "session", JS_NewCFunction(ctx, js_companion_session, "session", 0));
+    JS_SetPropertyStr(ctx, io, "submit", JS_NewCFunction(ctx, js_companion_submit, "submit", 1));
+    JS_SetPropertyStr(ctx, io, "take", JS_NewCFunction(ctx, js_companion_take, "take", 0));
+    JS_SetPropertyStr(ctx, io, "local", local);
+    JS_SetPropertyStr(ctx, global, "offload", io);
+    JS_FreeValue(ctx, global);
+}
+
+/* ---- data.fs (nanofs.c): globalThis.fs for an app with a data folder ---- */
+
+#include "fs.h"
+void nanofs_reset(void);
+bool nanofs_bind(const char *root, const char *temp, uint64_t quota);
+void nanofs_log(uint32_t op, uint32_t bytes, int failed, uint32_t us);
+
+/* Each app's files: /Apps/Data/PocketJS/<app>/. Staging lives beside the app
+ * folders, outside every root. The quota also bounds what one call holds in
+ * the heap (files are read and written whole). */
+#define PQFS_BASE "/Apps/Data/PocketJS"
+#define PQFS_QUOTA (128u << 10)
+
+enum { PQFS_READ = 1, PQFS_WRITE, PQFS_REMOVE, PQFS_LIST, PQFS_STAT, PQFS_MKDIR, PQFS_RENAME, PQFS_USAGE, PQFS_ERROR };
+
+static JSValue pqfs_line(JSContext *ctx, const char *line)
+{
+    return JS_NewString(ctx, line ? line : "{\"error\":\"out of memory\"}");
+}
+
+static JSValue pqfs_op(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv, int magic)
+{
+    (void)this_val;
+    size_t al = 0, bl = 0;
+    const char *a = NULL, *b = NULL;
+    double x = 0, y = 0;
+    JSValue out = JS_UNDEFINED;
+    if (argc > 0 && magic != PQFS_USAGE && magic != PQFS_ERROR) {
+        a = JS_ToCStringLen(ctx, &al, argv[0]);
+        if (!a)
+            return JS_EXCEPTION;
+    }
+    if (argc > 1 && (magic == PQFS_WRITE || magic == PQFS_RENAME)) {
+        b = JS_ToCStringLen(ctx, &bl, argv[1]);
+        if (!b) {
+            JS_FreeCString(ctx, a);
+            return JS_EXCEPTION;
+        }
+    } else if (argc > 1) {
+        JS_ToFloat64(ctx, &x, argv[1]);
+    }
+    if (argc > 2)
+        JS_ToFloat64(ctx, &y, argv[2]);
+    const char *path = a ? a : "";
+    int rc;
+    uint32_t t0 = hb_time_uptime_us();
+    switch (magic) {
+    case PQFS_READ: out = pqfs_line(ctx, fs_read(path, al, x, y)); break;
+    case PQFS_LIST: out = pqfs_line(ctx, fs_list(path, al, x)); break;
+    case PQFS_STAT: out = pqfs_line(ctx, fs_stat(path, al)); break;
+    case PQFS_USAGE: out = pqfs_line(ctx, fs_usage()); break;
+    case PQFS_ERROR: out = JS_NewString(ctx, fs_last_error()); break;
+    case PQFS_WRITE:
+        rc = fs_write(path, al, b ? b : "", bl, (int)y);
+        nanofs_log(PQFS_WRITE, (uint32_t)bl, rc, hb_time_uptime_us() - t0);
+        out = JS_NewInt32(ctx, rc);
+        break;
+    case PQFS_REMOVE:
+        rc = fs_remove(path, al, (int)x);
+        nanofs_log(PQFS_REMOVE, 0, rc, hb_time_uptime_us() - t0);
+        out = JS_NewInt32(ctx, rc);
+        break;
+    case PQFS_MKDIR:
+        rc = fs_mkdir(path, al);
+        nanofs_log(PQFS_MKDIR, 0, rc, hb_time_uptime_us() - t0);
+        out = JS_NewInt32(ctx, rc);
+        break;
+    case PQFS_RENAME:
+        rc = fs_rename(path, al, b ? b : "", bl);
+        nanofs_log(PQFS_RENAME, 0, rc, hb_time_uptime_us() - t0);
+        out = JS_NewInt32(ctx, rc);
+        break;
+    }
+    if (a)
+        JS_FreeCString(ctx, a);
+    if (b)
+        JS_FreeCString(ctx, b);
+    return out;
+}
+
+/* Bind `/Apps/Data/PocketJS/<app>` and publish globalThis.fs. A folder that
+ * cannot be made leaves fs out (the app sees a host without data.fs). */
+static void register_fs(JSContext *ctx, const char *app)
+{
+    static const char *const names[] = { "read", "write", "remove", "list", "stat", "mkdir", "rename", "usage", "lastError" };
+    static const int arity[] = { 3, 3, 2, 2, 1, 1, 2, 0, 0 };
+    char root[96], temp[96];
+    nanofs_reset();
+    if (!app || !app[0])
+        return;
+    snprintf(root, sizeof root, PQFS_BASE "/%s", app);
+    snprintf(temp, sizeof temp, PQFS_BASE "/.fs-tmp/%s", app);
+    if (!nanofs_bind(root, temp, PQFS_QUOTA))
+        return;
+    JSValue global = JS_GetGlobalObject(ctx);
+    JSValue fs = JS_NewObject(ctx);
+    for (int i = 0; i < 9; i++)
+        JS_SetPropertyStr(ctx, fs, names[i], JS_NewCFunctionMagic(ctx, pqfs_op, names[i], arity[i], JS_CFUNC_generic_magic, i + 1));
+    JS_SetPropertyStr(ctx, global, "fs", fs);
+    JS_FreeValue(ctx, global);
+}
+
+/* ---- globalThis.nano: the home screen's view of the iPod (pocketjs13) ----
+ * nano.from      key of the app that just went back home ("" cold)
+ * nano.has(k)    app k is here and its package is on the volume
+ * nano.launch(k) open app k after this frame (home screen only)
+ * nano.clock()   hours << 16 | minutes << 8 | seconds, weekday << 24; -1
+ * nano.date()    year << 16 | month << 8 | day; -1
+ * nano.battery() level 0..15, | 0x100 while charging */
+extern const char *pocketnano_home_from(void);
+extern int pocketnano_home_has(const char *key, uint32_t len);
+extern int pocketnano_home_launch(const char *key, uint32_t len);
+extern int32_t pocketnano_home_clock(void);
+extern int32_t pocketnano_home_date(void);
+extern int32_t pocketnano_home_battery(void);
+
+static JSValue js_nano_key(JSContext *ctx, int argc, JSValueConst *argv, int launch)
+{
+    size_t len;
+    const char *key;
+    int r;
+    if (argc < 1)
+        return JS_FALSE;
+    key = JS_ToCStringLen(ctx, &len, argv[0]);
+    if (!key)
+        return JS_EXCEPTION;
+    r = launch ? pocketnano_home_launch(key, (uint32_t)len) : pocketnano_home_has(key, (uint32_t)len);
+    JS_FreeCString(ctx, key);
+    return JS_NewBool(ctx, r);
+}
+static JSValue js_nano_has(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val;
+    return js_nano_key(ctx, argc, argv, 0);
+}
+static JSValue js_nano_launch(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val;
+    return js_nano_key(ctx, argc, argv, 1);
+}
+static JSValue js_nano_clock(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val; (void)argc; (void)argv;
+    return JS_NewInt32(ctx, pocketnano_home_clock());
+}
+static JSValue js_nano_date(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val; (void)argc; (void)argv;
+    return JS_NewInt32(ctx, pocketnano_home_date());
+}
+static JSValue js_nano_battery(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    (void)this_val; (void)argc; (void)argv;
+    return JS_NewInt32(ctx, pocketnano_home_battery());
+}
+
+extern int32_t pocketnano_home_memory(int32_t which);
+extern int32_t pocketnano_home_media(int32_t op);
+
+static JSValue js_nano_memory(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    int32_t w = 0;
+    (void)this_val;
+    if (argc > 0) JS_ToInt32(ctx, &w, argv[0]);
+    return JS_NewInt32(ctx, pocketnano_home_memory(w));
+}
+
+static JSValue js_nano_media(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    int32_t op = 0;
+    (void)this_val;
+    if (argc > 0) JS_ToInt32(ctx, &op, argv[0]);
+    return JS_NewInt32(ctx, pocketnano_home_media(op));
+}
+
+static void register_nano(JSContext *ctx)
+{
+    JSValue global = JS_GetGlobalObject(ctx), nano = JS_NewObject(ctx);
+    JS_SetPropertyStr(ctx, nano, "from", JS_NewString(ctx, pocketnano_home_from()));
+    JS_SetPropertyStr(ctx, nano, "has", JS_NewCFunction(ctx, js_nano_has, "has", 1));
+    JS_SetPropertyStr(ctx, nano, "launch", JS_NewCFunction(ctx, js_nano_launch, "launch", 1));
+    JS_SetPropertyStr(ctx, nano, "clock", JS_NewCFunction(ctx, js_nano_clock, "clock", 0));
+    JS_SetPropertyStr(ctx, nano, "date", JS_NewCFunction(ctx, js_nano_date, "date", 0));
+    JS_SetPropertyStr(ctx, nano, "battery", JS_NewCFunction(ctx, js_nano_battery, "battery", 0));
+    JS_SetPropertyStr(ctx, nano, "memory", JS_NewCFunction(ctx, js_nano_memory, "memory", 1));
+    JS_SetPropertyStr(ctx, nano, "media", JS_NewCFunction(ctx, js_nano_media, "media", 1));
+    JS_SetPropertyStr(ctx, global, "nano", nano);
+    JS_FreeValue(ctx, global);
+}
+
+int pocketqjs_create(size_t memory_limit, size_t stack, const char *data, const void **table, void **guest)
+{
+    pocket_guest_quickjs *g;
+    s_rt = JS_NewRuntime();
+    if (!s_rt)
+        return -1;
+    JS_SetMaxStackSize(s_rt, stack);
+    JS_SetMemoryLimit(s_rt, memory_limit);
+    /* Function source text is not kept (Function.prototype.toString reads
+     * "[native code]"-like stubs); line numbers stay for error messages. */
+    JS_SetStripInfo(s_rt, POCKETQJS_STRIP);
+    s_ctx = JS_NewContext(s_rt);
+    if (!s_ctx)
+        return -2;
+    g = pocket_guest_quickjs_attach(s_ctx, POCKET_QJS_CANONICAL);
+    if (!g)
+        return -3;
+    register_offload(s_ctx);
+    register_fs(s_ctx, data);
+    register_nano(s_ctx);
+    {
+        /* No DevTools link on the iPod: nothing can fetch the framework's
+         * flight-recorder tape, so keep it at one frame (devtools.ts). */
+        JSValue global = JS_GetGlobalObject(s_ctx);
+        JS_SetPropertyStr(s_ctx, global, "__pocketTapeFrames", JS_NewInt32(s_ctx, 1));
+        JS_FreeValue(s_ctx, global);
+    }
+    s_guest = g;
+    s_bc_error[0] = 0;
+    s_api = *pocket_guest_quickjs_vtable();
+    s_api.evaluate = bc_evaluate;
+    *table = &s_api;
+    *guest = g;
+    return 0;
+}
+
+const char *pocketqjs_error(void *guest)
+{
+    if (s_bc_error[0])
+        return s_bc_error;
+    return guest ? pocket_guest_quickjs_error((const pocket_guest_quickjs *)guest) : "";
+}
+
+/* The menu key is leaving the app: call nano.onexit() if the app set one
+ * (Notes saves the open note), then run what it queued. Errors are logged. */
+void pocketqjs_exit_hook(void)
+{
+    JSValue global, nano, fn;
+    uint32_t t0 = hb_time_uptime_us();
+    if (!s_ctx)
+        return;
+    global = JS_GetGlobalObject(s_ctx);
+    nano = JS_GetPropertyStr(s_ctx, global, "nano");
+    fn = JS_IsObject(nano) ? JS_GetPropertyStr(s_ctx, nano, "onexit") : JS_UNDEFINED;
+    if (JS_IsFunction(s_ctx, fn)) {
+        JSValue r = JS_Call(s_ctx, fn, nano, 0, NULL);
+        if (JS_IsException(r)) {
+            JS_FreeValue(s_ctx, JS_GetException(s_ctx));
+            pocketnano_log("PJEXITX", 1, 0);
+        }
+        JS_FreeValue(s_ctx, r);
+        pocketnano_log("PJEXIT", (hb_time_uptime_us() - t0) / 1000u, 0);
+    }
+    JS_FreeValue(s_ctx, fn);
+    JS_FreeValue(s_ctx, nano);
+    JS_FreeValue(s_ctx, global);
+}
+
+/* Once a frame, between ticks: QuickJS collects cycles when its own
+ * allocations grow by half the room left in the block, instead of at its
+ * default 1.5 x growth, which under a fixed block can reach the limit
+ * before a collection runs. (The Type sample's keyboard peak is live data,
+ * PJSPLIT, so this does not lower it; it keeps cyclic garbage from doing so.) */
+void pocketqjs_frame(void)
+{
+    size_t room;
+    if (!s_rt)
+        return;
+    room = (s_len > s_used ? s_len - s_used : 0) + (s_x_len > s_x_used ? s_x_len - s_x_used : 0);
+    JS_SetGCThreshold(s_rt, s_c_used + room / 2);
+}
+
+/* Where QuickJS's bytes are, for the log (PJMEM*): sizes of objects,
+ * properties+shapes, strings+atoms, functions (bytecode), arrays, buffers. */
+void pocketqjs_memory_log(void)
+{
+    JSMemoryUsage u;
+    if (!s_rt)
+        return;
+    JS_ComputeMemoryUsage(s_rt, &u);
+    hb_trace_log("PJMEMO", (uint32_t)u.obj_size, (uint32_t)u.obj_count);
+    hb_trace_log("PJMEMP", (uint32_t)(u.prop_size + u.shape_size), (uint32_t)u.shape_count);
+    hb_trace_log("PJMEMS", (uint32_t)(u.str_size + u.atom_size), (uint32_t)u.str_count);
+    hb_trace_log("PJMEMF", (uint32_t)u.js_func_size, (uint32_t)u.js_func_count);
+    hb_trace_log("PJMEMA", (uint32_t)u.fast_array_elements * 8, (uint32_t)u.array_count);
+    hb_trace_log("PJMEMB", (uint32_t)u.binary_object_size, (uint32_t)u.binary_object_count);
+    hb_trace_log("PJMEMC", (uint32_t)u.js_func_code_size, (uint32_t)u.js_func_pc2line_size);
+    hb_trace_log("PJMEMT", (uint32_t)u.atom_size, (uint32_t)u.atom_count);
+    hb_trace_log("PJMEMU", (uint32_t)u.memory_used_size, (uint32_t)u.memory_used_count);
+}
+
+void pocketqjs_collect(void)
+{
+    if (s_rt)
+        JS_RunGC(s_rt);
+}
+
+/* QuickJS's own accounting, for the trace. */
+uint32_t pocketqjs_js_bytes(void)
+{
+    JSMemoryUsage u;
+    if (!s_rt)
+        return 0;
+    JS_ComputeMemoryUsage(s_rt, &u);
+    return (uint32_t)u.malloc_size;
+}
+
+/* newlib-nano's printf and scanf reach for floating point through these weak
+ * hooks; only QuickJS's debug dumps print floats (numbers go through its own
+ * dtoa), and the relocator wants no undefined symbols. */
+int _printf_float(void *r, void *d, void *f, int (*pfunc)(void), void *ap)
+{
+    (void)r; (void)d; (void)f; (void)pfunc; (void)ap;
+    return -1;
+}
+int _scanf_float(void *r, void *d, void *f, void *ap)
+{
+    (void)r; (void)d; (void)f; (void)ap;
+    return 0;
+}
diff --git a/programs/nano7g/nanoapps/pocketqjsc.c b/programs/nano7g/nanoapps/pocketqjsc.c
new file mode 100644
index 00000000..2dcfee08
--- /dev/null
+++ b/programs/nano7g/nanoapps/pocketqjsc.c
@@ -0,0 +1,106 @@
+/*
+ * pocketqjsc.c - host tool: a .pocket package's JavaScript bundle to QuickJS
+ * bytecode for the iPod nano 7G (a .qjsbc file beside the package).
+ *
+ *   pocketqjsc app.pocket app.qjsbc
+ *
+ * Built for the build machine from the same pinned QuickJS sources as the
+ * app:
+ *   cc -O2 -D_GNU_SOURCE -DCONFIG_VERSION='"pocketnano"' -I$QUICKJS_DIR \
+ *     pocketqjsc.c $QUICKJS_DIR/{quickjs,libregexp,libunicode,cutils,dtoa}.c \
+ *     -lm -lpthread -o pocketqjsc
+ * The
+ * file: "PQBC", version 1, source length, FNV-1a of the source, bytecode
+ * length (all u32 little-endian), then JS_WriteObject bytecode. The app
+ * uses it only when the length and hash match the bundle it is booting.
+ * Source text is stripped as on the device (JS_STRIP_SOURCE).
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "quickjs.h"
+
+static uint32_t rd32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+static void wr32(uint8_t *p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+static uint32_t fnv1a(const uint8_t *p, size_t n)
+{
+    uint32_t h = 2166136261u;
+    while (n--) { h ^= *p++; h *= 16777619u; }
+    return h;
+}
+
+static int die(const char *why) { fprintf(stderr, "pocketqjsc: %s\n", why); return 1; }
+
+int main(int argc, char **argv)
+{
+    FILE *f;
+    long size;
+    uint8_t *pkg, *bc, header[20];
+    uint32_t variants, v, sections, s, off, len;
+    const uint8_t *js = NULL;
+    size_t js_len = 0, bc_len = 0;
+    JSRuntime *rt;
+    JSContext *ctx;
+    JSValue fn;
+    if (argc != 3)
+        return die("usage: pocketqjsc app.pocket app.qjsbc");
+    if (!(f = fopen(argv[1], "rb")))
+        return die("cannot open the package");
+    fseek(f, 0, SEEK_END);
+    size = ftell(f);
+    rewind(f);
+    pkg = malloc(size);
+    if (!pkg || fread(pkg, 1, size, f) != (size_t)size)
+        return die("cannot read the package");
+    fclose(f);
+    if (size < 32 || rd32(pkg) != 0x544b4350u || rd32(pkg + 4) != 2)
+        return die("not a version 2 .pocket package");
+    /* Header, manifest (padded to 16), then 64-byte variant records. */
+    variants = rd32(pkg + 12);
+    off = 32 + ((rd32(pkg + 8) + 15u) & ~15u);
+    for (v = 0; v < variants && !js; v++) {
+        const uint8_t *rec = pkg + off + v * 64;
+        sections = rd32(rec + 12);
+        for (s = 0; s < sections; s++) {
+            const uint8_t *sec = pkg + rd32(rec + 16) + s * 16;
+            if (rd32(sec) == 3) {   /* POCKET_SECTION.js, NUL-terminated */
+                js = pkg + rd32(sec + 8);
+                len = rd32(sec + 12);
+                if (!len || (long)(js - pkg) + len > size || js[len - 1] != 0)
+                    return die("bad js section");
+                js_len = len - 1;
+                break;
+            }
+        }
+    }
+    if (!js)
+        return die("no js section");
+    rt = JS_NewRuntime();
+    JS_SetStripInfo(rt, JS_STRIP_SOURCE);
+    ctx = JS_NewContext(rt);
+    fn = JS_Eval(ctx, (const char *)js, js_len, "pocket:guest", JS_EVAL_TYPE_GLOBAL | JS_EVAL_FLAG_COMPILE_ONLY);
+    if (JS_IsException(fn)) {
+        JSValue e = JS_GetException(ctx);
+        const char *m = JS_ToCString(ctx, e);
+        fprintf(stderr, "pocketqjsc: %s\n", m ? m : "compile failed");
+        return 1;
+    }
+    bc = JS_WriteObject(ctx, &bc_len, fn, JS_WRITE_OBJ_BYTECODE);
+    if (!bc)
+        return die("JS_WriteObject failed");
+    wr32(header, 0x43425150u);
+    wr32(header + 4, 1);
+    wr32(header + 8, (uint32_t)js_len);
+    wr32(header + 12, fnv1a(js, js_len));
+    wr32(header + 16, (uint32_t)bc_len);
+    if (!(f = fopen(argv[2], "wb")) || fwrite(header, 1, 20, f) != 20 || fwrite(bc, 1, bc_len, f) != bc_len || fclose(f))
+        return die("cannot write the bytecode file");
+    printf("pocketqjsc: %zu bytes of JavaScript -> %zu bytes of bytecode\n", js_len, bc_len);
+    js_free(ctx, bc);
+    JS_FreeValue(ctx, fn);
+    JS_FreeContext(ctx);
+    JS_FreeRuntime(rt);
+    free(pkg);
+    return 0;
+}
