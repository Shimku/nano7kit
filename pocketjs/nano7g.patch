diff --git a/apps/nano7g-hero/app.ts b/apps/nano7g-hero/app.ts
new file mode 100644
index 00000000..2f570cb8
--- /dev/null
+++ b/apps/nano7g-hero/app.ts
@@ -0,0 +1,41 @@
+import { createSignal } from "solid-js";
+import { animate, createNodeRef } from "@pocketjs/framework/animation";
+import { frames, type i32 } from "@pocketjs/framework/solid/std";
+
+export const [count, setCount] = createSignal<i32>(0);
+export const [phase, setPhase] = createSignal<i32>(0);
+export const underline = createNodeRef();
+
+export function press(): void {
+  setCount(count() + 1);
+}
+
+export function minus(): void {
+  setCount(count() > 0 ? count() - 1 : 0);
+}
+
+export function reset(): void {
+  setCount(0);
+}
+
+export function reveal(): void {
+  animate(underline, "width", 180, { dur: 700 as i32, easing: "out", delay: 150 as i32 });
+}
+
+// The spinner turns while the underline grows (150 ms delay + 700 ms, about
+// 26 ticks at 30 Hz) and then stops: phase -1 shows the done mark instead.
+export const SPIN_STEPS: i32 = 9;
+export async function spin(): Promise<void> {
+  for (let step: i32 = 0; step < SPIN_STEPS; step++) {
+    await frames(2);
+    setPhase(phase() === 7 ? 0 : phase() + 1);
+    await frames(1);
+    setPhase(phase() === 7 ? 0 : phase() + 1);
+  }
+  setPhase(-1);
+}
+
+export function start(): void {
+  reveal();
+  spin();
+}
