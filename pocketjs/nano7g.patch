+/// Bytes the program keeps alive and unchanged for as long as any Ui reads
+/// them (on the iPod nano 7G: a package read whole into the app's heap,
+/// freed only with the block). Font atlases loaded from inside it are read
+/// in place instead of copied, which halves their RAM.
+static RESIDENT_START: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+static RESIDENT_END: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+
+/// Declare `[start, start + length)` resident; `length` 0 clears it.
+///
+/// # Safety
+/// The bytes stay valid and unmodified until the region is cleared and every
+/// Ui that loaded an atlas from it has been dropped (or is never used again).
+pub unsafe fn set_resident_region(start: *const u8, length: usize) {
+    use core::sync::atomic::Ordering;
+    RESIDENT_START.store(start as usize, Ordering::Relaxed);
+    RESIDENT_END.store(if length == 0 { 0 } else { start as usize + length }, Ordering::Relaxed);
+}
+
+fn resident(bytes: &[u8]) -> Option<&'static [u8]> {
+    use core::sync::atomic::Ordering;
+    let (start, end) = (RESIDENT_START.load(Ordering::Relaxed), RESIDENT_END.load(Ordering::Relaxed));
+    let at = bytes.as_ptr() as usize;
+    if end == 0 || at < start || at + bytes.len() > end {
+        return None;
+    }
+    // SAFETY: the caller of set_resident_region keeps the region alive.
+    Some(unsafe { core::slice::from_raw_parts(bytes.as_ptr(), bytes.len()) })
+}
