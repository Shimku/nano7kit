+import { Show } from "solid-js";
+import { MotionHandler, Text, View } from "@pocketjs/framework/solid/components";
+import { beta, center, gamma, live, tilt, x, y } from "./app";
+
+// 240 x 432 portrait (iPod nano 7th generation); motion from its accelerometer.
+export default function App() {
+  return (
+    <View debugName="TiltScreen" class="w-full h-full layout-baked bg-slate-900">
+      <MotionHandler value="tilt" minQuality="low" onUpdate={tilt} />
+      <Text class="absolute left-[12] top-[12] text-lg font-bold text-white">Tilt</Text>
+      <Text class="absolute left-[12] top-[40] text-xs text-slate-400">MOTION HANDLER, ACCELEROMETER</Text>
+      <View class="absolute left-[12] top-[62] w-[104] h-[28] rounded-lg bg-slate-800">
+        <Text class="absolute left-[8] top-[4] w-[92] h-[20] text-sm text-cyan-300">beta {beta()}</Text>
+      </View>
+      <View class="absolute left-[124] top-[62] w-[104] h-[28] rounded-lg bg-slate-800">
+        <Text class="absolute left-[8] top-[4] w-[92] h-[20] text-sm text-cyan-300">gamma {gamma()}</Text>
+      </View>
+      <View debugName="Arena" class="absolute left-[12] top-[100] w-[216] h-[240] rounded-xl bg-slate-800 contain-strict">
+        <View debugName="Ball" class="absolute left-0 top-0 w-[24] h-[24] rounded-[12px] bg-amber-400 shadow" style={{ translateX: x(), translateY: y() }} />
+      </View>
+      <View debugName="Status" class="absolute left-[12] top-[348] w-[216] h-[20]">
+        <Show when={!live()}><Text class="absolute left-0 top-0 w-[216] h-[20] text-xs text-amber-300">WAITING FOR MOTION DATA</Text></Show>
+      </View>
+      <View debugName="CenterAction" class="absolute left-[12] top-[376] w-[216] h-[44] items-center justify-center rounded-xl bg-blue-600 active:bg-blue-800 transition-colors duration-150" focusable onPress={center}>
+        <Text class="text-sm font-bold text-white">Center + set level</Text>
+      </View>
+    </View>
+  );
+}
