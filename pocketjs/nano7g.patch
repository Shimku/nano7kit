+#[test]
+fn tight_shape_masks_draw_the_same_pixels_in_less_memory() {
+    fn scene(tight: bool, scale: f64) -> (alloc::vec::Vec<u8>, usize) {
+        let mut ui = Ui::new();
+        ui.set_tight_masks(tight);
+        for (i, (r, border)) in [(3.0, 0.0), (7.0, 0.0), (11.0, 0.0), (19.0, 0.0), (30.0, 0.0), (6.0, 1.0), (9.0, 2.0)].iter().enumerate() {
+            let n = ui.create_node(0);
+            for (p, v) in [(spec::prop::WIDTH, 62.0), (spec::prop::HEIGHT, 60.0),
+                (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+                (spec::prop::INSET_L, 4.0 + (i % 4) as f64 * 70.0), (spec::prop::INSET_T, 4.0 + (i / 4) as f64 * 70.0),
+                (spec::prop::RADIUS, *r), (spec::prop::SCALE, scale)] { ui.set_prop(n, p, v); }
+            if *border > 0.0 {
+                ui.set_prop(n, spec::prop::WIDTH, 40.0);
+                ui.set_prop(n, spec::prop::HEIGHT, 30.0);
+                ui.set_prop(n, spec::prop::BORDER_WIDTH, *border);
+                ui.set_prop(n, spec::prop::BORDER_COLOR, abgr(37, 99, 235, 255) as f64);
+            } else {
+                ui.set_prop(n, spec::prop::BG_COLOR, abgr(200, 40, 90, 255) as f64);
+            }
+            ui.insert_before(spec::ROOT_ID, n, 0);
+        }
+        ui.tick();
+        let words = ui.draw().words.clone();
+        let mut pixels = alloc::vec![0; spec::SCREEN_W as usize * spec::SCREEN_H as usize * 4];
+        crate::raster::render(&ui, &words, &mut pixels);
+        (pixels, ui.shape_cache_bytes())
+    }
+    let (pow2, pow2_bytes) = scene(false, 1.0);
+    let (tight, tight_bytes) = scene(true, 1.0);
+    assert!(tight == pow2, "1:1 corners and borders are pixel-identical");
+    assert!(tight_bytes * 10 < pow2_bytes * 7, "{tight_bytes} vs {pow2_bytes}");
+    let (pow2, _) = scene(false, 0.9);
+    let (tight, _) = scene(true, 0.9);
+    let worst = pow2.iter().zip(tight.iter()).map(|(a, b)| (*a as i32 - *b as i32).abs()).max().unwrap();
+    assert!(worst <= 8, "scaled corners differ by at most a little edge AA: {worst}");
+}
