+//! The MicroTS apps this library can mount, one module each. build.rs turns
+//! every app named in NANO7G_SAMPLES into `crate::gen_<key>` and lists the
+//! enabled ones in `crate::SPECS`; only those modules are compiled.
+
+use alloc::boxed::Box;
+use microts::{Input, Ui};
+
+/// What the panel shows around an app whose viewport is not 240 x 432.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Pad {
+    /// The app fills the panel and is driven by touch alone.
+    None,
+    /// Touch alone, with the launcher's menu key at the top right instead of
+    /// the bottom right (apps whose on-screen keyboard docks at the bottom).
+    TopMenu,
+    /// An on-screen pad: D-pad, Circle, Cross, Start, Select, and (when
+    /// `wheel`) two buttons that turn the primary relative axis.
+    Buttons { wheel: bool },
+    /// Touch alone on the iPod held on its side (Home on the right): the app
+    /// fills the 432 x 240 view, the menu key sits at the top right.
+    Landscape,
+}
+
+/// The heap for measuring a new sample's ARM peak in the dry run
+/// (pocketjs/emu.py); give it a measured figure before shipping.
+#[allow(dead_code)]
+pub const HEAP_PROBE: usize = 2816 << 10;
+
+pub struct Spec {
+    pub key: &'static str,
+    pub title: &'static str,
+    pub logical: [u32; 2],
+    pub tick_hz: u32,
+    pub pad: Pad,
+    /// Mount with the first focusable node focused (button-driven apps).
+    pub focus: bool,
+    /// Feed accelerometer motion into Input.
+    pub motion: bool,
+    /// Bytes of Rust heap the app is given on the device: its measured ARM
+    /// peak plus a margin (docs: POCKETJS.md). The shim allocates exactly
+    /// this plus the private stack, so the OS keeps the rest.
+    pub heap: usize,
+    pub mount: fn(Ui) -> Box<dyn Sample>,
+}
+
+/// One mounted generated app, whatever its host and model types are.
+pub trait Sample {
+    fn frame(&mut self, input: &Input);
+    fn ui(&self) -> &Ui;
+    fn ui_mut(&mut self) -> &mut Ui;
+}
+
+/// Loads a generated app's styles, fonts and images into a fresh Ui.
+macro_rules! load {
+    ($gen:ident, $ui:ident) => {{
+        assert!($ui.load_styles(crate::$gen::STYLES));
+        crate::$gen::load_fonts(&mut $ui);
+        crate::$gen::load_images(&mut $ui);
+    }};
+}
+
+/// The common case: CoreHost, no props, the compiled model.
+macro_rules! plain_sample {
+    ($gen:ident) => {
+        use alloc::boxed::Box;
+        use microts::{Input, Ui};
+        type App = crate::$gen::generated::AppApp<crate::$gen::generated::AppModel>;
+        pub struct Mounted(App);
+        impl super::Sample for Mounted {
+            fn frame(&mut self, input: &Input) {
+                self.0.frame(input);
+            }
+            fn ui(&self) -> &Ui {
+                self.0.ui()
+            }
+            fn ui_mut(&mut self) -> &mut Ui {
+                self.0.ui_mut()
+            }
+        }
+        #[inline(never)]
+        pub fn mount(mut ui: Ui) -> Box<dyn super::Sample> {
+            load!($gen, ui);
+            Box::new(Mounted(App::new(
+                ui,
+                crate::$gen::generated::AppProps {},
+                crate::$gen::generated::AppModel::default(),
+            )))
+        }
+    };
+}
+
+#[cfg(sample_jshero)]
+pub mod jshero {
+    plain_sample!(gen_jshero);
+    pub const SPEC: super::Spec = super::Spec {
+        key: "jshero",
+        title: "JS Hero",
+        logical: [240, 432],
+        tick_hz: crate::gen_jshero::TICK_HZ,
+        pad: super::Pad::None,
+        focus: false,
+        motion: false,
+        heap: 512 << 10, // ARM peak 241,960 x 1.5 + 128 KiB
+        mount,
+    };
+}
+
+#[cfg(sample_gbahero)]
+pub mod gbahero {
+    plain_sample!(gen_gbahero);
+    pub const SPEC: super::Spec = super::Spec {
+        key: "gbahero",
+        title: "GBA Hero",
+        logical: [240, 160],
+        tick_hz: crate::gen_gbahero::TICK_HZ,
+        pad: super::Pad::Buttons { wheel: false },
+        focus: true,
+        motion: false,
+        heap: 704 << 10, // ARM peak 375,680 x 1.5 + 128 KiB
+        mount,
+    };
+}
+
+#[cfg(sample_nanohero)]
+pub mod nanohero {
+    plain_sample!(gen_nanohero);
+    pub const SPEC: super::Spec = super::Spec {
+        key: "nanohero",
+        title: "Nano 2G Hero",
+        logical: [176, 132],
+        tick_hz: crate::gen_nanohero::TICK_HZ,
+        pad: super::Pad::Buttons { wheel: false },
+        focus: true,
+        motion: false,
+        heap: 640 << 10, // ARM peak 314,668 x 1.5 + 128 KiB
+        mount,
+    };
+}
+
+#[cfg(sample_hero)]
+pub mod hero {
+    //! The PSP-class Hero (480 x 272) with the props apps/hero/main.tsx
+    //! passes, adjusted for this device.
+    use alloc::boxed::Box;
+    use microts::{Input, Ui};
+    use crate::gen_hero::generated as g;
+    type App = g::AppApp<'static, g::AppModel>;
+    pub struct Mounted(App);
+    impl super::Sample for Mounted {
+        fn frame(&mut self, input: &Input) {
+            self.0.frame(input);
+        }
+        fn ui(&self) -> &Ui {
+            self.0.ui()
+        }
+        fn ui_mut(&mut self) -> &mut Ui {
+            self.0.ui_mut()
+        }
+    }
+    #[inline(never)]
+    pub fn mount(mut ui: Ui) -> Box<dyn super::Sample> {
+        load!(gen_hero, ui);
+        let props = g::AppProps {
+            actionLabel: "Press Circle",
+            compact: false,
+            deviceLabel: "running on a 2012 iPod nano.",
+            headline: "",
+            largeLayout: false,
+            presentationHz: 30,
+            runtimeLabel: "RUST + NANOAPPS",
+            spinnerFrameStep: 0,
+            has_on_action: false,
