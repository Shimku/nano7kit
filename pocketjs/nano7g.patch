diff --git a/apps/nano7g-notebook/keyboard.tsx b/apps/nano7g-notebook/keyboard.tsx
new file mode 100644
index 00000000..2f8ad771
--- /dev/null
+++ b/apps/nano7g-notebook/keyboard.tsx
@@ -0,0 +1,225 @@
+import { createSignal } from "solid-js";
+import { Image, Text, View } from "@pocketjs/framework/solid/components";
+import { jump } from "@pocketjs/framework/animation";
+import { createGesture } from "@pocketjs/framework/gesture";
+import { onFrame } from "@pocketjs/framework/lifecycle";
+
+// A landscape QWERTY keyboard for the iPod nano 7G (432 x 240), shared by
+// Notes and Talk (pocketjs13). Keys are 40 x 30, far bigger than the OSK's;
+// a magnifier shows the key under the finger above it, and the key is typed
+// when the finger lifts, so sliding to the right key works. Each finger is
+// tracked on its own, so fast two-thumb typing does not drop keys. Holding
+// delete repeats.
+
+export type KeyAction = string; // one character, or "back", "enter", "left", "right"
+
+interface Key {
+  x: number;
+  y: number;
+  w: number;
+  /** Index into the layer labels, or -1 for a special key. */
+  slot: number;
+  action: string;
+}
+
+export const KB_H = 136;
+const PITCH = 43;
+const KW = 40;
+const KH = 30;
+const ROW = 34;
+
+// Three layers of 26 labelled slots: 10 + 9 + 7.
+const LOWER = "qwertyuiopasdfghjklzxcvbnm";
+const UPPER = "QWERTYUIOPASDFGHJKLZXCVBNM";
+const NUMS = "1234567890-/:;()&@\".,?!'#=+";
+
+function layout(): Key[] {
+  const keys: Key[] = [];
+  for (let i = 0; i < 10; i++) keys.push({ x: 2 + i * PITCH, y: 2, w: KW, slot: i, action: "" });
+  for (let i = 0; i < 9; i++) keys.push({ x: 23 + i * PITCH, y: 2 + ROW, w: KW, slot: 10 + i, action: "" });
+  keys.push({ x: 2, y: 2 + ROW * 2, w: 58, slot: -1, action: "shift" });
+  for (let i = 0; i < 7; i++) keys.push({ x: 66 + i * PITCH, y: 2 + ROW * 2, w: KW, slot: 19 + i, action: "" });
+  keys.push({ x: 370, y: 2 + ROW * 2, w: 60, slot: -1, action: "back" });
+  keys.push({ x: 2, y: 2 + ROW * 3, w: 58, slot: -1, action: "layer" });
+  keys.push({ x: 64, y: 2 + ROW * 3, w: 40, slot: -1, action: "left" });
+  keys.push({ x: 108, y: 2 + ROW * 3, w: 196, slot: -1, action: " " });
+  keys.push({ x: 308, y: 2 + ROW * 3, w: 40, slot: -1, action: "right" });
+  keys.push({ x: 352, y: 2 + ROW * 3, w: 78, slot: -1, action: "enter" });
+  return keys;
+}
+export const KEYS = layout();
+
+export interface KeyboardProps {
+  /** Top of the keyboard in screen pixels. */
+  top: number;
+  onKey(action: KeyAction): void;
+  /** The return key's label ("return", "send"). */
+  enter?: string;
+  active?: () => boolean;
+}
+
+export function Keyboard(props: KeyboardProps) {
+  const [layer, setLayer] = createSignal(0); // 0 lower, 1 shift, 2 caps, 3 numbers
+  const [bubble, setBubble] = createSignal("");
+  const views: unknown[] = [];
+  let bubbleView: unknown;
+  let shiftOn: unknown;
+  const held = new Map<number, number>(); // contact id -> key index
+  let backHeld = -1;
+  let backFrames = 0;
+  let lastShiftTap = -100;
+  let frame = 0;
+
+  const label = (slot: number) => {
+    const l = layer();
+    if (l === 3) return slot < NUMS.length ? NUMS[slot]! : "";
+    return l === 0 ? LOWER[slot]! : UPPER[slot]!;
+  };
+  const charOf = (k: Key) => (k.slot >= 0 ? label(k.slot) : k.action);
+
+  const at = (x: number, y: number): number => {
+    const ly = y - props.top;
+    let best = -1;
+    let bestD = 1e9;
+    for (let i = 0; i < KEYS.length; i++) {
+      const k = KEYS[i]!;
+      // nearest key centre within the row: no dead gaps between keys
+      if (ly < k.y - 2 || ly >= k.y + ROW - 2) continue;
+      const d = Math.abs(x - (k.x + k.w / 2)) - k.w / 2;
+      if (d < bestD) {
+        bestD = d;
+        best = i;
+      }
+    }
+    return best;
+  };
+
+  const showBubble = (i: number) => {
+    const k = KEYS[i];
+    if (!k || k.slot < 0) {
+      jump(bubbleView as never, "opacity", 0);
+      return;
+    }
+    setBubble(label(k.slot));
+    jump(bubbleView as never, "translateX", Math.max(0, Math.min(432 - 56, k.x + k.w / 2 - 28)));
+    jump(bubbleView as never, "translateY", props.top + k.y - 62);
+    jump(bubbleView as never, "opacity", 1);
+  };
+  const light = (i: number, on: boolean) => {
+    const k = KEYS[i];
+    if (!k || !views[i]) return;
+    const special = k.slot < 0 && k.action !== " ";
+    jump(views[i] as never, "bgColor", on ? "#aeaeb2" : special ? "#3a3a3c" : "#636366");
+  };
+
+  const type = (i: number) => {
+    const k = KEYS[i]!;
+    if (k.action === "shift") {
+      const l = layer();
+      if (l === 3) setLayer(0);
+      else if (frame - lastShiftTap < 12 && l === 1) setLayer(2); // double tap: caps lock
+      else setLayer(l === 0 ? 1 : 0);
+      lastShiftTap = frame;
+    } else if (k.action === "layer") {
+      setLayer(layer() === 3 ? 0 : 3);
+    } else if (k.action === "back") {
+      if (backFrames < 12) props.onKey("back");
+    } else {
+      props.onKey(charOf(k));
+      if (layer() === 1) setLayer(0);
+    }
+    jump(shiftOn as never, "opacity", layer() === 1 || layer() === 2 ? 1 : 0);
+  };
+
+  const enabled = () => (props.active ? props.active() : true);
+  createGesture({
+    region: { rect: () => (enabled() ? { x: 0, y: props.top, w: 432, h: KB_H } : { x: 0, y: 0, w: 0, h: 0 }) },
+    tapSlop: 1000,
+    panSlop: 1000,
+    onDown: (c) => {
+      const i = at(c.x, c.y);
+      if (i < 0) return;
+      held.set(c.id, i);
+      light(i, true);
+      showBubble(i);
+      if (KEYS[i]!.action === "back") {
+        backHeld = c.id;
+        backFrames = 0;
+      }
+    },
+    onMove: (c) => {
+      const was = held.get(c.id);
+      if (was === undefined) return;
+      const i = at(c.x, c.y);
+      if (i < 0 || i === was) return;
+      light(was, false);
+      held.set(c.id, i);
+      light(i, true);
+      showBubble(i);
+      if (backHeld === c.id && KEYS[i]!.action !== "back") backHeld = -1;
+    },
+    onUp: (c) => {
+      const i = held.get(c.id);
+      held.delete(c.id);
+      if (i === undefined) return;
+      light(i, false);
+      if (held.size === 0) jump(bubbleView as never, "opacity", 0);
+      type(i);
+      if (backHeld === c.id) backHeld = -1;
+    },
+    onCancel: (c) => {
+      const i = held.get(c.id);
+      held.delete(c.id);
+      if (i !== undefined) light(i, false);
+      if (held.size === 0) jump(bubbleView as never, "opacity", 0);
+    },
+  });
+
+  onFrame(() => {
+    frame++;
+    if (backHeld >= 0) {
+      backFrames++;
+      if (backFrames >= 12 && backFrames % 3 === 0) props.onKey("back");
+    }
+  });
+
+  return (
+    <View class="absolute left-0 top-0 w-[432] h-[240]">
+      <View class="absolute left-0 w-[432] h-[136] bg-[#2c2c2e]" style={{ insetT: props.top }}>
+        {KEYS.map((k, i) => (
+          <View
+            ref={(el: unknown) => (views[i] = el)}
+            class={k.slot >= 0 || k.action === " " ? "absolute h-[30] rounded-md bg-[#636366] items-center justify-center" : "absolute h-[30] rounded-md bg-[#3a3a3c] items-center justify-center"}
+            style={{ insetL: k.x, insetT: k.y, width: k.w }}
+          >
+            {k.slot >= 0 ? (
+              <Text class="text-lg text-white">{label(k.slot)}</Text>
+            ) : k.action === "shift" ? (
+              <View class="w-[20] h-[20]">
+                <Image class="absolute left-0 top-0 w-[20] h-[20]" src="key-shift.svg" />
+                <View ref={(el: unknown) => (shiftOn = el)} class="absolute left-[-19] top-[-5] w-[58] h-[30] rounded-md bg-white items-center justify-center opacity-0">
+                  <Image class="w-[20] h-[20]" src="key-shift-on.svg" />
+                </View>
+              </View>
+            ) : k.action === "back" ? (
+              <Image class="w-[24] h-[20]" src="key-back.svg" />
+            ) : k.action === "left" ? (
+              <Image class="w-[16] h-[16]" src="key-left.svg" />
+            ) : k.action === "right" ? (
+              <Image class="w-[16] h-[16]" src="key-right.svg" />
+            ) : k.action === "layer" ? (
+              <Text class="text-sm text-white">{layer() === 3 ? "ABC" : "123"}</Text>
+            ) : k.action === "enter" ? (
+              <Text class="text-sm text-white">{props.enter ?? "return"}</Text>
+            ) : (
+              <Text class="text-sm text-[#d1d1d6]">space</Text>
+            )}
+          </View>
+        ))}
+      </View>
+      <View ref={(el: unknown) => (bubbleView = el)} class="absolute left-0 top-0 w-[56] h-[60] rounded-xl bg-[#8e8e93] items-center justify-center opacity-0">
+        <Text class="text-2xl text-white">{bubble()}</Text>
+      </View>
+    </View>
+  );
+}
