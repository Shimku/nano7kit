diff --git a/apps/nano7g-notes/app.tsx b/apps/nano7g-notes/app.tsx
new file mode 100644
index 00000000..f2b217e4
--- /dev/null
+++ b/apps/nano7g-notes/app.tsx
@@ -0,0 +1,117 @@
+import { createSignal, For } from "solid-js";
+import { Text, View } from "@pocketjs/framework/solid/components";
+import { existsSync, file, readdirSync, rmSync, usage, write } from "@pocketjs/framework/fs";
+
+// Notes on the iPod nano 7G: data.fs in /Apps/Data/PocketJS/notes/ on the
+// iPod. The launch count is read and rewritten each time the app opens, so
+// it survives quitting and rebooting; Save writes one more note file, Delete
+// removes the newest, Clear removes the folder. Every call is caught: an
+// error shows on screen (and as PJFSERR in the log), it never stops the app.
+const SHOWN = 6;
+
+function message(e: unknown): string {
+  return String(e instanceof Error ? e.message : e).replace(/^fs: /, "").slice(0, 34);
+}
+
+function noteNames(): string[] {
+  if (!existsSync("notes")) return [];
+  return readdirSync("notes").filter((n) => n.endsWith(".txt")).sort();
+}
+
+export default function App() {
+  const [launches, setLaunches] = createSignal(0);
+  const [notes, setNotes] = createSignal<{ name: string; text: string }[]>([]);
+  const [count, setCount] = createSignal(0);
+  const [used, setUsed] = createSignal("");
+  const [status, setStatus] = createSignal("");
+
+  const refresh = () => {
+    try {
+      const names = noteNames();
+      setCount(names.length);
+      setNotes(names.slice(-SHOWN).reverse().map((name) => ({ name, text: file(`notes/${name}`).text() })));
+      const u = usage();
+      setUsed(`${u.usedBytes} OF ${u.quotaBytes} BYTES USED`);
+    } catch (e) {
+      setStatus(`ERROR ${message(e)}`);
+    }
+  };
+
+  try {
+    const before = existsSync("launches.txt") ? Number(file("launches.txt").text()) || 0 : 0;
+    write("launches.txt", String(before + 1));
+    setLaunches(before + 1);
+    setStatus(before === 0 ? "FIRST OPEN: NOTHING SAVED YET" : "LOADED FROM THE IPOD");
+  } catch (e) {
+    setStatus(`ERROR ${message(e)}`);
+  }
+  refresh();
+
+  const save = () => {
+    try {
+      const names = noteNames();
+      const last = names.length ? Number(names[names.length - 1]!.slice(5, 8)) || 0 : 0;
+      const k = last + 1;
+      const name = `note-${String(k).padStart(3, "0")}.txt`;
+      write(`notes/${name}`, `Note ${k}, saved on launch ${launches()}`);
+      setStatus(`SAVED ${name.toUpperCase()}`);
+    } catch (e) {
+      setStatus(`ERROR ${message(e)}`);
+    }
+    refresh();
+  };
+  const remove = () => {
+    try {
+      const names = noteNames();
+      if (!names.length) setStatus("NO NOTES TO DELETE");
+      else {
+        file(`notes/${names[names.length - 1]}`).delete();
+        setStatus(`DELETED ${names[names.length - 1]!.toUpperCase()}`);
+      }
+    } catch (e) {
+      setStatus(`ERROR ${message(e)}`);
+    }
+    refresh();
+  };
+  const clear = () => {
+    try {
+      if (!existsSync("notes")) setStatus("NOTHING TO CLEAR");
+      else {
+        rmSync("notes", { recursive: true });
+        setStatus("CLEARED ALL NOTES");
+      }
+    } catch (e) {
+      setStatus(`ERROR ${message(e)}`);
+    }
+    refresh();
+  };
+
+  return (
+    <View class="w-full h-full bg-slate-900">
+      <Text class="absolute left-[12] top-[10] text-xl font-bold text-white">Notes</Text>
+      <Text class="absolute left-[12] top-[42] text-xs text-slate-300">{`OPENED ${launches()} ${launches() === 1 ? "TIME" : "TIMES"} ON THIS IPOD`}</Text>
+      <Text class="absolute left-[12] top-[60] text-xs text-slate-300">{`${count()} ${count() === 1 ? "NOTE" : "NOTES"} SAVED`}</Text>
