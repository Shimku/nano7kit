diff --git a/apps/nano7g-gestures/app.tsx b/apps/nano7g-gestures/app.tsx
new file mode 100644
index 00000000..cd38749b
--- /dev/null
+++ b/apps/nano7g-gestures/app.tsx
@@ -0,0 +1,123 @@
+import { createSignal } from "solid-js";
+import { Image, Text, View } from "@pocketjs/framework/solid/components";
+import { animate, jump } from "@pocketjs/framework/animation";
+import { createGesture } from "@pocketjs/framework/gesture";
+
+// Gestures on the iPod nano 7G: swipe the cards (a pan on x with a fling),
+// pinch the ball (two fingers, from the OS's per-finger lists), tap to count.
+// Positions and scale are written straight to the nodes (jump/animate), so a
+// finger-follow frame runs no layout.
+const W = 240;
+const CARDS = 4;
+const STRIP_Y = 40;
+const STRIP_H = 200;
+const PINCH_Y = 280;
+const PINCH_H = 140;
+const NAMES = ["One", "Two", "Three", "Four"];
+
+export default function App() {
+  const [card, setCard] = createSignal(0);
+  const [zoom, setZoom] = createSignal(100);
+  const [taps, setTaps] = createSignal(0);
+  const [fingers, setFingers] = createSignal(0);
+  let strip: unknown;
+  let ball: unknown;
+  let scale = 1;
+  let startScale = 1;
+  const live = new Set<number>();
+
+  const inStrip = () => ({ x: 0, y: STRIP_Y, w: W, h: STRIP_H });
+  const inPinch = () => ({ x: 0, y: PINCH_Y, w: W, h: PINCH_H });
+  const settle = (index: number) => {
+    setCard(index);
+    animate(strip as never, "translateX", -index * W, { dur: 220, easing: "out" });
+  };
+
+  // How many fingers are down: every recognizer adds a contact when it
+  // lands and removes it when it lifts. A cancel only means another
+  // recognizer claimed the contact (a pan or a pinch): the finger is still
+  // down, and the winner sees it lift (pocketjs12; the count fell to 0
+  // during a pinch before).
+  const down = (c: { id: number }) => {
+    live.add(c.id);
+    setFingers(live.size);
+  };
+  const up = (c: { id: number }) => {
+    live.delete(c.id);
+    setFingers(live.size);
+  };
+  createGesture({ onDown: down, onUp: up });
+
+  createGesture({
+    axis: "x",
+    region: { rect: inStrip },
+    onDown: down,
+    onUp: up,
+    onPanMove: (c) => jump(strip as never, "translateX", -card() * W + c.dx),
+    onPanEnd: (c) => {
+      let next = card();
+      if (c.dx < -W / 4 || c.vx < -300) next = Math.min(CARDS - 1, next + 1);
+      else if (c.dx > W / 4 || c.vx > 300) next = Math.max(0, next - 1);
+      settle(next);
+    },
+    onTap: () => setTaps(taps() + 1),
+  });
+
+  createGesture({
+    region: { rect: inPinch },
+    onDown: down,
+    onUp: up,
+    onPinchStart: () => {
+      startScale = scale;
+    },
+    onPinchMove: (p) => {
+      if (p.startSpan <= 0) return;
+      scale = Math.max(0.5, Math.min(2, (startScale * p.span) / p.startSpan));
+      jump(ball as never, "scale", scale);
+      setZoom(Math.round(scale * 100));
+    },
+    onTap: () => setTaps(taps() + 1),
+  });
+
+  return (
+    <View class="w-full h-full bg-slate-900">
+      <Text class="absolute left-[12] top-[10] text-xs text-slate-300">GESTURES ON A NANO</Text>
+      <Text class="absolute right-[12] top-[10] text-xs text-slate-300">{`FINGERS ${fingers()}`}</Text>
+      <View class="absolute left-0 top-[40] w-[240] h-[200]">
+        <View ref={(el: unknown) => (strip = el)} class="absolute left-0 top-0 w-[960] h-[200] flex-row">
+          <View class="w-[240] h-[200] p-3">
+            <View class="w-full h-full flex-col rounded-xl items-center justify-center gap-2 bg-blue-600">
+              <Text class="text-xl font-bold text-white">One</Text>
+              <Text class="text-xs text-white">CARD 1 OF 4</Text>
+            </View>
+          </View>
+          <View class="w-[240] h-[200] p-3">
+            <View class="w-full h-full flex-col rounded-xl items-center justify-center gap-2 bg-emerald-600">
+              <Text class="text-xl font-bold text-white">Two</Text>
+              <Text class="text-xs text-white">CARD 2 OF 4</Text>
+            </View>
+          </View>
+          <View class="w-[240] h-[200] p-3">
+            <View class="w-full h-full flex-col rounded-xl items-center justify-center gap-2 bg-amber-500">
+              <Text class="text-xl font-bold text-white">Three</Text>
+              <Text class="text-xs text-white">CARD 3 OF 4</Text>
+            </View>
+          </View>
+          <View class="w-[240] h-[200] p-3">
+            <View class="w-full h-full flex-col rounded-xl items-center justify-center gap-2 bg-rose-600">
+              <Text class="text-xl font-bold text-white">Four</Text>
+              <Text class="text-xs text-white">CARD 4 OF 4</Text>
+            </View>
+          </View>
+        </View>
+      </View>
+      <Text class="absolute left-[12] top-[248] text-sm text-slate-300">{`Swipe the cards: ${NAMES[card()]}`}</Text>
+      <View class="absolute left-0 top-[280] w-[240] h-[140] bg-slate-800 items-center justify-center">
+        <Image ref={(el: unknown) => (ball = el)} class="w-[72] h-[72]" src="nano7g-ball-violet.svg" />
+      </View>
+      <Text class="absolute left-[12] top-[288] text-xs text-slate-400">{`PINCH ${zoom()}%`}</Text>
+      <Text class="absolute right-[12] top-[288] text-xs text-slate-400">{`TAPS ${taps()}`}</Text>
+      <Text class="absolute left-[12] top-[304] text-xs text-slate-300">PINCH WITH 2 FINGERS, TAP: +1</Text>
+    </View>
+  );
+}
