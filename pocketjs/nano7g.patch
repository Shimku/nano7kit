+/// Free a core-owned texture handle (a baked shape mask), as `free_texture`
+/// does: storage a pending submission reads moves aside, the slot's
+/// generation is bumped so old handles go stale. Stale handles are no-ops.
+pub(crate) fn tex_release(slots: &mut [TexSlot], free: &mut Vec<u32>, handle: i32) {
+    let Some(slot) = tex_resolve(slots, handle) else { return; };
+    let s = &mut slots[slot as usize];
+    s.vacate();
+    s.gen = ((s.gen as u32 + 1) & TEX_GEN_MASK) as u16;
+    free.push(slot);
+}
