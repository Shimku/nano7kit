+//! Device-local io.offload provider for QuickJS packages on the nano 7G
+//! (`globalThis.offload.local`, the protocol of platforms/psp/io/src/local.rs).
+//!
+//! The PSP serves it from a worker thread with seeking file reads. The nano
+//! app runs on one heartbeat and its file API reads from the start of a file
+//! only, so this provider answers one request per frame, synchronously, and
+//! a font archive is read whole into the app's block (capped at
+//! `MAX_ARCHIVE`) and then served from memory. Paths are relative to
+//! /Apps/Data/PocketJS and confined to it; nothing is ever written.
+use alloc::{boxed::Box, string::String, vec};
+use core::fmt::Write;
+use pocket_package::font_archive::{Archive, ReadAt};
+
+/// The largest archive read into the block (the Fonts sample's is 160 KB).
+pub const MAX_ARCHIVE: u32 = 1 << 20;
+const MAX_TEXT: u32 = 1536;
+const ROOT: &[u8] = b"/Apps/Data/PocketJS/";
+
+extern "C" {
+    fn pocketnano_file_size(path: *const u8) -> u32;
+    fn pocketnano_file_read(path: *const u8, buffer: *mut u8, max: u32) -> u32;
+}
+
+struct Memory(Box<[u8]>);
+impl ReadAt for Memory {
+    fn read_at(&mut self, offset: u32, out: &mut [u8]) -> bool {
+        let start = offset as usize;
+        match self.0.get(start..start + out.len()) {
+            Some(src) => {
+                out.copy_from_slice(src);
+                true
+            }
+            None => false,
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Request {
+    id: u32,
+    op: u8,
+    path: [u8; 128],
+    path_len: usize,
+    generation: u32,
+    slot: u8,
+    count: u8,
+    cps: [u32; 4],
+}
+
+struct State {
+    session: i32,
+    pending: Option<Request>,
+    sent: bool,
+    archive: Option<Archive<Memory>>,
+    generation: u32,
+    reply: String,
+    frames: u32,
+}
+
+static mut STATE: State = State {
+    session: 1,
+    pending: None,
+    sent: false,
+    archive: None,
+    generation: 0,
+    reply: String::new(),
+    frames: 0,
+};
+
+#[allow(static_mut_refs)]
+unsafe fn state() -> &'static mut State {
+    &mut STATE
+}
+
+/// The app's block is freed whole when it stops: forget what lived in it and
+/// start a new session, so a stale reply never reaches the next app.
+pub unsafe fn reset() {
+    let s = state();
+    core::mem::forget(s.archive.take());
+    core::mem::forget(core::mem::take(&mut s.reply));
+    s.pending = None;
+    s.sent = false;
+    s.session = s.session.wrapping_add(1).max(1);
+}
+
+/// One frame boundary: the client may submit again.
+pub unsafe fn frame() {
+    let s = state();
+    s.sent = false;
+    s.frames = s.frames.wrapping_add(1);
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_local_session() -> i32 {
+    state().session
+}
+
+/// One request per frame, as on the PSP; false when one is already queued.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_local_submit(
+    id: u32,
+    op: u32,
+    path: *const u8,
+    path_len: usize,
+    generation: u32,
+    slot: u32,
+    count: u32,
+    cps: *const u32,
+) -> bool {
+    let s = state();
+    if s.sent || s.pending.is_some() || id == 0 || path_len >= 128 || count > 4 || slot >= 24 {
+        return false;
+    }
+    let mut r = Request { id, op: op as u8, path: [0; 128], path_len, generation, slot: slot as u8, count: count as u8, cps: [0; 4] };
+    if path_len > 0 {
+        r.path[..path_len].copy_from_slice(core::slice::from_raw_parts(path, path_len));
+    }
+    if count > 0 {
+        r.cps[..count as usize].copy_from_slice(core::slice::from_raw_parts(cps, count as usize));
+    }
+    s.pending = Some(r);
+    s.sent = true;
+    true
+}
+
+/// Serve the queued request; the reply stays valid until the next call.
+/// Returns its length (0: nothing to take).
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_local_take(out: *mut *const u8) -> usize {
+    let s = state();
+    let Some(r) = s.pending.take() else { return 0 };
+    let mut payload = String::new();
+    let result = run(s, &r, &mut payload);
+    let mut reply = String::new();
+    let _ = write!(reply, "{{\"id\":{},", r.id);
+    match result {
+        Ok(()) => {
+            reply.push_str("\"payload\":");
+            quote(&mut reply, &payload);
+        }
+        Err(e) => {
+            reply.push_str("\"error\":");
+            quote(&mut reply, e);
+        }
+    }
+    reply.push('}');
+    s.reply = reply;
+    *out = s.reply.as_ptr();
+    s.reply.len()
+}
+
+fn quote(out: &mut String, s: &str) {
+    out.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if c < ' ' => {
+                let _ = write!(out, "\\u{:04x}", c as u32);
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+}
+
+/// A NUL-terminated /Apps/Data/PocketJS path, or why not.
+pub fn full_path(path: &[u8]) -> Result<[u8; 160], &'static str> {
+    if path.is_empty()
+        || path[0] == b'/'
+        || path.windows(2).any(|w| w == b"..")
+        || path.iter().any(|c| !c.is_ascii_alphanumeric() && !b"/._-".contains(c))
+    {
+        return Err("Invalid local path");
+    }
+    let mut full = [0u8; 160];
+    if ROOT.len() + path.len() + 1 > full.len() {
+        return Err("Path too long");
+    }
+    full[..ROOT.len()].copy_from_slice(ROOT);
+    full[ROOT.len()..ROOT.len() + path.len()].copy_from_slice(path);
+    Ok(full)
+}
+
+unsafe fn read_whole(path: &[u8], cap: u32, what: &'static str) -> Result<Box<[u8]>, &'static str> {
+    let full = full_path(path)?;
+    let size = pocketnano_file_size(full.as_ptr());
+    if size == 0 {
+        return Err("Local file unavailable");
+    }
+    if size > cap {
+        return Err(what);
+    }
+    let mut bytes = vec![0u8; size as usize].into_boxed_slice();
+    if pocketnano_file_read(full.as_ptr(), bytes.as_mut_ptr(), size) != size {
+        return Err("Local file read failed");
+    }
+    Ok(bytes)
+}
+
+unsafe fn run(s: &mut State, r: &Request, payload: &mut String) -> Result<(), &'static str> {
+    let path = &r.path[..r.path_len];
+    match r.op {
+        1 => {
+            let bytes = read_whole(path, MAX_ARCHIVE, "Font archive exceeds 1 MiB (read whole on the nano)")?;
+            let len = bytes.len() as u32;
+            let face = Archive::open(Memory(bytes), len).map_err(|e| e.message())?;
+            s.generation = s.generation.wrapping_add(1).max(1);
+            let _ = write!(payload, "{{\"generation\":{},\"identity\":\"", s.generation);
+            for b in face.identity {
+                let _ = write!(payload, "{:02x}", b);
+            }
+            payload.push_str("\",\"strikes\":[");
+            for (i, k) in face.strikes[..face.count].iter().enumerate() {
+                let _ = write!(
+                    payload,
+                    "{}[{},{},{},{},{},{},{},{}]",
+                    if i > 0 { "," } else { "" },
+                    k.slot, k.width, k.height, k.baseline, k.line_height, k.advance, k.density, k.count
+                );
+            }
+            payload.push_str("]}");
+            s.archive = Some(face);
+        }
+        2 => {
+            if r.generation != s.generation {
+                return Err("Stale font generation");
+            }
+            let generation = s.generation;
+            let face = s.archive.as_mut().ok_or("Font archive not open")?;
+            let mut bytes = [0u8; 1250];
+            let n = face
+                .batch(generation, r.slot, &r.cps[..r.count as usize], &mut bytes)
+                .map_err(|e| e.message())?;
+            for b in &bytes[..n] {
+                let _ = write!(payload, "{:02x}", b);
+            }
+        }
+        3 => {
+            let k = s.archive.as_ref().ok_or("Font archive not open")?.stats;
+            let _ = write!(
+                payload,
+                "{{\"reads\":{},\"bytes\":{},\"indexHits\":{},\"glyphs\":{},\"missing\":{},\"failures\":{},\"frames\":{},\"frameUs\":0,\"maxFrameUs\":0}}",
+                k.reads, k.bytes, k.index_hits, k.glyphs, k.missing, k.failures, s.frames
+            );
+        }
+        4 => {
+            let bytes = read_whole(path, MAX_TEXT, "Text file exceeds 1536 bytes")?;
+            payload.push_str(core::str::from_utf8(&bytes).map_err(|_| "Text is not UTF-8")?);
+        }
+        5 => {
+            s.archive = None;
+            payload.push_str("closed");
+        }
+        _ => return Err("Unsupported local capability"),
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::full_path;
+
+    #[test]
+    fn paths_stay_in_the_data_folder() {
+        assert!(full_path(b"fonts/intl.pjfa").is_ok());
+        assert!(full_path(b"/Apps/x").is_err());
+        assert!(full_path(b"../Notes/a.txt").is_err());
+        assert!(full_path(b"a b").is_err());
+        let p = full_path(b"x.txt").unwrap();
+        assert!(p.starts_with(b"/Apps/Data/PocketJS/x.txt\0"));
+    }
+}
diff --git a/programs/nano7g/src/motion.rs b/programs/nano7g/src/motion.rs
new file mode 100644
index 00000000..2512153f
--- /dev/null
+++ b/programs/nano7g/src/motion.rs
@@ -0,0 +1,117 @@
+//! Gravity-level motion from the 7G accelerometer.
+//!
+//! The OS polls the accelerometer and keeps the last sample in RAM (the
+//! NanoApps SDK's hb_accel_read_raw, 1/65536 g per count). This is the
+//! "native motion driver" the MicroTS motion contract expects: it low-pass
+//! filters the samples and publishes gravity direction, inclination, screen
+//! rotation and W3C tilt. The axis signs follow the SDK's note (flat on its
+//! back reads about +1 g on z) and the W3C device frame (+x right edge, +y top
+//! edge, +z out of the screen); they are not yet checked on hardware.
+
+use microts::motion::{MotionPair, MotionScalar, MotionState, MotionVector};
+use microts::spec::motion::quality;
+
+#[derive(Default)]
+pub struct Filter {
+    filtered: Option<[f32; 3]>,
+}
+
+const DEG: f32 = 180.0 / core::f32::consts::PI;
+
+impl Filter {
+    /// `raw` in 1/65536 g. Returns None until a non-zero sample arrives.
+    pub fn update(&mut self, raw: [i32; 3], now_us: u64) -> Option<MotionState> {
+        let sample = raw.map(|v| v as f32 / 65536.0);
+        let norm = libm::sqrtf(sample.iter().map(|v| v * v).sum());
+        if !(0.2..5.0).contains(&norm) {
+            return self.filtered.map(|f| state(f, now_us));
+        }
+        let f = match self.filtered {
+            None => sample,
+            Some(old) => [0, 1, 2].map(|i| old[i] + 0.25 * (sample[i] - old[i])),
+        };
+        self.filtered = Some(f);
+        Some(state(f, now_us))
+    }
+}
+
+/// `a` is the measured reaction to gravity (points up), in g.
+fn state(a: [f32; 3], timestamp: u64) -> MotionState {
+    let norm = libm::sqrtf(a.iter().map(|v| v * v).sum()).max(1e-6);
+    let up = a.map(|v| v / norm);
+    let down = up.map(|v| -v);
+    let inclination = libm::acosf(up[2].clamp(-1.0, 1.0)) * DEG;
+    let near_flat = !(25.0..=155.0).contains(&inclination);
+    let beta = libm::atan2f(up[1], up[2]) * DEG;
+    let gamma = libm::atan2f(-up[0], libm::sqrtf(up[1] * up[1] + up[2] * up[2])) * DEG;
+    let rotation = libm::atan2f(-down[0], -down[1]) * DEG;
+    MotionState {
+        timestamp,
+        gravity_direction: MotionVector { value: down, quality: quality::MEDIUM },
+        inclination: MotionScalar { value: inclination, quality: quality::MEDIUM },
+        screen_rotation: MotionScalar {
+            value: if rotation <= -180.0 { 180.0 } else { rotation },
+            quality: if near_flat { quality::UNRELIABLE } else { quality::MEDIUM },
+        },
+        tilt: MotionPair { value: [beta, gamma], quality: quality::MEDIUM },
+        ..MotionState::default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn flat_and_upright() {
+        let mut f = Filter::default();
+        let flat = f.update([0, 0, 65536], 1).unwrap();
+        assert!(flat.inclination.value.abs() < 0.5);
+        assert!(flat.tilt.value[0].abs() < 0.5 && flat.tilt.value[1].abs() < 0.5);
+        let mut f = Filter::default();
+        let upright = f.update([0, 65536, 0], 1).unwrap();
+        assert!((upright.tilt.value[0] - 90.0).abs() < 0.5);
+        assert!(upright.screen_rotation.value.abs() < 0.5);
+    }
+}
+
+/// The Runtime carries motion in the driver ABI's shape; these convert the
+/// gravity-level members both ways.
+pub fn to_driver(m: &MotionState) -> pocket_drivers::MotionState {
+    use pocket_drivers::abi::*;
+    let mut out = pocket_drivers::MotionState::default();
+    out.timestamp = m.timestamp;
+    let mut g = PocketMotionGravityDirection::empty();
+    g.value = m.gravity_direction.value;
+    g.quality = m.gravity_direction.quality;
+    out.gravity_direction = Some(g);
+    let mut i = PocketMotionInclination::empty();
+    i.value = [m.inclination.value];
+    i.quality = m.inclination.quality;
+    out.inclination = Some(i);
+    let mut r = PocketMotionScreenRotation::empty();
+    r.value = [m.screen_rotation.value];
+    r.quality = m.screen_rotation.quality;
+    out.screen_rotation = Some(r);
+    let mut t = PocketMotionTilt::empty();
+    t.value = m.tilt.value;
+    t.quality = m.tilt.quality;
+    out.tilt = Some(t);
+    out
+}
+
+pub fn from_driver(m: &pocket_drivers::MotionState) -> MotionState {
+    let mut out = MotionState { timestamp: m.timestamp, ..MotionState::default() };
+    if let Some(g) = m.gravity_direction {
+        out.gravity_direction = MotionVector { value: g.value, quality: g.quality };
+    }
+    if let Some(i) = m.inclination {
+        out.inclination = MotionScalar { value: i.value[0], quality: i.quality };
+    }
+    if let Some(r) = m.screen_rotation {
+        out.screen_rotation = MotionScalar { value: r.value[0], quality: r.quality };
+    }
+    if let Some(t) = m.tilt {
+        out.tilt = MotionPair { value: t.value, quality: t.quality };
+    }
+    out
+}
diff --git a/programs/nano7g/src/nanoapps.rs b/programs/nano7g/src/nanoapps.rs
new file mode 100644
index 00000000..ec3c92d6
--- /dev/null
+++ b/programs/nano7g/src/nanoapps.rs
@@ -0,0 +1,385 @@
+//! The C ABI the NanoApps shim calls, plus the allocator and panic path.
+//!
+//! A cached relaunch re-enters the app without reloading its image: the
+//! shim zeroes .bss, but .data keeps the last run's values. Every static
+//! here lives in .bss (zero is its idle state) and `pocketnano_start`
+//! rebuilds the allocator before anything allocates.
+use super::{Stage, Touch, MAX_REGIONS};
+use core::{
+    alloc::{GlobalAlloc, Layout},
+    cell::UnsafeCell,
+    mem::MaybeUninit,
+};
+use linked_list_allocator::Heap;
+
+extern "C" {
+    /// Logs the failure, shows it on screen and parks the app.
+    fn pocketnano_fail(code: u32, line: u32) -> !;
+    fn pocketnano_fail_msg(code: u32, line: u32, text: *const u8, length: u32) -> !;
+}
+// QuickJS builds: one dlmalloc space over the block serves Rust, QuickJS and
+// libc alike (programs/nano7g/nanoapps/pocketqjs.c).
+#[cfg(feature = "quickjs")]
+extern "C" {
+    fn pocketqjs_heap_init(base: *mut u8, length: usize);
+    fn pocketqjs_alloc(size: usize, align: usize) -> *mut u8;
+    fn pocketqjs_realloc(ptr: *mut u8, size: usize, align: usize) -> *mut u8;
+    fn pocketqjs_free(ptr: *mut u8);
+    fn pocketqjs_heap_used() -> usize;
+    fn pocketqjs_heap_peak() -> usize;
+}
+
+// NanoApps code runs on the OS heartbeat; no interrupt handler touches
+// the app, so a critical section has nothing to exclude.
+struct AppCriticalSection;
+critical_section::set_impl!(AppCriticalSection);
+unsafe impl critical_section::Impl for AppCriticalSection {
+    unsafe fn acquire() -> bool {
+        false
+    }
+    unsafe fn release(_: bool) {}
+}
+
+struct Allocator(UnsafeCell<MaybeUninit<Heap>>);
+unsafe impl Sync for Allocator {}
+unsafe impl GlobalAlloc for Allocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        if !READY {
+            return core::ptr::null_mut();
+        }
+        #[cfg(feature = "quickjs")]
+        {
+            pocketqjs_alloc(layout.size(), layout.align())
+        }
+        #[cfg(not(feature = "quickjs"))]
+        {
+            let heap = (*self.0.get()).assume_init_mut();
+            let result = heap.allocate_first_fit(layout).map_or(core::ptr::null_mut(), |p| p.as_ptr());
+            if heap.used() > PEAK {
+                PEAK = heap.used();
+            }
+            result
+        }
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        if READY {
+            #[cfg(feature = "quickjs")]
+            {
+                let _ = layout;
+                pocketqjs_free(ptr);
+            }
+            #[cfg(not(feature = "quickjs"))]
+            (*self.0.get()).assume_init_mut().deallocate(core::ptr::NonNull::new_unchecked(ptr), layout);
+        }
+    }
+    #[cfg(feature = "quickjs")]
+    #[allow(unused_variables)]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        if !READY {
+            return core::ptr::null_mut();
+        }
+        pocketqjs_realloc(ptr, size, layout.align())
+    }
+}
+#[global_allocator]
+static ALLOCATOR: Allocator = Allocator(UnsafeCell::new(MaybeUninit::zeroed()));
+static mut READY: bool = false;
+static mut PEAK: usize = 0;
+static mut LIVE: bool = false;
+static mut STAGE: MaybeUninit<Stage> = MaybeUninit::zeroed();
+static mut TITLE: [u8; 40] = [0; 40];
+
+/// Fixed-size text for the panic message: no allocation (the heap may be
+/// what ran out).
+struct PanicText {
+    buf: [u8; 120],
+    len: usize,
+}
+
+impl core::fmt::Write for PanicText {
+    fn write_str(&mut self, s: &str) -> core::fmt::Result {
+        for &b in s.as_bytes() {
+            if self.len < self.buf.len() {
+                self.buf[self.len] = b;
+                self.len += 1;
+            }
+        }
+        Ok(())
+    }
+}
+
+static mut PANIC_TEXT: PanicText = PanicText { buf: [0; 120], len: 0 };
+
+/// pocketjs15: the red screen and the log say what panicked and where, not
+/// only a line number. An allocation failure (alloc.rs, "memory allocation
+/// of N bytes failed") reads OUT OF MEMORY with the size.
+fn panic_text(out: &mut PanicText, info: &core::panic::PanicInfo) {
+    use core::fmt::Write;
+    out.len = 0;
+    let message = info.message();
+    let mut probe = PanicText { buf: [0; 120], len: 0 };
+    let _ = write!(probe, "{}", message);
+    let text = &probe.buf[..probe.len];
+    const OOM: &[u8] = b"memory allocation of ";
+    if text.starts_with(OOM) {
+        let _ = out.write_str("OUT OF MEMORY: ");
+        let rest = &text[OOM.len()..];
+        let n = rest.iter().position(|&b| b == b' ').unwrap_or(rest.len());
+        let _ = out.write_str(core::str::from_utf8(&rest[..n]).unwrap_or("?"));
+        let _ = out.write_str(" BYTES MORE");
+    } else {
+        let _ = out.write_str(core::str::from_utf8(text).unwrap_or("panic"));
+    }
+    if let Some(location) = info.location() {
+        let file = location.file();
+        let file = file.rsplit('/').next().unwrap_or(file);
+        let _ = write!(out, " ({}:{})", file, location.line());
+    }
+}
+
+#[panic_handler]
+fn panic(info: &core::panic::PanicInfo) -> ! {
+    let line = info.location().map_or(0, |location| location.line());
+    // SAFETY: one thread; a panic inside the panic handler never returns
+    // here (the shim's longjmp), so the buffer is not reentered.
+    unsafe {
+        let out = &mut *core::ptr::addr_of_mut!(PANIC_TEXT);
+        panic_text(out, info);
+        if out.len == 0 {
+            pocketnano_fail(1, line)
+        }
+        pocketnano_fail_msg(1, line, out.buf.as_ptr(), out.len as u32)
+    }
+}
+
+/// How many apps this library holds (more than one: the shim shows a menu).
+#[no_mangle]
+pub extern "C" fn pocketnano_count() -> u32 {
+    super::app_count() as u32
+}
+
+/// Rows of the shim's own list (the rest are on the home screen only).
+#[no_mangle]
+pub extern "C" fn pocketnano_menu_count() -> u32 {
+    super::menu_count() as u32
+}
+
+/// App index for a spec key of `len` bytes, or -1.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_find(key: *const u8, len: u32) -> i32 {
+    super::find_key(core::slice::from_raw_parts(key, len as usize))
+}
+
+/// App `index`'s spec key, NUL-terminated (valid until the next call).
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_key(index: u32) -> *const u8 {
+    let out = (*core::ptr::addr_of_mut!(TITLE)).as_mut_ptr();
+    let text = if (index as usize) < super::app_count() { super::spec_at(index as usize).key } else { "" }.as_bytes();
+    let n = text.len().min(39);
+    core::ptr::copy_nonoverlapping(text.as_ptr(), out, n);
+    *out.add(n) = 0;
+    out
+}
+
+/// App `index`'s title as a NUL-terminated string (valid until the next call).
+/// Rust heap bytes app `index` needs (0: no such app).
+#[no_mangle]
+pub extern "C" fn pocketnano_heap_need(index: u32) -> u32 {
+    super::heap_need(index as usize) as u32
+}
+
+/// Private stack bytes app `index` needs beyond the default.
+#[no_mangle]
+pub extern "C" fn pocketnano_stack_extra(index: u32) -> u32 {
+    super::stack_extra(index as usize) as u32
+}
+
+/// App `index`'s package path when it is a QuickJS app (NULL otherwise).
+#[no_mangle]
+pub extern "C" fn pocketnano_package(index: u32) -> *const u8 {
+    #[cfg(feature = "quickjs")]
+    if let Some(app) = (index as usize).checked_sub(super::SPECS.len()).and_then(|i| super::js::JS_APPS.get(i)) {
+        return app.package.as_ptr();
+    }
+    let _ = index;
+    core::ptr::null()
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_title(index: u32) -> *const u8 {
+    let title = (*core::ptr::addr_of_mut!(TITLE)).as_mut_ptr();
+    let text = if (index as usize) < super::app_count() { super::spec_at(index as usize).title } else { "" }.as_bytes();
+    let n = text.len().min(39);
+    core::ptr::copy_nonoverlapping(text.as_ptr(), title, n);
+    *title.add(n) = 0;
+    title
+}
+
+/// Mounts app `index` over `heap` (an OS heap block the shim owns) and
+/// renders into `framebuffer` (240 x 432 XRGB8888). `menu` draws a key that
+/// asks the shim to go back to its menu.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_start(heap: *mut u8, length: usize, framebuffer: *mut u32, index: u32, menu: i32) {
+    PEAK = 0;
+    LIVE = false;
+    #[cfg(feature = "quickjs")]
+    pocketqjs_heap_init(heap, length);
+    #[cfg(not(feature = "quickjs"))]
+    {
+        (*ALLOCATOR.0.get()).write(Heap::empty());
+        (*ALLOCATOR.0.get()).assume_init_mut().init(heap, length);
+    }
+    READY = true;
+    // Baked rounded-corner and border masks: at most 1/16 of the block
+    // (156 KB of the full 2.5 MB, 128 KB in lean mode). Unbounded, an
+    // animation that sweeps radii or box sizes kept every mask it passed
+    // through (Motion Lab: out of memory after a few pages, alloc.rs:573).
+    pocketjs_core::draw::SHAPE_CACHE_BUDGET.store((length / 16).min(192 << 10), core::sync::atomic::Ordering::Relaxed);
+    // The software raster samples any size: masks at their exact size.
+    pocketjs_core::draw::TIGHT_MASKS.store(true, core::sync::atomic::Ordering::Relaxed);
+    let index = (index as usize).min(super::app_count() - 1);
+    // menu 2: opened from the home screen, the menu key reads as home.
+    super::HOME_KEYS.store(menu == 2, core::sync::atomic::Ordering::Relaxed);
+    (*core::ptr::addr_of_mut!(STAGE)).write(Stage::new(index, framebuffer, menu != 0));
+    LIVE = true;
+}
+
+/// One boot step of the app (QuickJS apps boot over several heartbeats):
+/// 0 more to do, 1 the boot just finished, 2 nothing to do.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_boot_step() -> u32 {
+    if !LIVE {
+        return 2;
+    }
+    (*core::ptr::addr_of_mut!(STAGE)).assume_init_mut().boot_step()
+}
+
+/// Runs one tick and writes up to `MAX_REGIONS` damage rectangles as
+/// `x, y, width, height`. Returns the rectangle count.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_frame(
+    buttons: u32,
+    x: i32,
+    y: i32,
+    down: i32,
+    accel: *const i32,
+    now_us: u32,
+    rects: *mut i32,
+) -> i32 {
+    if !LIVE {
+        return 0;
+    }
+    let stage = (*core::ptr::addr_of_mut!(STAGE)).assume_init_mut();
+    let accel = [*accel, *accel.add(1), *accel.add(2)];
+    let damage = stage.frame(buttons, Touch { x, y, down: down != 0 }, accel, now_us as u64);
+    let rects = core::slice::from_raw_parts_mut(rects, MAX_REGIONS * 4);
+    for (index, rect) in damage.iter().enumerate() {
+        rects[index * 4..index * 4 + 4].copy_from_slice(&[rect.x0, rect.y0, rect.x1 - rect.x0, rect.y1 - rect.y0]);
+    }
+    damage.len() as i32
+}
+
+/// The other fingers on the panel for the next frame, from the OS's
+/// per-finger lists: `n` triples of (slot, x, y) in panel pixels.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_fingers(fingers: *const i32, n: i32) {
+    if !LIVE {
+        return;
+    }
+    let stage = (*core::ptr::addr_of_mut!(STAGE)).assume_init_mut();
+    let mut list = [super::Finger::default(); super::MAX_FINGERS];
+    let n = (n.max(0) as usize).min(super::MAX_FINGERS);
+    for (i, f) in list.iter_mut().enumerate().take(n) {
+        let t = core::slice::from_raw_parts(fingers.add(i * 3), 3);
+        *f = super::Finger { slot: t[0] as u8, x: t[1], y: t[2] };
+    }
+    stage.set_fingers(&list[..n]);
+}
+
+/// The running app reads motion (the shim then samples the accelerometer).
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_motion() -> i32 {
+    (LIVE && (*core::ptr::addr_of!(STAGE)).assume_init_ref().spec().motion) as i32
+}
+
+/// The running app's menu key was pressed.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_wants_menu() -> i32 {
+    (LIVE && (*core::ptr::addr_of!(STAGE)).assume_init_ref().wants_menu()) as i32
+}
+
+/// Core memory counter `which` (see `Ui::memory_counters`), 0 if none.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_counter(which: u32) -> u32 {
+    if !LIVE {
+        return 0;
+    }
+    let c = (*core::ptr::addr_of!(STAGE)).assume_init_ref().memory_counters();
+    c.get(which as usize).copied().unwrap_or(0)
+}
+
+/// Bytes the baked shape masks (corner discs, border masks) hold now.
+#[no_mangle]
+pub extern "C" fn pocketnano_shape_bytes() -> u32 {
+    pocketjs_core::draw::SHAPE_CACHE_BYTES.load(core::sync::atomic::Ordering::Relaxed) as u32
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_heap_peak() -> u32 {
+    if cfg!(feature = "quickjs") {
+        quickjs_peak()
+    } else {
+        PEAK as u32
+    }
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_heap_used() -> u32 {
+    if READY {
+        if cfg!(feature = "quickjs") {
+            quickjs_used()
+        } else {
+            (*ALLOCATOR.0.get()).assume_init_ref().used() as u32
+        }
+    } else {
+        0
+    }
+}
+
+/// Stop the guest and drop Runtime while the heap block is still valid.
+/// Returns the bytes still allocated after the drop (0 when nothing leaked).
+/// After this the shim may free the block or start another app in it.
+#[no_mangle]
+pub unsafe extern "C" fn pocketnano_stop() -> u32 {
+    if LIVE {
+        LIVE = false;
+        // A QuickJS realm is not torn down object by object: the shim frees
+        // the whole block, which holds every byte it allocated.
+        if (*core::ptr::addr_of!(STAGE)).assume_init_ref().is_aot() {
+            (*core::ptr::addr_of_mut!(STAGE)).assume_init_drop();
+        }
+    }
+    pocketjs_core::text::set_resident_region(core::ptr::null(), 0);
+    #[cfg(feature = "quickjs")]
+    crate::local::reset();
+    let left = pocketnano_heap_used();
+    READY = false;
+    left
+}
+
+#[cfg(feature = "quickjs")]
+unsafe fn quickjs_peak() -> u32 {
+    pocketqjs_heap_peak() as u32
+}
+#[cfg(feature = "quickjs")]
+unsafe fn quickjs_used() -> u32 {
+    pocketqjs_heap_used() as u32
+}
+#[cfg(not(feature = "quickjs"))]
+unsafe fn quickjs_peak() -> u32 {
+    0
+}
+#[cfg(not(feature = "quickjs"))]
+unsafe fn quickjs_used() -> u32 {
+    0
+}
