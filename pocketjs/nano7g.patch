@@ -0,0 +1,339 @@
+//! The on-screen pad for apps whose viewport is not the 240 x 432 panel, and
+//! the mapping between the app's view, the viewer and the panel.
+//!
+//! Portrait: the app is scaled to the panel width at the top and the pad sits
+//! below it. Landscape (apps wider than the panel): the viewer holds the iPod
+//! on its side with Home on the right; the app fills that 432 x 240 view and
+//! the pad buttons are drawn over it, translucent.
+
+use crate::samples::Pad;
+use microts::spec::btn;
+
+pub const PANEL_W: i32 = 240;
+pub const PANEL_H: i32 = 432;
+
+/// Fixed-point (16.16) scale.
+pub const ONE: i32 = 1 << 16;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Rect {
+    pub x: i32,
+    pub y: i32,
+    pub w: i32,
+    pub h: i32,
+}
+impl Rect {
+    pub const fn new(x: i32, y: i32, w: i32, h: i32) -> Self {
+        Self { x, y, w, h }
+    }
+    pub fn contains(&self, x: i32, y: i32) -> bool {
+        x >= self.x && y >= self.y && x < self.x + self.w && y < self.y + self.h
+    }
+    pub fn covers(&self, o: &Rect) -> bool {
+        o.x >= self.x && o.y >= self.y && o.x + o.w <= self.x + self.w && o.y + o.h <= self.y + self.h
+    }
+    pub fn intersects(&self, o: &Rect) -> bool {
+        self.x < o.x + o.w && o.x < self.x + self.w && self.y < o.y + o.h && o.y < self.y + self.h
+    }
+    pub fn union(&self, o: &Rect) -> Rect {
+        let x0 = self.x.min(o.x);
+        let y0 = self.y.min(o.y);
+        let x1 = (self.x + self.w).max(o.x + o.w);
+        let y1 = (self.y + self.h).max(o.y + o.h);
+        Rect::new(x0, y0, x1 - x0, y1 - y0)
+    }
+    pub fn clip(&self, w: i32, h: i32) -> Option<Rect> {
+        let x0 = self.x.max(0);
+        let y0 = self.y.max(0);
+        let x1 = (self.x + self.w).min(w);
+        let y1 = (self.y + self.h).min(h);
+        (x1 > x0 && y1 > y0).then(|| Rect::new(x0, y0, x1 - x0, y1 - y0))
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Glyph {
+    Up,
+    Down,
+    Left,
+    Right,
+    Circle,
+    Cross,
+    Start,
+    Select,
+    Menu,
+    Minus,
+    Plus,
+    /// The menu key of an app opened from the PocketJS home screen.
+    Home,
+}
+
+/// What a pad button does while held.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    Button(u32),
+    /// Turn the primary relative axis (millidegrees per step).
+    Wheel(i32),
+    Menu,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Key {
+    /// In viewer coordinates.
+    pub rect: Rect,
+    pub glyph: Glyph,
+    pub action: Action,
+}
+
+pub const MAX_KEYS: usize = 12;
+
+#[derive(Clone, Debug)]
+pub struct Layout {
+    /// The app's logical size.
+    pub logical: [i32; 2],
+    pub landscape: bool,
+    /// The scaled app in viewer coordinates.
+    pub view: Rect,
+    /// Logical pixels per view pixel, 16.16.
+    pub inv: i32,
+    pub keys: [Option<Key>; MAX_KEYS],
+    /// The viewer is a straight copy of the panel and the app fills it.
+    pub direct: bool,
+}
+
+const fn key(x: i32, y: i32, w: i32, h: i32, glyph: Glyph, action: Action) -> Option<Key> {
+    Some(Key { rect: Rect::new(x, y, w, h), glyph, action })
+}
+
+impl Layout {
+    pub fn new(logical: [u32; 2], pad: Pad, menu: bool) -> Self {
+        let (lw, lh) = (logical[0] as i32, logical[1] as i32);
+        let mut keys = [None; MAX_KEYS];
+        if pad == Pad::Landscape {
+            // Touch-only landscape: the app fills the 432 x 240 view.
+            let (vw, vh) = (PANEL_H, PANEL_W);
+            let inv = ((lw << 16) / vw).max((lh << 16) / vh);
+            let w = (lw << 16) / inv;
+            let h = (lh << 16) / inv;
+            let view = Rect::new((vw - w) / 2, (vh - h) / 2, w, h);
+            if menu {
+                keys[10] = key(vw - 40, 4, 36, 30, Glyph::Menu, Action::Menu);
+            }
+            return Self { logical: [lw, lh], landscape: true, view, inv, keys, direct: false };
+        }
+        if [lw, lh] == [PANEL_W, PANEL_H] || matches!(pad, Pad::None | Pad::TopMenu) {
+            // Touch apps: shown 1:1 at the top left (240 x 432 fills the panel).
+            let mut layout = Self {
+                logical: [lw, lh],
+                landscape: false,
+                view: Rect::new(0, 0, lw.min(PANEL_W), lh.min(PANEL_H)),
+                inv: ONE,
+                keys,
+                direct: [lw, lh] == [PANEL_W, PANEL_H],
+            };
+            if menu && pad == Pad::TopMenu {
+                layout.keys[0] = key(PANEL_W - 44, 4, 40, 32, Glyph::Menu, Action::Menu);
+            } else if menu {
+                layout.keys[0] = key(PANEL_W - 44, PANEL_H - 36, 40, 32, Glyph::Menu, Action::Menu);
+            }
+            return layout;
+        }
+        let wheel = matches!(pad, Pad::Buttons { wheel: true });
+        if lw > PANEL_W {
+            // Landscape viewer, 432 x 240.
+            let (vw, vh) = (PANEL_H, PANEL_W);
+            let inv = ((lw << 16) / vw).max((lh << 16) / vh);
+            let w = (lw << 16) / inv;
+            let h = (lh << 16) / inv;
+            let view = Rect::new((vw - w) / 2, (vh - h) / 2, w, h);
+            let (cx, cy, c) = (64, 170, 40);
+            keys[0] = key(cx - c / 2, cy - c / 2 - c, c, c, Glyph::Up, Action::Button(btn::UP));
+            keys[1] = key(cx - c / 2, cy + c / 2, c, c, Glyph::Down, Action::Button(btn::DOWN));
+            keys[2] = key(cx - c / 2 - c, cy - c / 2, c, c, Glyph::Left, Action::Button(btn::LEFT));
+            keys[3] = key(cx + c / 2, cy - c / 2, c, c, Glyph::Right, Action::Button(btn::RIGHT));
+            keys[4] = key(382, 108, 44, 44, Glyph::Circle, Action::Button(btn::CIRCLE));
+            keys[5] = key(334, 154, 44, 44, Glyph::Cross, Action::Button(btn::CROSS));
+            keys[6] = key(334, 204, 40, 34, Glyph::Select, Action::Button(btn::SELECT));
+            keys[7] = key(386, 204, 40, 34, Glyph::Start, Action::Button(btn::START));
+            if wheel {
+                keys[8] = key(6, 6, 40, 32, Glyph::Minus, Action::Wheel(-15_000));
+                keys[9] = key(50, 6, 40, 32, Glyph::Plus, Action::Wheel(15_000));
+            }
+            if menu {
+                keys[10] = key(386, 6, 40, 32, Glyph::Menu, Action::Menu);
+            }
+            return Self { logical: [lw, lh], landscape: true, view, inv, keys, direct: false };
+        }
+        // Portrait: the app across the top, the pad below.
+        let inv = (lw << 16) / PANEL_W;
+        let h = (lh << 16) / inv;
+        let view = Rect::new(0, 0, PANEL_W, h);
+        let top = h;
+        let cy = top + (PANEL_H - top - 48) / 2;
+        let (cx, c) = (70, 50);
+        keys[0] = key(cx - c / 2, cy - c / 2 - c, c, c, Glyph::Up, Action::Button(btn::UP));
+        keys[1] = key(cx - c / 2, cy + c / 2, c, c, Glyph::Down, Action::Button(btn::DOWN));
+        keys[2] = key(cx - c / 2 - c, cy - c / 2, c, c, Glyph::Left, Action::Button(btn::LEFT));
+        keys[3] = key(cx + c / 2, cy - c / 2, c, c, Glyph::Right, Action::Button(btn::RIGHT));
+        keys[4] = key(180, cy - 58, 54, 54, Glyph::Circle, Action::Button(btn::CIRCLE));
+        keys[5] = key(150, cy + 6, 54, 54, Glyph::Cross, Action::Button(btn::CROSS));
+        keys[6] = key(8, PANEL_H - 40, 70, 34, Glyph::Select, Action::Button(btn::SELECT));
+        keys[7] = key(85, PANEL_H - 40, 70, 34, Glyph::Start, Action::Button(btn::START));
+        if wheel {
+            keys[8] = key(8, top + 6, 50, 30, Glyph::Minus, Action::Wheel(-15_000));
+            keys[9] = key(64, top + 6, 50, 30, Glyph::Plus, Action::Wheel(15_000));
+        }
+        if menu {
+            keys[10] = key(162, PANEL_H - 40, 70, 34, Glyph::Menu, Action::Menu);
+        }
+        Self { logical: [lw, lh], landscape: false, view, inv, keys, direct: false }
+    }
+
+    /// Apps opened from the home screen: their menu key reads as a home key.
+    pub fn home_keys(&mut self) {
+        for k in self.keys.iter_mut().flatten() {
+            if k.action == Action::Menu {
+                k.glyph = Glyph::Home;
+            }
+        }
+    }
+
+    pub fn viewer_size(&self) -> (i32, i32) {
+        if self.landscape {
+            (PANEL_H, PANEL_W)
+        } else {
+            (PANEL_W, PANEL_H)
+        }
+    }
+
+    /// Panel point to viewer point.
+    pub fn to_viewer(&self, px: i32, py: i32) -> (i32, i32) {
+        if self.landscape {
+            (py, PANEL_W - 1 - px)
+        } else {
+            (px, py)
+        }
+    }
+
+    /// Viewer rectangle to panel rectangle.
+    pub fn to_panel(&self, r: Rect) -> Rect {
+        if self.landscape {
+            Rect::new(PANEL_W - r.y - r.h, r.x, r.h, r.w)
+        } else {
+            r
+        }
+    }
+
+    /// Logical rectangle to the panel rectangle that shows it.
+    pub fn logical_to_panel(&self, x0: i32, y0: i32, x1: i32, y1: i32) -> Rect {
+        let v0x = self.view.x + ((x0 << 16) / self.inv) - 1;
+        let v0y = self.view.y + ((y0 << 16) / self.inv) - 1;
+        let v1x = self.view.x + ((x1 << 16) + self.inv - 1) / self.inv + 1;
+        let v1y = self.view.y + ((y1 << 16) + self.inv - 1) / self.inv + 1;
+        let (vw, vh) = self.viewer_size();
+        let r = Rect::new(v0x, v0y, v1x - v0x, v1y - v0y).clip(vw, vh).unwrap_or(Rect::new(0, 0, 0, 0));
+        self.to_panel(r)
+    }
+
+    /// A panel touch inside the app's view, in logical coordinates.
+    pub fn touch_to_logical(&self, px: i32, py: i32) -> Option<(i32, i32)> {
+        let (vx, vy) = self.to_viewer(px, py);
+        if !self.view.contains(vx, vy) {
+            return None;
+        }
+        let lx = (((vx - self.view.x) * self.inv) >> 16).clamp(0, self.logical[0] - 1);
+        let ly = (((vy - self.view.y) * self.inv) >> 16).clamp(0, self.logical[1] - 1);
+        Some((lx, ly))
+    }
+
+    pub fn key_at(&self, px: i32, py: i32) -> Option<usize> {
+        let (vx, vy) = self.to_viewer(px, py);
+        self.keys.iter().position(|k| k.is_some_and(|k| k.rect.contains(vx, vy)))
+    }
+}
+
+/// 7 x 7 glyph rows, most significant of the low 7 bits on the left.
+fn rows(glyph: Glyph) -> [u8; 7] {
+    match glyph {
+        Glyph::Up => [0x08, 0x1c, 0x3e, 0x7f, 0x1c, 0x1c, 0x1c],
+        Glyph::Down => [0x1c, 0x1c, 0x1c, 0x7f, 0x3e, 0x1c, 0x08],
+        Glyph::Left => [0x08, 0x18, 0x3f, 0x7f, 0x3f, 0x18, 0x08],
+        Glyph::Right => [0x08, 0x0c, 0x7e, 0x7f, 0x7e, 0x0c, 0x08],
+        Glyph::Circle => [0x1c, 0x22, 0x41, 0x41, 0x41, 0x22, 0x1c],
+        Glyph::Cross => [0x41, 0x22, 0x14, 0x08, 0x14, 0x22, 0x41],
+        Glyph::Start => [0x20, 0x38, 0x3e, 0x3f, 0x3e, 0x38, 0x20],
+        Glyph::Select => [0x00, 0x3e, 0x3e, 0x3e, 0x3e, 0x3e, 0x00],
+        Glyph::Menu => [0x00, 0x7f, 0x00, 0x7f, 0x00, 0x7f, 0x00],
+        Glyph::Minus => [0x00, 0x00, 0x00, 0x7f, 0x00, 0x00, 0x00],
+        Glyph::Plus => [0x08, 0x08, 0x08, 0x7f, 0x08, 0x08, 0x08],
+        Glyph::Home => [0x3e, 0x41, 0x41, 0x41, 0x41, 0x41, 0x3e],
+    }
+}
+
+pub fn glyph_bit(glyph: Glyph, x: i32, y: i32) -> bool {
+    (0..7).contains(&x) && (0..7).contains(&y) && rows(glyph)[y as usize] & (0x40 >> x) != 0
+}
+
+pub const PAD_BG: u32 = 0xff0f_172a;
+const KEY_BG: u32 = 0xff33_4155;
+const KEY_DOWN: u32 = 0xff64_748b;
+const KEY_FG: u32 = 0xfff1_f5f9;
+
+fn blend(dst: u32, src: u32, alpha: u32) -> u32 {
+    let mix = |shift: u32| {
+        let d = (dst >> shift) & 0xff;
+        let s = (src >> shift) & 0xff;
+        ((s * alpha + d * (255 - alpha)) / 255) << shift
+    };
+    0xff00_0000 | mix(16) | mix(8) | mix(0)
+}
+
+/// Draw one key into the panel framebuffer. Landscape keys blend over what
+/// is already there (the composed app); portrait keys are opaque.
+pub fn draw_key(layout: &Layout, fb: &mut [u32], key: &Key, down: bool) {
+    let r = key.rect;
+    let radius = r.w.min(r.h) / 4;
+    let scale = (r.w.min(r.h) / 14).max(2);
+    let gx0 = r.x + (r.w - 7 * scale) / 2;
+    let gy0 = r.y + (r.h - 7 * scale) / 2;
+    // Glyph cells step by counting, not dividing (no divide instruction).
+    let (cell_x0, rem_x0) = ((r.x - gx0).div_euclid(scale), (r.x - gx0).rem_euclid(scale));
+    for vy in r.y..r.y + r.h {
+        let cell_y = (vy - gy0).div_euclid(scale);
+        let (mut cell_x, mut rem_x) = (cell_x0, rem_x0 - 1);
+        for vx in r.x..r.x + r.w {
+            rem_x += 1;
+            if rem_x == scale {
+                rem_x = 0;
+                cell_x += 1;
+            }
+            // Rounded corners.
+            let dx = if vx < r.x + radius { r.x + radius - vx } else if vx >= r.x + r.w - radius { vx - (r.x + r.w - radius - 1) } else { 0 };
+            let dy = if vy < r.y + radius { r.y + radius - vy } else if vy >= r.y + r.h - radius { vy - (r.y + r.h - radius - 1) } else { 0 };
+            if dx * dx + dy * dy > radius * radius {
+                continue;
+            }
+            let (px, py) = if layout.landscape { (PANEL_W - 1 - vy, vx) } else { (vx, vy) };
+            if !(0..PANEL_W).contains(&px) || !(0..PANEL_H).contains(&py) {
+                continue;
+            }
+            let i = (py * PANEL_W + px) as usize;
+            let on = glyph_bit(key.glyph, cell_x, cell_y);
+            fb[i] = if layout.landscape {
+                if on {
+                    blend(fb[i], 0xffff_ffff, 200)
+                } else if down {
+                    blend(fb[i], 0xffff_ffff, 110)
+                } else {
+                    blend(fb[i], 0xff00_0000, 70)
+                }
+            } else if on {
+                KEY_FG
+            } else if down {
+                KEY_DOWN
+            } else {
+                KEY_BG
+            };
+        }
+    }
+}
