#!/usr/bin/env bash
# nano7kit: pick apps and games for your iPod nano 7G. Run: ./install
set -euo pipefail
cd "$(dirname "$0")"

[[ -f build/macos-intel/env.sh ]] && source build/macos-intel/env.sh

find_python() {
  local c
  for c in python3.13 python3.12 python3.11 python3.10 python3 /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3 /usr/local/bin/python3.12 /usr/local/bin/python3; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      command -v "$c"
      return 0
    fi
  done
  return 1
}

if ! PY=$(find_python); then
  if [[ $(uname -s) == Darwin ]]; then
    if [[ $(sysctl -n hw.optional.arm64 2>/dev/null || echo 0) == 1 ]]; then
      if command -v brew >/dev/null 2>&1; then
        echo "Installing Python 3.12 with Homebrew..."
        brew install python@3.12
      else
        echo "Python 3.10 or newer is needed. Install Homebrew (https://brew.sh), then run ./install again."
        exit 1
      fi
    else
      echo "Setting up Python and build tools in build/macos-intel (no password needed, a few minutes)..."
      ./scripts/macos-intel-bootstrap.sh
      source build/macos-intel/env.sh
    fi
  else
    echo "Python 3.10 or newer is needed (for example: sudo apt install python3)."
    exit 1
  fi
  PY=$(find_python) || { echo "Python 3.10 or newer is still missing."; exit 1; }
fi

exec "$PY" -m host.installer "$@"
