# JS QuickJS runs PocketJS JavaScript packages on QuickJS (the canonical C
# guest) with Tilt as a native sample. The packages live on the disk under
# /Apps/Data/PocketJS, not in the app. It is built from the pinned PocketJS
# checkout plus pocketjs/nano7g.patch, not from sources in this folder:
#   ./start pocketjs build quickjs
all:
	@echo "JS QuickJS is built by: ./start pocketjs build quickjs" && exit 1
