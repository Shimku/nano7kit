+#ifdef NANO7_DEVICE
+extern "C" void n7p_step(const char* what);
+extern "C" void n7p_step_a(const char* what, uint32_t a);
+// nano7 v32: LoadingThreadProc (above), split so each OS frame callback does a slice of it: about 830 images, the
+// fonts, the particle and trail definitions and the sounds in one callback was many seconds on the iPod. Same order
+// and same checks; a breadcrumb before each stage. The title screen draws its progress bar in between.
+bool LawnApp::Nano7LoadStep()
+{
+	static const char* const kGroups[] = { "LoadingImages", "LoadingFonts", "LoadingSounds" };
+	static const int kPerFrame[] = { 24, 2, 8 }, kAveMs[] = { 9, 54, 54 };
+	static int sStage, sCount;
+	if (mShutdown || mCloseRequest || mLoadingFailed) return true;
+	int g = sStage <= 2 ? 0 : sStage <= 4 ? 1 : 2;
+	switch (sStage)
+	{
+	case 0:
+	{
+		n7p_step("loading: loader bar, strings, properties");
+		if (!PvzpLoadResources("LoaderBar")) return true;
+		PvzpStringListLoad("Properties/LawnStrings.txt");
+		PvzpStringListReadFile("Properties/ZombatarTOS.txt");
+		LoadProperties("properties/default.xml", false, false);
+		LoadProperties("properties/Layout.xml", false, false);
+		LoadProperties("properties/pvz-portable.xml", false, false);
+		if (mTitleScreen) mTitleScreen->mLoaderScreenIsLoaded = true;
+		for (int i = 0; i < 3; i++) mNumLoadingThreadTasks += mResourceManager->GetNumResources(kGroups[i]) * kAveMs[i];
+		mNumLoadingThreadTasks += 636;
+		mNumLoadingThreadTasks += GetNumPreloadingTasks();
+		mNumLoadingThreadTasks += Music::MUSIC_LOADING_TASKS;
+		sStage = 1;
+		return false;
+	}
+	case 1: case 3: case 10:
+		if (g == 2 && getenv("NANO7_NO_SOUND"))
+		{   // nano7 v34: silent build, no WAVs shipped; the sound ids stay unset and every sound call is a no-op
+			n7p_step("loading: sounds skipped (silent build)");
+			sStage = 12;
+			return true;
+		}
+		n7p_step_a(g == 0 ? "loading: images" : g == 1 ? "loading: fonts" : "loading: sounds", (uint32_t)mResourceManager->GetNumResources(kGroups[g]));
+		mResourceManager->StartLoadResources(kGroups[g]);
+		sCount = 0;
+		sStage++;
+		return false;
+	case 2: case 4: case 11:
+		for (int i = 0; i < kPerFrame[g]; i++)
+		{
+			if (mShutdown || mCloseRequest || mLoadingFailed) return true;
+			if (!PvzpLoadNextResource())
+			{
+				if (mResourceManager->HadError() || !ExtractResourcesByName(mResourceManager.get(), kGroups[g]))
+				{
+					n7p_step_a("loading: group FAILED", (uint32_t)g);
+					ShowResourceError();
+					mLoadingFailed = true;
+					return true;
+				}
+				n7p_step_a("loading: group done (a = resources)", (uint32_t)sCount);
+				if (g == 1) mDefaultFont = FONT_PICO129;
+				sStage++;
+				return sStage == 12;
+			}
+			mCompletedLoadingThreadTasks += kAveMs[g];
+			sCount++;
+		}
+		if (sCount % (kPerFrame[g] * 8) == 0) n7p_step_a("loading: resources so far", (uint32_t)sCount);
+		return false;
+	case 5:
+		n7p_step("loading: music init");
+		mMusic->MusicInit();
+		sStage++;
+		return false;
+	case 6:
+		n7p_step("loading: pool, zen garden, animation cache, sound effects");
+		mPoolEffect = std::make_unique<PoolEffect>();
+		if (!getenv("NANO7_NO_POOL")) mPoolEffect->PoolEffectInitialize();
+		mZenGarden = std::make_unique<ZenGarden>();
+		mReanimatorCache = std::make_unique<ReanimatorCache>();
+		mReanimatorCache->ReanimatorCacheInitialize();
+		PvzpFoleyInitialize(gLawnFoleyParamArray, LENGTH(gLawnFoleyParamArray));
+		sStage++;
+		return false;
+	case 7:
+		n7p_step("loading: trails");
+		TrailLoadDefinitions(gLawnTrailArray, LENGTH(gLawnTrailArray));
+		sStage++;
+		return false;
+	case 8:
+		n7p_step("loading: particles");
+		PvzpParticleLoadDefinitions(gLawnParticleArray, LENGTH(gLawnParticleArray));
+		sStage++;
+		return false;
+	case 9:
+		n7p_step("loading: preload for the player");
+		PreloadForUser();
+		if (mLoadingFailed || mShutdown || mCloseRequest) return true;
+		GetNumPreloadingTasks();
+		sStage++;
+		return false;
+	default:
+		n7p_step("loading: done");
+		return true;
+	}
+}
+#endif
