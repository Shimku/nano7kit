+# A copy of the screen DB that silverutil compiles from tools/screens/*.yaml, for
+# hosts whose Rust is older than silverutil's Cargo.lock needs (lock v4, Rust 1.85+;
+# e.g. a Mac with an old rustup nightly). It is used only when the yaml sources hash
+# to SCREENS_SOURCES_SHA256, so it can never drift from them.
+SCREENS_PREBUILT = ROOT / "tools" / "hb_silverdb.prebuilt"
+SCREENS_SOURCES_SHA256 = "a02c018b2997ba44ad197cca02108a2d296ed156ccd5d47c4ef80a2f8c247c08"
+SCREENS_PREBUILT_SHA256 = "721bcb8f78a62ca8d5fea83b618cc26061672bcb9ce2cefc869c5665ef44315b"
+
+
+def screens_sources_sha256(src=None):
+    import hashlib
+    src = Path(src) if src is not None else ROOT / "tools" / "screens"
+    h = hashlib.sha256()
+    for p in sorted(src.rglob("*")):
+        if p.is_file():
+            h.update(p.relative_to(src).as_posix().encode() + b"\0" + p.read_bytes())
+    return h.hexdigest()
+
+
+def use_prebuilt_screens(dest, why):
+    import hashlib, shutil
+    if screens_sources_sha256() != SCREENS_SOURCES_SHA256:
+        raise SystemExit("error: silverutil is unavailable (%s) and tools/screens changed "
+                         "since hb_silverdb.prebuilt was made; install Rust 1.85+" % why)
+    data = SCREENS_PREBUILT.read_bytes()
+    if hashlib.sha256(data).hexdigest() != SCREENS_PREBUILT_SHA256:
+        raise SystemExit("error: tools/hb_silverdb.prebuilt does not match its pinned hash")
+    Path(dest).write_bytes(data)
+    print("==> silverutil unavailable (%s); using the pinned screen DB" % why)
